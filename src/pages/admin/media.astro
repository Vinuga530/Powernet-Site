}
.sic-blue  { background: var(--bl-lo); color: var(--bl); box-shadow: 0 4px 14px rgba(59,130,246,0.15); }
.sic-green { background: var(--gr-lo); color: var(--gr); box-shadow: 0 4px 14px rgba(34,197,94,0.15); }
.sic-amber { background: var(--am-lo); color: var(--am); box-shadow: 0 4px 14px rgba(245,158,11,0.15); }
.sic-purple{ background: var(--pu-lo); color: var(--pu); box-shadow: 0 4px 14px rgba(168,85,247,0.15); }

.si { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.sv {
  font-size: 1.55rem;
  font-weight: 700;
  color: var(--tx);
  line-height: 1;
  letter-spacing: -0.03em;
}
.sl {
  font-size: 0.71rem;
  color: var(--tx3);
