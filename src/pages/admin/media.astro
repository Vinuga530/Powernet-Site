---
import fs from 'node:fs';
import path from 'node:path';

export const prerender = false;

// ─── AUTH GATE ────────────────────────────────────────────────────────────────
// Protect access in production via Keystatic's GitHub OAuth token
const ghToken =
  Astro.cookies.get('keystatic-gh-access-token')?.value ||
  Astro.request.headers.get('cookie')?.match(/keystatic-gh-access-token=([^;]+)/)?.[1];

const isDev = import.meta.env.DEV;

if (!isDev && !ghToken) {
  return Astro.redirect('/keystatic', 302);
}
// ─────────────────────────────────────────────────────────────────────────────

const GITHUB_REPO = 'Vinuga530/Powernet-Site';
const rootDir = process.cwd();
const publicDir = path.join(rootDir, 'public');
const srcDir = path.join(rootDir, 'src');

const PROTECTED_FILES = new Set([
  '.gitkeep',
  'favicon.ico',
  'favicon.svg',
  'site.webmanifest',
  'powernet-logo-coloured.png',
  'apple-touch-icon.png',
]);

const MEDIA_EXTS = new Set(['.jpg', '.jpeg', '.png', '.webp', '.svg', '.gif', '.avif', '.mp4', '.webm', '.mov', '.ogg']);

function getAllFiles(dirPath, arr = []) {
  if (!fs.existsSync(dirPath)) return arr;
  for (const e of fs.readdirSync(dirPath, { withFileTypes: true })) {
    const fp = path.join(dirPath, e.name);
    if (e.isDirectory()) getAllFiles(fp, arr);
    else arr.push(fp);
  }
  return arr;
}

function collectReferencedAssets(sDir) {
  const map = new Map();
  if (!fs.existsSync(sDir)) return map;

  const txtExts = ['.yaml', '.yml', '.astro', '.ts', '.js', '.jsx', '.tsx', '.json', '.md', '.mdx', '.css'];
  const files = getAllFiles(sDir).filter((f) => txtExts.includes(path.extname(f).toLowerCase()));

  for (const file of files) {
    try {
      const content = fs.readFileSync(file, 'utf-8');
      const rel = path.relative(sDir, file).replace(/\\/g, '/');

      // Match patterns like /images/... or /videos/...
      const matches = content.match(/["']?(\/?(images|videos)\/[^"'\s\n\r<>]+)/g) || [];
      for (const m of matches) {
        const cleaned = m.replace(/^['"]/, '').replace(/['",;)]$/, '').trim().replace(/\\/g, '/');
        const withSlash = cleaned.startsWith('/') ? cleaned : '/' + cleaned;
        const withoutSlash = withSlash.slice(1);
        const fn = path.basename(cleaned).toLowerCase();

        for (const key of [withSlash, withoutSlash]) {
          const ex = map.get(key) || [];
          if (!ex.includes(rel)) ex.push(rel);
          map.set(key, ex);
        }

        if (!['image.jpg', 'image.png', 'image.webp', 'image.jpeg', 'icon.svg'].includes(fn)) {
          const ex = map.get(fn) || [];
          if (!ex.includes(rel)) ex.push(rel);
          map.set(fn, ex);
        }
      }

      // Match filenames with media extensions
      const fnMatches = content.match(/[\w\-.]+\.(png|jpe?g|webp|svg|mp4|webm|gif|avif)/gi) || [];
      for (const fn of fnMatches) {
        const fnl = fn.toLowerCase();
        if (['image.jpg', 'image.png', 'image.webp', 'image.jpeg', 'icon.svg'].includes(fnl)) continue;
        const ex = map.get(fnl) || [];
        if (!ex.includes(rel)) ex.push(rel);
        map.set(fnl, ex);
      }
    } catch {}
  }
  return map;
}

const usageMap = collectReferencedAssets(srcDir);
const mediaItems = [];

function determineCategory(relPathSlash) {
  if (relPathSlash.startsWith('/images/projects/')) return 'Projects';
  if (relPathSlash.startsWith('/images/hero/') || relPathSlash.startsWith('/videos/hero/')) return 'Hero Media';
  if (relPathSlash.startsWith('/images/icons/')) return 'Icons';
  return 'Site Assets';
}

function getDisplayName(relPathSlash, fileName) {
  if (relPathSlash.startsWith('/images/projects/')) {
    return relPathSlash.replace('/images/projects/', '');
  }
  return fileName;
}

// 1. Scan local disk
let localCount = 0;
const scanDirs = [path.join(publicDir, 'images'), path.join(publicDir, 'videos')];

for (const scanDir of scanDirs) {
  if (fs.existsSync(scanDir)) {
    for (const filePath of getAllFiles(scanDir)) {
      const ext = path.extname(filePath).toLowerCase();
      if (!MEDIA_EXTS.has(ext)) continue;

      const fileName = path.basename(filePath);
      if (PROTECTED_FILES.has(fileName.toLowerCase())) continue;

      const rel = '/' + path.relative(publicDir, filePath).replace(/\\/g, '/');
      const isVideo = ['.mp4', '.webm', '.mov', '.ogg'].includes(ext);
      const usedIn = usageMap.get(rel) || usageMap.get(rel.slice(1)) || usageMap.get(fileName.toLowerCase()) || [];
      let size = 0;
      try {
        size = fs.statSync(filePath).size;
      } catch {}

      localCount++;
      mediaItems.push({
        name: getDisplayName(rel, fileName),
        fileName,
        path: rel,
        category: determineCategory(rel),
        size,
        ext: ext.replace('.', '').toUpperCase(),
        isVideo,
        inUse: usedIn.length > 0,
        usedIn,
      });
    }
  }
}

// 2. Production Vercel lambda (GitHub Trees API fallback)
if (localCount === 0) {
  try {
    const ghTokenVal =
      Astro.cookies.get('keystatic-gh-access-token')?.value ||
      Astro.request.headers.get('cookie')?.match(/keystatic-gh-access-token=([^;]+)/)?.[1] ||
      Astro.request.headers.get('x-github-token') ||
      process.env.KEYSTATIC_GITHUB_TOKEN ||
      process.env.GITHUB_TOKEN ||
      process.env.GH_TOKEN;

    const ghHeaders = {
      'Accept': 'application/vnd.github+json',
      'User-Agent': 'Powernet-CMS-MediaManager',
    };
    if (ghTokenVal) ghHeaders['Authorization'] = `Bearer ${ghTokenVal}`;

    const res = await fetch(`https://api.github.com/repos/${GITHUB_REPO}/git/trees/main?recursive=1`, {
      headers: ghHeaders,
    });

    if (res.ok) {
      const data = await res.json();
      for (const item of data.tree || []) {
        if (item.type !== 'blob') continue;
        const p = item.path;
        if (!p.startsWith('public/images/') && !p.startsWith('public/videos/')) continue;

        const fn = path.basename(p);
        const ext = path.extname(fn).toLowerCase();
        if (!MEDIA_EXTS.has(ext)) continue;
        if (PROTECTED_FILES.has(fn.toLowerCase())) continue;

        const rel = '/' + p.replace(/^public\//, '');
        const isVideo = ['.mp4', '.webm', '.mov', '.ogg'].includes(ext);
        const usedIn = usageMap.get(rel) || usageMap.get(fn.toLowerCase()) || [];

        mediaItems.push({
          name: getDisplayName(rel, fn),
          fileName: fn,
          path: rel,
          category: determineCategory(rel),
          size: item.size || 0,
          ext: ext.replace('.', '').toUpperCase(),
          isVideo,
          inUse: usedIn.length > 0,
          usedIn,
        });
      }
    }
  } catch {}
}

mediaItems.sort((a, b) => a.path.localeCompare(b.path));

const totalCount = mediaItems.length;
const unusedCount = mediaItems.filter((m) => !m.inUse).length;
const inUseCount = totalCount - unusedCount;
const totalBytes = mediaItems.reduce((a, m) => a + m.size, 0);
const unusedBytes = mediaItems.filter((m) => !m.inUse).reduce((a, m) => a + m.size, 0);

const projectsCount = mediaItems.filter((m) => m.category === 'Projects').length;
const heroCount = mediaItems.filter((m) => m.category === 'Hero Media').length;
const siteAssetsCount = mediaItems.filter((m) => m.category === 'Site Assets' || m.category === 'Icons').length;

function fmtBytes(b) {
  if (!b) return '0 B';
  const k = 1024;
  const s = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(b) / Math.log(k));
  return `${(b / Math.pow(k, i)).toFixed(1)} ${s[i]}`;
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Media Assets — Powernet CMS</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- TOP HEADER MASTHEAD -->
  <header class="header-bar">
    <div class="header-inner">
      <div class="header-brand">
        <a href="/admin/media" class="brand-link">
          <span class="brand-badge">POWERNET</span>
          <span class="brand-sep">/</span>
          <span class="brand-sub">Media Library</span>
        </a>
        <span class="env-pill">{isDev ? 'Local Workspace' : 'GitHub Production'}</span>
      </div>

      <div class="header-nav">
        <a href="/keystatic" class="nav-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Keystatic CMS</span>
        </a>
        <a href="/" target="_blank" rel="noopener noreferrer" class="nav-btn">
          <span>Live Site</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- MAIN VIEWPORT CONTAINER -->
  <div class="page-container">

    <!-- METRICS SUMMARY BANNER -->
    <section class="metrics-bar">
      <div class="metric-item">
        <span class="metric-label">TOTAL REPOSITORY ASSETS</span>
        <div class="metric-value-wrap">
          <span class="metric-num" id="statTotal">{totalCount}</span>
          <span class="metric-sub" id="statTotalBytes">{fmtBytes(totalBytes)}</span>
        </div>
      </div>

      <div class="metric-item">
        <span class="metric-label">LINKED IN CMS CONTENT</span>
        <div class="metric-value-wrap">
          <span class="metric-num text-success" id="statInUse">{inUseCount}</span>
          <span class="metric-sub text-success-sub">Active & Verified</span>
        </div>
      </div>

      <div class="metric-item">
        <span class="metric-label">ORPHANED / UNREFERENCED</span>
        <div class="metric-value-wrap">
          <span class="metric-num text-warning" id="statUnused">{unusedCount}</span>
          <span class="metric-sub" id="statUnusedBytes">{fmtBytes(unusedBytes)} reclaimable</span>
        </div>
      </div>

      <div class="metric-actions">
        <button
          type="button"
          id="btnAutoCleanup"
          class="action-btn action-btn-danger"
          data-unused={unusedCount}
          disabled={unusedCount === 0}
          title="Permanently remove all unreferenced files from disk and commit to GitHub"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>Prune All Unused ({unusedCount})</span>
        </button>
      </div>
    </section>

    <!-- TOOLBAR: FILTER & ACTIONS -->
    <section class="toolbar">
      <div class="toolbar-filter-row">
        <!-- CATEGORY PILLS -->
        <nav class="category-tabs" aria-label="Media Categories">
          <button class="tab-btn active" data-filter="all">
            <span>All Media</span>
            <span class="tab-count" id="countAll">{totalCount}</span>
          </button>
          <button class="tab-btn" data-filter="projects">
            <span>Projects</span>
            <span class="tab-count" id="countProjects">{projectsCount}</span>
          </button>
          <button class="tab-btn" data-filter="hero-media">
            <span>Hero Media</span>
            <span class="tab-count" id="countHero">{heroCount}</span>
          </button>
          <button class="tab-btn" data-filter="site-assets">
            <span>Site Assets</span>
            <span class="tab-count" id="countSiteAssets">{siteAssetsCount}</span>
          </button>
          <button class="tab-btn tab-btn-warning" data-filter="unused">
            <span>Unreferenced</span>
            <span class="tab-count" id="countUnused">{unusedCount}</span>
          </button>
        </nav>

        <!-- SEARCH -->
        <div class="search-wrap">
          <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="searchInput" placeholder="Filter by name, subfolder or usage…" autocomplete="off" />
          <button type="button" id="searchClear" class="search-clear" title="Clear filter" hidden>&times;</button>
        </div>

        <!-- VIEW TOGGLE -->
        <div class="view-toggle" role="group" aria-label="View format">
          <button type="button" id="viewGridBtn" class="toggle-btn active" title="Grid cards view">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          </button>
          <button type="button" id="viewTableBtn" class="toggle-btn" title="Detailed table view">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- SELECTION ACTIONS ROW -->
      <div class="selection-bar">
        <div class="selection-status">
          <label class="master-checkbox-label" title="Select / deselect all visible files">
            <input type="checkbox" id="masterCheckbox" class="app-checkbox" />
            <span class="sel-text"><span id="selCount">0</span> of <span id="visibleCount">{totalCount}</span> selected</span>
          </label>
          <button type="button" id="btnSelectUnusedOnly" class="text-link-btn">Select all unreferenced</button>
        </div>

        <div class="selection-buttons">
          <button type="button" id="btnDeleteSelected" class="action-btn action-btn-danger" disabled>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            <span>Delete Selected</span>
          </button>
        </div>
      </div>
    </section>

    <!-- CONTENT VIEW AREA -->
    <main class="content-area">
      {mediaItems.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </div>
          <h2 class="empty-title">No Media Assets Found</h2>
          <p class="empty-desc">Uploaded images and videos for Projects, Hero, and Services will appear here.</p>
          <a href="/keystatic" class="nav-btn nav-btn-primary">Return to Keystatic CMS</a>
        </div>
      ) : (
        <>
          <!-- GRID VIEW -->
          <div class="media-grid" id="mediaGrid">
            {mediaItems.map((item) => (
              <article
                class={`asset-card${!item.inUse ? ' is-unreferenced' : ''}`}
                data-path={item.path}
                data-name={item.name.toLowerCase()}
                data-filename={item.fileName.toLowerCase()}
                data-cat={item.category.toLowerCase().replace(/ /g, '-')}
                data-inuse={item.inUse ? 'true' : 'false'}
                data-size={item.size}
                data-usedin={item.usedIn.join(' ').toLowerCase()}
              >
                <div class="card-thumb" data-preview-path={item.path} data-is-video={item.isVideo ? 'true' : 'false'} data-name={item.name}>
                  <label class="card-checkbox-label" onclick="event.stopPropagation();">
                    <input type="checkbox" class="app-checkbox item-checkbox" value={item.path} />
                  </label>

                  {item.isVideo ? (
                    <div class="video-container">
                      <video src={item.path} muted playsinline preload="metadata" class="thumb-media"></video>
                      <span class="video-badge">VIDEO</span>
                    </div>
                  ) : (
                    <img src={item.path} alt={item.name} loading="lazy" class="thumb-media" />
                  )}

                  <div class="thumb-overlay">
                    <span class="preview-prompt">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="11" y1="8" x2="11" y2="14"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                      </svg>
                      <span>Inspect</span>
                    </span>
                  </div>

                  <div class="card-status-badge">
                    {item.inUse ? (
                      <span class="status-tag tag-success" title={`Referenced in: ${item.usedIn.join(', ')}`}>
                        In Use
                      </span>
                    ) : (
                      <span class="status-tag tag-warning" title="No active content references found. Safe to delete.">
                        Unreferenced
                      </span>
                    )}
                  </div>
                </div>

                <div class="card-details">
                  <div class="name-row">
                    <span class="file-name" title={item.path}>{item.name}</span>
                  </div>

                  <div class="meta-row">
                    <span class="meta-cat">{item.category}</span>
                    <span class="meta-dot">&bull;</span>
                    <span class="meta-ext">{item.ext}</span>
                    <span class="meta-dot">&bull;</span>
                    <span class="meta-size">{fmtBytes(item.size)}</span>
                  </div>

                  {item.inUse ? (
                    <div class="usage-row" title={`Referenced in: ${item.usedIn.join(', ')}`}>
                      <span class="usage-label">Used in:</span>
                      <span class="usage-files">{item.usedIn.map((f) => f.split('/').pop()).join(', ')}</span>
                    </div>
                  ) : (
                    <div class="usage-row is-unused-note">
                      <span>Not linked in content</span>
                    </div>
                  )}

                  <div class="card-actions">
                    <button type="button" class="btn-copy-path" data-copy-path={item.path} title="Copy public URL to clipboard">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                      </svg>
                      <span>Copy Path</span>
                    </button>
                    <button type="button" class="btn-delete-card" data-delete-path={item.path} title={`Delete ${item.fileName}`}>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- TABLE VIEW -->
          <div class="media-table-wrap" id="mediaTable" hidden>
            <table class="media-table">
              <thead>
                <tr>
                  <th class="th-chk"><span class="sr-only">Select</span></th>
                  <th class="th-preview">Preview</th>
                  <th class="th-file">Asset Name & Public Path</th>
                  <th class="th-cat">Category</th>
                  <th class="th-status">Content Reference</th>
                  <th class="th-size">Size</th>
                  <th class="th-actions">Actions</th>
                </tr>
              </thead>
              <tbody>
                {mediaItems.map((item) => (
                  <tr
                    class={`table-row${!item.inUse ? ' is-unreferenced' : ''}`}
                    data-path={item.path}
                    data-name={item.name.toLowerCase()}
                    data-filename={item.fileName.toLowerCase()}
                    data-cat={item.category.toLowerCase().replace(/ /g, '-')}
                    data-inuse={item.inUse ? 'true' : 'false'}
                    data-size={item.size}
                    data-usedin={item.usedIn.join(' ').toLowerCase()}
                  >
                    <td class="td-chk">
                      <input type="checkbox" class="app-checkbox item-checkbox" value={item.path} />
                    </td>
                    <td class="td-preview">
                      <div class="table-thumb" data-preview-path={item.path} data-is-video={item.isVideo ? 'true' : 'false'} data-name={item.name}>
                        {item.isVideo ? (
                          <div class="table-video-icon">VIDEO</div>
                        ) : (
                          <img src={item.path} alt={item.name} loading="lazy" />
                        )}
                      </div>
                    </td>
                    <td class="td-file">
                      <span class="table-file-name">{item.name}</span>
                      <span class="table-file-path">{item.path}</span>
                    </td>
                    <td class="td-cat">
                      <span class="table-cat-badge">{item.category}</span>
                    </td>
                    <td class="td-status">
                      {item.inUse ? (
                        <div class="table-usage-tag tag-success">
                          <span class="status-indicator-dot"></span>
                          <span>Used in {item.usedIn.map((f) => f.split('/').pop()).join(', ')}</span>
                        </div>
                      ) : (
                        <div class="table-usage-tag tag-warning">
                          <span class="status-indicator-dot"></span>
                          <span>Unreferenced (safe to delete)</span>
                        </div>
                      )}
                    </td>
                    <td class="td-size">
                      <span class="table-size-num">{fmtBytes(item.size)}</span>
                    </td>
                    <td class="td-actions">
                      <div class="table-action-btns">
                        <button type="button" class="btn-copy-path btn-table-act" data-copy-path={item.path} title="Copy public path">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                          </svg>
                        </button>
                        <button type="button" class="btn-table-act" data-preview-path={item.path} data-is-video={item.isVideo ? 'true' : 'false'} data-name={item.name} title="Inspect">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          </svg>
                        </button>
                        <button type="button" class="btn-delete-card btn-table-act btn-table-danger" data-delete-path={item.path} title="Delete">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </main>
  </div>

  <!-- LIGHTBOX INSPECTOR MODAL -->
  <div id="lightbox" class="modal-backdrop" hidden>
    <div class="lightbox-card" role="dialog" aria-modal="true" aria-labelledby="lbTitle">
      <div class="lightbox-header">
        <div class="lb-title-wrap">
          <h3 id="lbTitle" class="lb-title">Asset Inspection</h3>
          <span id="lbPath" class="lb-path"></span>
        </div>
        <button id="lbClose" class="modal-close-btn" title="Close inspector (Esc)">&times;</button>
      </div>

      <div class="lightbox-body">
        <div class="lb-media-viewport" id="lbMediaWrap"></div>

        <div class="lb-sidebar">
          <h4 class="sidebar-heading">ASSET METADATA</h4>
          <dl class="meta-dl">
            <div class="dl-row">
              <dt>Public Path</dt>
              <dd id="lbMetaPath"></dd>
            </div>
            <div class="dl-row">
              <dt>Category</dt>
              <dd id="lbMetaCategory"></dd>
            </div>
            <div class="dl-row">
              <dt>File Size</dt>
              <dd id="lbMetaSize"></dd>
            </div>
            <div class="dl-row">
              <dt>Usage Status</dt>
              <dd id="lbMetaStatus"></dd>
            </div>
          </dl>

          <div class="sidebar-divider"></div>

          <h4 class="sidebar-heading">REFERENCED IN CONTENT</h4>
          <div id="lbReferences" class="lb-references-list"></div>

          <div class="sidebar-actions">
            <button type="button" id="lbCopyBtn" class="action-btn action-btn-secondary">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span>Copy Public URL</span>
            </button>
            <a id="lbExternalLink" href="#" target="_blank" rel="noopener" class="action-btn action-btn-secondary">
              <span>Open in New Tab ↗</span>
            </a>
            <button type="button" id="lbDeleteBtn" class="action-btn action-btn-danger">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              <span>Delete Asset</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CONFIRMATION MODAL -->
  <div id="confirmModal" class="modal-backdrop" hidden>
    <div class="confirm-card" role="alertdialog" aria-modal="true" aria-labelledby="confirmTitle">
      <div class="confirm-icon-wrap">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </div>
      <h3 id="confirmTitle" class="confirm-title">Delete Media Assets</h3>
      <p id="confirmMessage" class="confirm-text">This will permanently delete the selected file(s) from local storage and commit the deletion to GitHub.</p>

      <div id="confirmWarningInUse" class="confirm-warning-box" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div>
          <strong>Warning: Content Dependency</strong>
          <p>One or more selected files are actively referenced on the website. Deleting them will cause broken images or missing video playback.</p>
        </div>
      </div>

      <div class="confirm-file-preview" id="confirmFileList"></div>

      <div class="confirm-buttons">
        <button type="button" id="confirmCancelBtn" class="action-btn action-btn-secondary">Cancel</button>
        <button type="button" id="confirmOkBtn" class="action-btn action-btn-danger">Yes, Permanently Delete</button>
      </div>
    </div>
  </div>

  <!-- TOAST CONTAINER -->
  <div id="toast" class="toast-notification" role="status" aria-live="polite"></div>

<script>
  // DOM Elements
  const toast = document.getElementById('toast');
  const mediaGrid = document.getElementById('mediaGrid');
  const mediaTable = document.getElementById('mediaTable');
  const viewGridBtn = document.getElementById('viewGridBtn');
  const viewTableBtn = document.getElementById('viewTableBtn');
  const searchInput = document.getElementById('searchInput');
  const searchClear = document.getElementById('searchClear');
  const tabButtons = document.querySelectorAll('.tab-btn');
  const masterCheckbox = document.getElementById('masterCheckbox');
  const selCountEl = document.getElementById('selCount');
  const visibleCountEl = document.getElementById('visibleCount');
  const btnDeleteSelected = document.getElementById('btnDeleteSelected');
  const btnSelectUnusedOnly = document.getElementById('btnSelectUnusedOnly');
  const btnAutoCleanup = document.getElementById('btnAutoCleanup');

  // Stats Elements
  const statTotal = document.getElementById('statTotal');
  const statInUse = document.getElementById('statInUse');
  const statUnused = document.getElementById('statUnused');
  const statTotalBytes = document.getElementById('statTotalBytes');
  const statUnusedBytes = document.getElementById('statUnusedBytes');
  const countAll = document.getElementById('countAll');
  const countProjects = document.getElementById('countProjects');
  const countHero = document.getElementById('countHero');
  const countSiteAssets = document.getElementById('countSiteAssets');
  const countUnused = document.getElementById('countUnused');

  // Lightbox Elements
  const lightbox = document.getElementById('lightbox');
  const lbClose = document.getElementById('lbClose');
  const lbMediaWrap = document.getElementById('lbMediaWrap');
  const lbTitle = document.getElementById('lbTitle');
  const lbPath = document.getElementById('lbPath');
  const lbMetaPath = document.getElementById('lbMetaPath');
  const lbMetaCategory = document.getElementById('lbMetaCategory');
  const lbMetaSize = document.getElementById('lbMetaSize');
  const lbMetaStatus = document.getElementById('lbMetaStatus');
  const lbReferences = document.getElementById('lbReferences');
  const lbCopyBtn = document.getElementById('lbCopyBtn');
  const lbExternalLink = document.getElementById('lbExternalLink');
  const lbDeleteBtn = document.getElementById('lbDeleteBtn');

  // Confirmation Modal Elements
  const confirmModal = document.getElementById('confirmModal');
  const confirmCancelBtn = document.getElementById('confirmCancelBtn');
  const confirmOkBtn = document.getElementById('confirmOkBtn');
  const confirmMessage = document.getElementById('confirmMessage');
  const confirmWarningInUse = document.getElementById('confirmWarningInUse');
  const confirmFileList = document.getElementById('confirmFileList');

  let activeFilter = 'all';
  let searchTerm = '';
  let currentLbItem = null;
  let confirmResolver = null;

  function fmtBytes(b) {
    if (!b || isNaN(b)) return '0 B';
    const k = 1024;
    const s = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(b) / Math.log(k));
    return `${(b / Math.pow(k, i)).toFixed(1)} ${s[i]}`;
  }

  function showToast(message, type = 'default') {
    if (!toast) return;
    toast.textContent = message;
    toast.className = `toast-notification toast-${type} is-visible`;
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => {
      toast.className = 'toast-notification';
    }, 3800);
  }

  function allItems() {
    return Array.from(document.querySelectorAll('.asset-card'));
  }

  function allTableRows() {
    return Array.from(document.querySelectorAll('.table-row'));
  }

  function allCheckboxes() {
    return Array.from(document.querySelectorAll('.item-checkbox'));
  }

  // Filter & Search Logic
  function applyFilters() {
    let visibleCount = 0;
    const items = allItems();

    items.forEach((card) => {
      const pathVal = card.dataset.path || '';
      const row = document.querySelector(`.table-row[data-path="${pathVal}"]`);
      const cat = card.dataset.cat || '';
      const inUse = card.dataset.inuse === 'true';
      const name = card.dataset.name || '';
      const fileName = card.dataset.filename || '';
      const usedIn = card.dataset.usedin || '';

      let matchesCat = true;
      if (activeFilter === 'unused') {
        matchesCat = !inUse;
      } else if (activeFilter === 'projects') {
        matchesCat = cat === 'projects';
      } else if (activeFilter === 'hero-media') {
        matchesCat = cat === 'hero-media';
      } else if (activeFilter === 'site-assets') {
        matchesCat = cat === 'site-assets' || cat === 'icons';
      }

      let matchesSearch = true;
      if (searchTerm) {
        matchesSearch =
          name.includes(searchTerm) ||
          fileName.includes(searchTerm) ||
          pathVal.toLowerCase().includes(searchTerm) ||
          usedIn.includes(searchTerm);
      }

      const show = matchesCat && matchesSearch;
      card.style.display = show ? '' : 'none';
      if (row) row.style.display = show ? '' : 'none';

      if (show) visibleCount++;
    });

    if (visibleCountEl) visibleCountEl.textContent = visibleCount;
    updateSelection();
  }

  // Selection Handling
  function updateSelection() {
    const checked = allCheckboxes().filter((cb) => {
      const parent = cb.closest('.asset-card') || cb.closest('.table-row');
      return cb.checked && parent && parent.style.display !== 'none';
    });

    // Unify card & table row checkbox states for same paths
    const selectedPaths = new Set(checked.map((cb) => cb.value));

    allCheckboxes().forEach((cb) => {
      const isSel = selectedPaths.has(cb.value);
      cb.checked = isSel;
      const card = cb.closest('.asset-card');
      if (card) card.classList.toggle('is-selected', isSel);
      const row = cb.closest('.table-row');
      if (row) row.classList.toggle('is-selected', isSel);
    });

    const count = selectedPaths.size;
    if (selCountEl) selCountEl.textContent = count;
    if (btnDeleteSelected) {
      btnDeleteSelected.disabled = count === 0;
      btnDeleteSelected.querySelector('span').textContent = count > 0 ? `Delete Selected (${count})` : 'Delete Selected';
    }

    // Master checkbox state
    const visibleCards = allItems().filter((c) => c.style.display !== 'none');
    if (masterCheckbox) {
      if (visibleCards.length === 0 || count === 0) {
        masterCheckbox.checked = false;
        masterCheckbox.indeterminate = false;
      } else if (count === visibleCards.length) {
        masterCheckbox.checked = true;
        masterCheckbox.indeterminate = false;
      } else {
        masterCheckbox.checked = false;
        masterCheckbox.indeterminate = true;
      }
    }
  }

  // Recompute and refresh live stats
  function updateStats() {
    const items = allItems();
    const total = items.length;
    let inUse = 0;
    let totalB = 0;
    let unusedB = 0;
    let proj = 0;
    let hero = 0;
    let site = 0;

    items.forEach((card) => {
      const isU = card.dataset.inuse === 'true';
      const sz = parseInt(card.dataset.size || '0', 10);
      const cat = card.dataset.cat || '';

      if (isU) inUse++;
      else unusedB += sz;
      totalB += sz;

      if (cat === 'projects') proj++;
      else if (cat === 'hero-media') hero++;
      else if (cat === 'site-assets' || cat === 'icons') site++;
    });

    const unref = total - inUse;

    if (statTotal) statTotal.textContent = total;
    if (statInUse) statInUse.textContent = inUse;
    if (statUnused) statUnused.textContent = unref;
    if (statTotalBytes) statTotalBytes.textContent = fmtBytes(totalB);
    if (statUnusedBytes) statUnusedBytes.textContent = `${fmtBytes(unusedB)} reclaimable`;

    if (countAll) countAll.textContent = total;
    if (countProjects) countProjects.textContent = proj;
    if (countHero) countHero.textContent = hero;
    if (countSiteAssets) countSiteAssets.textContent = site;
    if (countUnused) countUnused.textContent = unref;

    if (btnAutoCleanup) {
      btnAutoCleanup.disabled = unref === 0;
      btnAutoCleanup.setAttribute('data-unused', unref);
      btnAutoCleanup.querySelector('span').textContent = `Prune All Unused (${unref})`;
    }
  }

  // Tab Filtering
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.dataset.filter || 'all';
      applyFilters();
    });
  });

  // Search Input
  searchInput?.addEventListener('input', (e) => {
    searchTerm = e.target.value.toLowerCase().trim();
    if (searchClear) searchClear.hidden = !searchTerm;
    applyFilters();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchTerm = '';
    searchClear.hidden = true;
    applyFilters();
  });

  // View Switcher (Grid vs Table)
  viewGridBtn?.addEventListener('click', () => {
    viewGridBtn.classList.add('active');
    viewTableBtn?.classList.remove('active');
    if (mediaGrid) mediaGrid.hidden = false;
    if (mediaTable) mediaTable.hidden = true;
  });

  viewTableBtn?.addEventListener('click', () => {
    viewTableBtn.classList.add('active');
    viewGridBtn?.classList.remove('active');
    if (mediaGrid) mediaGrid.hidden = true;
    if (mediaTable) mediaTable.hidden = false;
  });

  // Checkbox Event Delegation
  document.addEventListener('change', (e) => {
    if (e.target?.classList.contains('item-checkbox')) {
      updateSelection();
    }
  });

  // Master Checkbox
  masterCheckbox?.addEventListener('change', (e) => {
    const isChecked = e.target.checked;
    allItems().forEach((card) => {
      if (card.style.display !== 'none') {
        const pathVal = card.dataset.path;
        document.querySelectorAll(`.item-checkbox[value="${pathVal}"]`).forEach((cb) => {
          cb.checked = isChecked;
        });
      }
    });
    updateSelection();
  });

  // Select Unused Button
  btnSelectUnusedOnly?.addEventListener('click', () => {
    allCheckboxes().forEach((cb) => (cb.checked = false));
    allItems().forEach((card) => {
      if (card.style.display !== 'none' && card.dataset.inuse === 'false') {
        const pathVal = card.dataset.path;
        document.querySelectorAll(`.item-checkbox[value="${pathVal}"]`).forEach((cb) => {
          cb.checked = true;
        });
      }
    });
    updateSelection();
    showToast('Selected all unreferenced files on view', 'default');
  });

  // Copy Path Clipboard Helper
  async function copyPath(pathVal) {
    try {
      await navigator.clipboard.writeText(pathVal);
      showToast(`Copied "${pathVal}" to clipboard`, 'success');
    } catch {
      const ta = document.createElement('textarea');
      ta.value = pathVal;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showToast(`Copied "${pathVal}" to clipboard`, 'success');
    }
  }

  document.addEventListener('click', (e) => {
    const copyBtn = e.target.closest('[data-copy-path]');
    if (copyBtn) {
      e.stopPropagation();
      const p = copyBtn.getAttribute('data-copy-path');
      if (p) copyPath(p);
    }
  });

  // Lightbox Inspection Logic
  function openLightbox(pathVal, isVideo, displayName) {
    const card = document.querySelector(`.asset-card[data-path="${pathVal}"]`);
    if (!card || !lightbox || !lbMediaWrap) return;

    currentLbItem = {
      path: pathVal,
      isVideo,
      name: displayName,
      inUse: card.dataset.inuse === 'true',
      size: parseInt(card.dataset.size || '0', 10),
      category: card.querySelector('.meta-cat')?.textContent || 'Asset',
      usedIn: card.dataset.usedin ? card.dataset.usedin.split(' ').filter(Boolean) : [],
    };

    if (lbTitle) lbTitle.textContent = displayName;
    if (lbPath) lbPath.textContent = pathVal;
    if (lbMetaPath) lbMetaPath.textContent = pathVal;
    if (lbMetaCategory) lbMetaCategory.textContent = currentLbItem.category;
    if (lbMetaSize) lbMetaSize.textContent = fmtBytes(currentLbItem.size);

    if (lbMetaStatus) {
      lbMetaStatus.innerHTML = currentLbItem.inUse
        ? '<span class="status-tag tag-success">Active In Content</span>'
        : '<span class="status-tag tag-warning">Unreferenced</span>';
    }

    if (lbReferences) {
      if (currentLbItem.usedIn.length > 0) {
        lbReferences.innerHTML = currentLbItem.usedIn
          .map((f) => `<div class="ref-badge"><span class="ref-dot"></span><code>${f}</code></div>`)
          .join('');
      } else {
        lbReferences.innerHTML = '<span class="text-muted">No content files link to this asset.</span>';
      }
    }

    if (lbExternalLink) {
      lbExternalLink.href = pathVal;
    }

    lbMediaWrap.innerHTML = isVideo
      ? `<video src="${pathVal}" controls autoplay playsinline class="lb-viewport-media"></video>`
      : `<img src="${pathVal}" alt="${displayName}" class="lb-viewport-media" />`;

    lightbox.hidden = false;
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox || !lbMediaWrap) return;
    lightbox.hidden = true;
    lightbox.classList.remove('is-open');
    lbMediaWrap.innerHTML = '';
    currentLbItem = null;
    document.body.style.overflow = '';
  }

  lbClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (lightbox && !lightbox.hidden) closeLightbox();
      if (confirmModal && !confirmModal.hidden) closeConfirm(false);
    }
  });

  lbCopyBtn?.addEventListener('click', () => {
    if (currentLbItem?.path) copyPath(currentLbItem.path);
  });

  lbDeleteBtn?.addEventListener('click', () => {
    if (currentLbItem?.path) {
      const p = currentLbItem.path;
      closeLightbox();
      executeDelete([p]);
    }
  });

  // Preview click handler
  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-preview-path]');
    if (!trigger) return;
    if (e.target.closest('.item-checkbox') || e.target.closest('.card-checkbox-label')) return;

    const p = trigger.getAttribute('data-preview-path');
    const isVid = trigger.getAttribute('data-is-video') === 'true';
    const name = trigger.getAttribute('data-name') || p.split('/').pop();
    openLightbox(p, isVid, name);
  });

  // Delete Confirmation Logic
  function openConfirm(paths) {
    if (!confirmModal || !paths.length) return Promise.resolve(false);

    let hasInUse = false;
    paths.forEach((p) => {
      const c = document.querySelector(`.asset-card[data-path="${p}"]`);
      if (c && c.dataset.inuse === 'true') hasInUse = true;
    });

    if (confirmWarningInUse) confirmWarningInUse.hidden = !hasInUse;
    if (confirmMessage) {
      confirmMessage.textContent = `Are you sure you want to permanently delete ${paths.length} file${paths.length > 1 ? 's' : ''}?`;
    }

    if (confirmFileList) {
      confirmFileList.innerHTML = paths
        .slice(0, 8)
        .map((p) => `<div class="confirm-file-line"><span class="confirm-bullet">&bull;</span><code>${p}</code></div>`)
        .join('') + (paths.length > 8 ? `<div class="confirm-more">+ ${paths.length - 8} more files</div>` : '');
    }

    confirmModal.hidden = false;
    confirmModal.classList.add('is-open');

    return new Promise((resolve) => {
      confirmResolver = resolve;
    });
  }

  function closeConfirm(result) {
    if (!confirmModal) return;
    confirmModal.hidden = true;
    confirmModal.classList.remove('is-open');
    if (confirmResolver) {
      confirmResolver(result);
      confirmResolver = null;
    }
  }

  confirmCancelBtn?.addEventListener('click', () => closeConfirm(false));
  confirmOkBtn?.addEventListener('click', () => closeConfirm(true));
  confirmModal?.addEventListener('click', (e) => {
    if (e.target === confirmModal) closeConfirm(false);
  });

  // Execute Delete Operation
  async function executeDelete(paths) {
    if (!paths || !paths.length) return;

    const confirmed = await openConfirm(paths);
    if (!confirmed) return;

    showToast(`Deleting ${paths.length} asset${paths.length > 1 ? 's' : ''}…`, 'default');

    if (btnDeleteSelected) btnDeleteSelected.disabled = true;
    if (btnAutoCleanup) btnAutoCleanup.disabled = true;

    try {
      const res = await fetch('/api/admin/media', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ paths }),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Delete request failed');

      const deleted = data.deleted || paths;
      const errors = data.errors || [];

      deleted.forEach((p) => {
        document.querySelectorAll(`.asset-card[data-path="${p}"], .table-row[data-path="${p}"]`).forEach((el) => {
          el.style.transition = 'all 0.28s ease';
          el.style.opacity = '0';
          el.style.transform = 'scale(0.92)';
          setTimeout(() => el.remove(), 280);
        });
      });

      setTimeout(() => {
        updateStats();
        applyFilters();

        if (errors.length > 0) {
          showToast(`Deleted ${deleted.length} file(s). Warning: ${errors[0]}`, 'warning');
        } else {
          showToast(`✓ Permanently deleted ${deleted.length} file${deleted.length > 1 ? 's' : ''}`, 'success');
        }
      }, 300);

    } catch (err) {
      showToast(`Error: ${err.message}`, 'error');
      if (btnDeleteSelected) btnDeleteSelected.disabled = false;
      if (btnAutoCleanup) btnAutoCleanup.disabled = false;
    }
  }

  // Single card delete button
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-delete-path]');
    if (!btn) return;
    e.stopPropagation();
    const p = btn.getAttribute('data-delete-path');
    if (p) executeDelete([p]);
  });

  // Bulk Delete Selected
  btnDeleteSelected?.addEventListener('click', () => {
    const selected = Array.from(new Set(
      allCheckboxes()
        .filter((c) => c.checked)
        .map((c) => c.value)
    ));
    if (selected.length > 0) executeDelete(selected);
  });

  // Prune All Unused Button
  btnAutoCleanup?.addEventListener('click', () => {
    const unusedPaths = allItems()
      .filter((card) => card.dataset.inuse === 'false')
      .map((card) => card.dataset.path)
      .filter(Boolean);

    if (unusedPaths.length > 0) {
      executeDelete(unusedPaths);
    } else {
      showToast('No unreferenced files found to clean up.', 'default');
    }
  });

  // Initial setup
  applyFilters();
</script>

