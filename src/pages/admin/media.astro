  --ac:     #e5342a;
  --ac-lo:  rgba(229,52,42,0.14);
  --ac-md:  rgba(229,52,42,0.28);

  /* semantic colours */
  --gr: #22c55e;  --gr-lo: rgba(34,197,94,0.13);
  --am: #f59e0b;  --am-lo: rgba(245,158,11,0.13);
  --bl: #3b82f6;  --bl-lo: rgba(59,130,246,0.13);
  --pu: #a855f7;  --pu-lo: rgba(168,85,247,0.13);

