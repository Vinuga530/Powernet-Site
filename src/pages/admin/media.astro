.c-green { color: var(--gr); }
.c-amber  { color: var(--am); }

/* ─── TOOLBAR ─────────────────────────────────────────────── */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  padding: 14px 28px;
  border-bottom: 1px solid var(--bd);
  background: var(--bg);
  position: sticky;
  top: 69px;
  z-index: 15;
}
.toolbar-left {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* pill tabs — floating active indicator */
.ftabs {
  display: flex;
  align-items: center;
  gap: 3px;
  background: var(--sf);
  border: 1px solid var(--bd);
  border-radius: var(--r-xl);
  padding: 4px;
}
.tab {
  height: 28px;
  padding: 0 13px;
  border-radius: 99px;
  background: transparent;
  border: none;
  color: var(--tx2);
  font-size: 0.77rem;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  white-space: nowrap;
}
.tab:hover { color: var(--tx); }
.tab.active {
  background: var(--sf3);
  color: var(--tx);
  font-weight: 600;
  box-shadow: 0 1px 4px rgba(0,0,0,0.3);
}

/* search */
.search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--sf);
  border: 1px solid var(--bd);
  border-radius: 10px;
  padding: 0 12px;
  height: 36px;
  color: var(--tx3);
  transition: border-color 0.15s;
}
.search-box:focus-within {
  border-color: var(--bd3);
  color: var(--tx2);
}
.search-box input {
  background: transparent;
  border: none;
  outline: none;
  color: var(--tx);
  font-size: 0.8rem;
  width: 150px;
}
.search-box input::placeholder { color: var(--tx3); }

/* selection bar */
.sel-bar {
  display: flex;
  align-items: center;
  gap: 8px;
}
.sel-info {
  font-size: 0.78rem;
  color: var(--tx2);
  font-weight: 500;
}

/* ─── MEDIA GRID ──────────────────────────────────────────── */
.grid-wrap {
  padding: 22px 28px;
  flex: 1;
}

.mgrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(215px,1fr));
  gap: 16px;
}

.mcard {
  background: var(--sf);
  border: 1px solid var(--bd);
  border-radius: var(--r);
  overflow: hidden;
  cursor: pointer;
  transition: border-color 0.2s, transform 0.22s cubic-bezier(0.16,1,0.3,1), box-shadow 0.22s;
  position: relative;
  display: flex;
  flex-direction: column;
}
.mcard:hover {
  border-color: var(--bd2);
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0,0,0,0.4);
}
.mcard.is-unused {
  border-color: rgba(245,158,11,0.22);
}
.mcard.is-sel {
  border-color: var(--ac);
  box-shadow: 0 0 0 2px rgba(229,52,42,0.22);
}

/* checkbox */
.chk-wrap {
  position: absolute;
  top: 9px;
  left: 9px;
  z-index: 5;
  cursor: pointer;
}
.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
.chkbox {
  display: block;
  width: 21px;
  height: 21px;
  border: 2px solid rgba(255,255,255,0.35);
  border-radius: 7px;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(6px);
  transition: background 0.15s, border-color 0.15s;
  position: relative;
}
.fchk:checked ~ .chkbox {
  background: var(--ac);
  border-color: var(--ac);
}
.fchk:checked ~ .chkbox::after {
  content: '';
  position: absolute;
  left: 5px; top: 2px;
  width: 6px; height: 10px;
  border: 2px solid white;
  border-top: none; border-left: none;
  transform: rotate(45deg);
}

/* thumbnail */
.mthumb {
  height: 158px;
  background: #080a0f;
  position: relative;
  overflow: hidden;
}
.mmedia {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.38s cubic-bezier(0.16,1,0.3,1);
}
.mcard:hover .mmedia { transform: scale(1.06); }

.thumb-hover-overlay {
  position: absolute; inset: 0;
  background: rgba(0,0,0,0.32);
  display: flex; align-items: center; justify-content: center;
  opacity: 0;
  transition: opacity 0.2s;
  color: #fff;
}
.mthumb:hover .thumb-hover-overlay { opacity: 1; }

/* pills on thumbnail */
.upill {
  position: absolute;
  bottom: 7px; right: 7px;
  font-size: 0.6rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 3px 8px;
  border-radius: 99px;
  pointer-events: none;
  z-index: 2;
  backdrop-filter: blur(6px);
}
.up-active {
  background: rgba(34,197,94,0.18);
  color: #4ade80;
  border: 1px solid rgba(34,197,94,0.35);
}
.up-unused {
  background: rgba(245,158,11,0.18);
  color: #fbbf24;
  border: 1px solid rgba(245,158,11,0.35);
}
.vpill {
  position: absolute;
  top: 9px; right: 9px;
  font-size: 0.56rem;
