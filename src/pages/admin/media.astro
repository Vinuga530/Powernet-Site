}

.btn-primary {
  background: var(--ac);
  color: #fff;
  box-shadow: 0 2px 10px rgba(229,52,42,0.3);
}
.btn-primary:hover { background: #cc2b22; box-shadow: 0 4px 16px rgba(229,52,42,0.4); }

.btn-danger {
  background: var(--ac-lo);
  color: #ff7069;
  border: 1px solid var(--ac-md);
}
.btn-danger:hover:not(:disabled) { background: var(--ac-md); }

.btn-solid {
  background: var(--ac);
  color: #fff;
  box-shadow: 0 2px 10px rgba(229,52,42,0.3);
}
.btn-solid:hover { background: #cc2b22; }

.btn-del {
  background: var(--ac-lo);
  color: #ff7069;
  border: 1px solid rgba(229,52,42,0.22);
}
.btn-del:hover:not(:disabled) { background: rgba(229,52,42,0.22); }

.btn-ghost {
  background: transparent;
  color: var(--tx2);
  border: 1px solid var(--bd2);
}
.btn-ghost:hover {
  background: rgba(255,255,255,0.04);
  color: var(--tx);
  border-color: var(--bd3);
}

/* ─── STAT CARDS ──────────────────────────────────────────── */
.stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(175px,1fr));
