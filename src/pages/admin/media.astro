---
import fs from 'node:fs';
import path from 'node:path';

export const prerender = false;

const GITHUB_REPO = 'Vinuga530/Powernet-Site';
const rootDir = process.cwd();
const publicDir = path.join(rootDir, 'public');
const srcDir = path.join(rootDir, 'src');

const managedDirs = [
  { category: 'Projects', dir: path.join(publicDir, 'images', 'projects'), prefix: 'public/images/projects/', icon: '🏗️' },
  { category: 'Logos', dir: path.join(publicDir, 'images', 'logos'), prefix: 'public/images/logos/', icon: '🏷️' },
  { category: 'Hero Images', dir: path.join(publicDir, 'images', 'hero'), prefix: 'public/images/hero/', icon: '🖼️' },
  { category: 'Hero Videos', dir: path.join(publicDir, 'videos', 'hero'), prefix: 'public/videos/hero/', icon: '🎬' },
];

const PROTECTED_FILES = new Set([
  '.gitkeep',
  'favicon.ico',
  'favicon.svg',
  'site.webmanifest',
  'powernet-logo-coloured.png',
  'apple-touch-icon.png',
]);

function getAllFiles(dirPath, arr = []) {
  if (!fs.existsSync(dirPath)) return arr;
  for (const e of fs.readdirSync(dirPath, { withFileTypes: true })) {
    const fp = path.join(dirPath, e.name);
    if (e.isDirectory()) getAllFiles(fp, arr);
    else arr.push(fp);
  }
  return arr;
}

function collectReferencedAssets(sDir) {
  const map = new Map();
  if (!fs.existsSync(sDir)) return map;

  const txtExts = ['.yaml', '.yml', '.astro', '.ts', '.js', '.jsx', '.tsx', '.json', '.md', '.mdx', '.css'];
  const files = getAllFiles(sDir).filter((f) => txtExts.includes(path.extname(f).toLowerCase()));

  for (const file of files) {
    try {
      const content = fs.readFileSync(file, 'utf-8');
      const rel = path.relative(sDir, file).replace(/\\/g, '/');
      const matches = content.match(/["']?(\/(images|videos)\/[^"'\s\n\r]+)/g) || [];
      for (const m of matches) {
        const cleaned = m.replace(/^['"]/, '').replace(/['",;]$/, '').trim().replace(/\\/g, '/');
        const fn = path.basename(cleaned).toLowerCase();
        for (const key of [cleaned, fn]) {
          const ex = map.get(key) || [];
          if (!ex.includes(rel)) ex.push(rel);
          map.set(key, ex);
        }
      }
      const fnm = content.match(/[\w\-.]+\.(png|jpe?g|webp|svg|mp4|webm|gif|avif)/gi) || [];
      for (const fn of fnm) {
        const fnl = fn.toLowerCase();
        const ex = map.get(fnl) || [];
        if (!ex.includes(rel)) ex.push(rel);
        map.set(fnl, ex);
      }
    } catch {}
  }
  return map;
}

const usageMap = collectReferencedAssets(srcDir);
const mediaItems = [];

// 1. Scan local disk
let localCount = 0;
for (const group of managedDirs) {
  if (fs.existsSync(group.dir)) {
    for (const filePath of getAllFiles(group.dir)) {
      const fileName = path.basename(filePath);
      if (PROTECTED_FILES.has(fileName.toLowerCase())) continue;

      const rel = '/' + path.relative(publicDir, filePath).replace(/\\/g, '/');
      const isVideo = ['.mp4', '.webm', '.mov', '.ogg'].includes(path.extname(filePath).toLowerCase());
      const usedIn = usageMap.get(rel) || usageMap.get(rel.slice(1)) || usageMap.get(fileName.toLowerCase()) || [];
      let size = 0;
      try {
        size = fs.statSync(filePath).size;
      } catch {}

      localCount++;
      mediaItems.push({
        name: fileName,
        path: rel,
        category: group.category,
        icon: group.icon,
        size,
        isVideo,
        inUse: usedIn.length > 0,
        usedIn,
      });
    }
  }
}

// 2. In production on Vercel lambda where public/ is not mounted on disk, query GitHub Trees API
if (localCount === 0) {
  try {
    const ghToken =
      Astro.cookies.get('keystatic-gh-access-token')?.value ||
      Astro.request.headers.get('cookie')?.match(/keystatic-gh-access-token=([^;]+)/)?.[1] ||
      Astro.request.headers.get('x-github-token') ||
      process.env.KEYSTATIC_GITHUB_TOKEN ||
      process.env.GITHUB_TOKEN ||
      process.env.GH_TOKEN;

    const ghHeaders = {
      'Accept': 'application/vnd.github+json',
      'User-Agent': 'Powernet-CMS-MediaManager',
    };
    if (ghToken) ghHeaders['Authorization'] = `Bearer ${ghToken}`;

    const res = await fetch(`https://api.github.com/repos/${GITHUB_REPO}/git/trees/main?recursive=1`, {
      headers: ghHeaders,
    });

    if (res.ok) {
      const data = await res.json();
      for (const item of data.tree || []) {
        if (item.type !== 'blob') continue;
        const p = item.path;
        const fn = path.basename(p);
        if (PROTECTED_FILES.has(fn.toLowerCase())) continue;

        let matched = null;
        for (const g of managedDirs) {
          if (p.startsWith(g.prefix)) {
            matched = g;
            break;
          }
        }
        if (matched) {
          const rel = '/' + p.replace(/^public\//, '');
          const isVideo = ['.mp4', '.webm', '.mov', '.ogg'].includes(path.extname(fn).toLowerCase());
          const usedIn = usageMap.get(rel) || usageMap.get(fn.toLowerCase()) || [];

          mediaItems.push({
            name: fn,
            path: rel,
            category: matched.category,
            icon: matched.icon,
            size: item.size || 0,
            isVideo,
            inUse: usedIn.length > 0,
            usedIn,
          });
        }
      }
    }
  } catch {}
}

const totalCount = mediaItems.length;
const unusedCount = mediaItems.filter((m) => !m.inUse).length;
const totalBytes = mediaItems.reduce((a, m) => a + m.size, 0);
const unusedBytes = mediaItems.filter((m) => !m.inUse).reduce((a, m) => a + m.size, 0);

function fmtBytes(b) {
  if (!b) return '0 B';
  const k = 1024,
    s = ['B', 'KB', 'MB', 'GB'],
    i = Math.floor(Math.log(b) / Math.log(k));
  return `${(b / Math.pow(k, i)).toFixed(1)} ${s[i]}`;
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Media Manager — Powernet CMS</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="app-shell">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-name">Powernet</span>
        <span class="brand-label">CMS Admin</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <p class="nav-section-label">Content</p>
      <a href="/keystatic" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
      <a href="/keystatic/collection/projects" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        Projects
      </a>
      <a href="/keystatic/collection/services" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        Services
      </a>
      <a href="/keystatic/collection/clients" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Clients / Logos
      </a>
      <a href="/keystatic/singleton/hero" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        Hero Section
      </a>

      <div class="nav-divider"></div>

      <p class="nav-section-label">Media & Management</p>
      <a href="/admin/media" class="nav-item active">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        Media Manager
        <span class="nav-badge">{totalCount}</span>
      </a>
      <a href="/" target="_blank" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        View Live Site ↗
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="storage-info">
        <div class="storage-label">
          <span>Storage</span>
          <span class="storage-used">{fmtBytes(totalBytes)}</span>
        </div>
        <div class="storage-bar">
          <div class="storage-fill" style={`width: ${Math.min(100, Math.max(5, Math.round((totalBytes / (50 * 1024 * 1024)) * 100)))}%`}></div>
        </div>
        <div class="storage-sub">{totalCount} files &bull; {unusedCount} unused</div>
      </div>
    </div>
  </aside>

  <!-- MAIN VIEW -->
  <main class="main">
    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar-title-wrap">
        <h1 class="page-title">Media Manager</h1>
        <p class="page-sub">View, select, and delete uploaded images and videos</p>
      </div>

      <div class="topbar-actions">
        <a href="/keystatic" class="btn btn-ghost">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          Back to CMS
        </a>
        <button id="btnAutoCleanup" class="btn btn-danger" data-unused={unusedCount} disabled={unusedCount === 0}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          Clean Up All Unused ({unusedCount})
        </button>
      </div>
    </header>

    <!-- STATS ROW -->
    <section class="stats">
      <div class="stat-card">
        <div class="sic sic-blue">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div class="si">
          <span class="sv" id="statTotal">{totalCount}</span>
          <span class="sl">Total Assets</span>
        </div>
        <div class="ss" id="statTotalBytes">{fmtBytes(totalBytes)}</div>
      </div>

      <div class="stat-card">
        <div class="sic sic-green">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="si">
          <span class="sv c-green" id="statInUse">{totalCount - unusedCount}</span>
          <span class="sl">In Active Use</span>
        </div>
        <div class="ss">Linked in CMS Content</div>
      </div>

      <div class="stat-card">
        <div class="sic sic-amber">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div class="si">
          <span class="sv c-amber" id="statUnused">{unusedCount}</span>
          <span class="sl">Unused Assets</span>
        </div>
        <div class="ss" id="statUnusedBytes">{fmtBytes(unusedBytes)} reclaimable</div>
      </div>

      <div class="stat-card">
        <div class="sic sic-purple">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        </div>
        <div class="si">
          <span class="sv">4</span>
          <span class="sl">Categories</span>
        </div>
        <div class="ss">Projects, Logos, Hero</div>
      </div>
    </section>

    <!-- TOOLBAR -->
    <section class="toolbar">
      <div class="toolbar-left">
        <div class="ftabs">
          <button class="tab active" data-f="all">All ({totalCount})</button>
          <button class="tab" data-f="unused">⚠ Unused ({unusedCount})</button>
          <button class="tab" data-f="projects">🏗️ Projects</button>
          <button class="tab" data-f="logos">🏷️ Logos</button>
          <button class="tab" data-f="hero-images">🖼️ Hero Images</button>
          <button class="tab" data-f="hero-videos">🎬 Hero Videos</button>
        </div>

        <div class="search-box">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="searchInput" placeholder="Filter files…" />
        </div>
      </div>

      <div class="sel-bar">
        <span id="selInfo" class="sel-info" hidden><strong id="selCount">0</strong> selected</span>
        <button id="btnSelAll" class="btn btn-ghost">Select All</button>
        <button id="btnSelUnused" class="btn btn-ghost">Select Unused</button>
        <button id="btnDesel" class="btn btn-ghost" hidden>Deselect</button>
        <button id="btnDelSel" class="btn btn-del" disabled>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          Delete Selected
        </button>
      </div>
    </section>

    <!-- MEDIA GRID -->
    <section class="grid-wrap">
      {mediaItems.length === 0 ? (
        <div class="empty">
          <div class="empty-icon">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <h2 class="empty-title">No media files found</h2>
          <p class="empty-body">Uploaded media for Projects, Logos, and Hero will appear here automatically.</p>
          <a href="/keystatic" class="btn btn-primary">Go to Keystatic CMS →</a>
        </div>
      ) : (
        <div class="mgrid" id="mgrid">
          {mediaItems.map((item) => (
            <article
              class={`mcard${!item.inUse ? ' is-unused' : ''}`}
              data-path={item.path}
              data-name={item.name.toLowerCase()}
              data-cat={item.category.toLowerCase().replace(/ /g, '-')}
              data-inuse={item.inUse ? 'true' : 'false'}
              data-size={item.size}
            >
              <label class="chk-wrap" title="Select">
                <input type="checkbox" class="fchk sr-only" value={item.path} />
                <span class="chkbox"></span>
              </label>

              <div class="mthumb" data-preview-path={item.path} data-is-video={item.isVideo ? 'true' : 'false'} data-name={item.name}>
                {item.isVideo ? (
                  <video src={item.path} muted loop playsinline class="mmedia" preload="metadata" />
                ) : (
                  <img src={item.path} alt={item.name} loading="lazy" class="mmedia" />
                )}
                <span class={`upill${item.inUse ? ' up-active' : ' up-unused'}`}>
                  {item.inUse ? '✓ In Use' : '⚠ Unused'}
                </span>
                {item.isVideo && <span class="vpill">VIDEO</span>}
                <div class="thumb-hover-overlay" title="Click to preview">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                </div>
              </div>

              <div class="minfo">
                <div class="mname-row">
                  <p class="mname" title={item.name}>{item.name}</p>
                  <button type="button" class="del-btn" data-dpath={item.path} title={`Delete ${item.name}`}>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </div>
                <div class="mmeta">
                  <span class="mbadge">{item.icon} {item.category}</span>
                  <span class="msize">{fmtBytes(item.size)}</span>
                </div>
                {item.inUse && (
                  <p class="musedIn" title={`Used in: ${item.usedIn.join(', ')}`}>
                    Used in: {item.usedIn.map((f) => f.split('/').pop()).join(', ')}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  </main>
</div>

<!-- CONFIRMATION MODAL -->
<div id="dlg" class="dlg-overlay" hidden>
  <div class="dlg-box">
    <div class="dlg-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <h2 class="dlg-title">Delete Selected Files?</h2>
    <p id="dlgMsg" class="dlg-msg">This will permanently delete the files from the project and the GitHub repository.</p>
    <div id="dlgWarning" class="dlg-warning" hidden>
      ⚠️ <strong>Warning:</strong> One or more selected files are actively in use on the live site!
    </div>
    <div class="dlg-actions">
      <button id="dlgCancel" class="btn btn-ghost">Cancel</button>
      <button id="dlgConfirm" class="btn btn-solid">Yes, Delete Files</button>
    </div>
  </div>
</div>

<!-- LIGHTBOX MODAL -->
<div id="lightbox" class="lb-overlay" hidden>
  <div class="lb-box">
    <div class="lb-header">
      <span id="lbTitle" class="lb-title"></span>
      <button id="lbClose" class="lb-close" title="Close preview">&times;</button>
    </div>
    <div class="lb-media-wrap" id="lbMediaWrap"></div>
    <div class="lb-footer">
      <span id="lbPath" class="lb-path"></span>
      <button id="lbDelete" class="btn btn-del">Delete This File</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div id="toast" class="toast"></div>

<script>
  const toast = document.getElementById('toast');
  function showToast(msg, type = 'info') {
    if (!toast) return;
    toast.textContent = msg;
    toast.className = 'toast toast-' + type + ' t-on';
    clearTimeout(toast._t);
    toast._t = setTimeout(() => {
      toast.className = 'toast';
    }, 4500);
  }

  // Confirmation dialog
  const dlg = document.getElementById('dlg');
  const dlgMsg = document.getElementById('dlgMsg');
  const dlgWarning = document.getElementById('dlgWarning');
  const dlgConfirm = document.getElementById('dlgConfirm');
  const dlgCancel = document.getElementById('dlgCancel');
  let resolveCfm = null;

  function openDlg(msg, hasInUse = false) {
    if (dlgMsg) dlgMsg.textContent = msg;
    if (dlgWarning) dlgWarning.hidden = !hasInUse;
    dlg.hidden = false;
    dlg.classList.add('open');
    return new Promise((r) => {
      resolveCfm = r;
    });
  }

  dlgConfirm?.addEventListener('click', () => {
    dlg.hidden = true;
    dlg.classList.remove('open');
    resolveCfm?.(true);
  });
  dlgCancel?.addEventListener('click', () => {
    dlg.hidden = true;
    dlg.classList.remove('open');
    resolveCfm?.(false);
  });

  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lbTitle = document.getElementById('lbTitle');
  const lbPath = document.getElementById('lbPath');
  const lbMediaWrap = document.getElementById('lbMediaWrap');
  const lbClose = document.getElementById('lbClose');
  const lbDelete = document.getElementById('lbDelete');
  let currentLbPath = '';

  function openLightbox(src, isVideo, name) {
    if (!lightbox || !lbMediaWrap) return;
    currentLbPath = src;
    if (lbTitle) lbTitle.textContent = name;
    if (lbPath) lbPath.textContent = src;
    lbMediaWrap.innerHTML = isVideo
      ? `<video src="${src}" controls autoplay playsinline class="lb-media"></video>`
      : `<img src="${src}" alt="${name}" class="lb-media" />`;
    lightbox.hidden = false;
    lightbox.classList.add('open');
  }

  function closeLightbox() {
    if (!lightbox || !lbMediaWrap) return;
    lightbox.hidden = true;
    lightbox.classList.remove('open');
    lbMediaWrap.innerHTML = '';
  }

  lbClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  lbDelete?.addEventListener('click', () => {
    if (currentLbPath) {
      closeLightbox();
      doDelete([currentLbPath]);
    }
  });

  // Selection & UI elements
  const btnDelSel = document.getElementById('btnDelSel');
  const btnSelAll = document.getElementById('btnSelAll');
  const btnSelUnused = document.getElementById('btnSelUnused');
  const btnDesel = document.getElementById('btnDesel');
  const btnAutoCleanup = document.getElementById('btnAutoCleanup');
  const selCount = document.getElementById('selCount');
  const selInfo = document.getElementById('selInfo');
  const tabs = document.querySelectorAll('.tab');
  const searchInput = document.getElementById('searchInput');

  function cards() {
    return Array.from(document.querySelectorAll('.mcard'));
  }
  function checks() {
    return Array.from(document.querySelectorAll('.fchk'));
  }

  function updateSel() {
    const checked = checks().filter((c) => c.checked);
    const n = checked.length;
    if (selCount) selCount.textContent = n;
    if (selInfo) selInfo.hidden = n === 0;
    if (btnDelSel) btnDelSel.disabled = n === 0;
    if (btnDesel) btnDesel.hidden = n === 0;

    cards().forEach((card) => {
      const cb = card.querySelector('.fchk');
      card.classList.toggle('is-sel', !!cb?.checked);
    });
  }

  document.addEventListener('change', (e) => {
    if (e.target?.classList.contains('fchk')) updateSel();
  });

  // Card click (select vs preview)
  document.addEventListener('click', (e) => {
    const thumb = e.target.closest('.mthumb');
    if (thumb) {
      const p = thumb.getAttribute('data-preview-path');
      const isVid = thumb.getAttribute('data-is-video') === 'true';
      const nm = thumb.getAttribute('data-name') || '';
      openLightbox(p, isVid, nm);
      return;
    }

    const card = e.target.closest('.mcard');
    if (!card) return;
    if (e.target.closest('.del-btn') || e.target.closest('.chk-wrap')) return;

    const cb = card.querySelector('.fchk');
    if (cb) {
      cb.checked = !cb.checked;
      updateSel();
    }
  });

  // Filter tabs & Search
  let activeFilter = 'all';
  let searchTerm = '';

  function applyFilters() {
    cards().forEach((card) => {
      const cat = card.dataset.cat || '';
      const inUse = card.dataset.inuse === 'true';
      const name = card.dataset.name || '';

      let matchTab = true;
      if (activeFilter === 'unused') matchTab = !inUse;
      else if (activeFilter !== 'all') matchTab = cat === activeFilter;

      let matchSearch = true;
      if (searchTerm) matchSearch = name.includes(searchTerm);

      card.style.display = matchTab && matchSearch ? '' : 'none';
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      activeFilter = tab.dataset.f || 'all';
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchTerm = e.target.value.toLowerCase().trim();
    applyFilters();
  });

  // Bulk selectors
  btnSelAll?.addEventListener('click', () => {
    cards().forEach((card) => {
      if (card.style.display !== 'none') {
        const cb = card.querySelector('.fchk');
        if (cb) cb.checked = true;
      }
    });
    updateSel();
  });

  btnSelUnused?.addEventListener('click', () => {
    cards().forEach((card) => {
      const cb = card.querySelector('.fchk');
      if (cb) {
        cb.checked = card.dataset.inuse === 'false' && card.style.display !== 'none';
      }
    });
    updateSel();
  });

  btnDesel?.addEventListener('click', () => {
    checks().forEach((cb) => (cb.checked = false));
    updateSel();
  });

  // Delete Action
  async function doDelete(paths) {
    if (!paths || !paths.length) return;

    // Check if any file is in use
    const hasInUse = paths.some((p) => {
      const c = document.querySelector(`.mcard[data-path="${p}"]`);
      return c && c.dataset.inuse === 'true';
    });

    const ok = await openDlg(
      `Permanently delete ${paths.length} file${paths.length !== 1 ? 's' : ''}? This will remove them immediately from disk and commit the deletion to GitHub.`,
      hasInUse
    );
    if (!ok) return;

    showToast(`Deleting ${paths.length} file(s) via CMS…`, 'info');
    if (btnDelSel) btnDelSel.disabled = true;
    if (btnAutoCleanup) btnAutoCleanup.disabled = true;

    try {
      const res = await fetch('/api/admin/media', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ paths }),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Delete request failed');

      const deleted = data.deleted || paths;
      const errors = data.errors || [];

      deleted.forEach((p) => {
        const c = document.querySelector(`.mcard[data-path="${p}"]`);
        if (c) {
          c.style.transition = 'all 0.3s ease';
          c.style.opacity = '0';
          c.style.transform = 'scale(0.85)';
          setTimeout(() => c.remove(), 300);
        }
      });

      if (errors.length > 0) {
        showToast(`Deleted ${deleted.length} file(s). ${errors.length} failed: ${errors[0]}`, 'error');
      } else {
        showToast(`✓ Successfully deleted ${deleted.length} file${deleted.length !== 1 ? 's' : ''}`, 'success');
      }

      setTimeout(updateSel, 350);
    } catch (err) {
      showToast('Error: ' + err.message, 'error');
      if (btnDelSel) btnDelSel.disabled = false;
      if (btnAutoCleanup) btnAutoCleanup.disabled = false;
    }
  }

  btnDelSel?.addEventListener('click', () => {
    const selected = checks()
      .filter((c) => c.checked)
      .map((c) => c.value);
    doDelete(selected);
  });

  btnAutoCleanup?.addEventListener('click', () => {
    const unused = cards()
      .filter((c) => c.dataset.inuse === 'false')
      .map((c) => c.dataset.path)
      .filter(Boolean);
    doDelete(unused);
  });

  // Single card delete button
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-dpath]');
    if (!btn) return;
    e.stopPropagation();
    doDelete([btn.getAttribute('data-dpath')]);
  });
</script>

