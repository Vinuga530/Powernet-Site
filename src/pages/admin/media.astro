  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
  animation: din 0.2s ease;
}

@keyframes din {
  from {
    transform: scale(0.95) translateY(8px);
    opacity: 0;
  }
  to {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

.dlg-icon {
  width: 50px;
  height: 50px;
  background: rgba(245, 158, 11, 0.12);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--am);
  margin-bottom: 3px;
}

.dlg-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--tx);
}

.dlg-msg {
  font-size: 0.84rem;
  color: var(--mt);
  line-height: 1.4;
}

.dlg-warning {
  background: rgba(229, 52, 42, 0.15);
  border: 1px solid rgba(229, 52, 42, 0.3);
  color: #ff6b63;
  padding: 8px 12px;
  border-radius: 7px;
  font-size: 0.76rem;
  text-align: left;
}

.dlg-actions {
  display: flex;
  gap: 8px;
  margin-top: 6px;
}

/* LIGHTBOX MODAL */
.lb-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 150;
  opacity: 0;
  transition: opacity 0.2s;
  pointer-events: none;
  padding: 20px;
}

.lb-overlay[hidden] {
  display: none;
}

.lb-overlay.open {
  opacity: 1;
  pointer-events: all;
}

.lb-box {
  background: var(--sf2);
  border: 1px solid var(--bd2);
  border-radius: 14px;
  max-width: 800px;
  width: 100%;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
}

.lb-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid var(--bd);
}

.lb-title {
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--tx);
}

.lb-close {
  background: transparent;
  border: none;
  font-size: 1.6rem;
  line-height: 1;
  color: var(--mt);
  cursor: pointer;
  padding: 0 4px;
}

.lb-close:hover {
  color: var(--tx);
}

.lb-media-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: #000;
  min-height: 300px;
  max-height: 60vh;
  overflow: hidden;
}

.lb-media {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.lb-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  border-top: 1px solid var(--bd);
  background: var(--sf);
}

.lb-path {
  font-size: 0.76rem;
  color: var(--mt);
  font-family: monospace;
}

/* TOAST */
.toast {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 200;
  padding: 10px 16px;
  border-radius: 9px;
  font-size: 0.82rem;
  font-weight: 500;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  transform: translateY(12px);
  opacity: 0;
  transition: all 0.3s;
  pointer-events: none;
  max-width: 360px;
}

.t-on {
  opacity: 1;
  transform: translateY(0);
}

.toast-success {
  background: #052e16;
  color: #4ade80;
  border: 1px solid rgba(34, 197, 94, 0.35);
}

.toast-error {
  background: #2d0a0a;
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.35);
}

.toast-info {
  background: #1e1b2e;
  color: #a78bfa;
  border: 1px solid rgba(139, 92, 246, 0.35);
}
