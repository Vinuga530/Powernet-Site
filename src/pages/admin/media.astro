  --r-sm:  8px;
  --r:     14px;
  --r-lg:  20px;
  --r-xl:  26px;
  --sw:    248px;
}

html, body {
  height: 100%;
  background: var(--bg);
  color: var(--tx);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ─── LAYOUT ─────────────────────────────────────────────── */
.app-shell {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* ─── SIDEBAR ─────────────────────────────────────────────── */
.sidebar {
  width: var(--sw);
  min-width: var(--sw);
  background: var(--sf);
  border-right: 1px solid var(--bd);
