---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, getCollection } from "astro:content";

const aboutEntry = await getEntry("aboutPage", "company");
const about = aboutEntry.data;

const statsEntry = await getEntry("stats", "company");
const stats = statsEntry.data;

const clientEntries = await getCollection("clients");
clientEntries.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="About Us | Powernet (Pvt) Ltd">
  <div class="about-page container">
    <!-- Header Block -->
    <header class="about-header scroll-reveal reveal-up">
      <div class="about-eyebrow-wrap">
        <span class="about-rule" aria-hidden="true"></span>
        <span class="text-technical-meta">About</span>
      </div>
      <h1 class="text-display-xl">{about.heroTitle}</h1>
      <p class="about-subtitle">
        {about.heroBody}
      </p>
    </header>

    <!-- Main Two-Column Layout -->
    <div class="about-layout">
      <!-- Left: Key Figures -->
      <section class="about-col about-stats scroll-reveal reveal-up">
        <h2 class="about-group-title">Key Figures</h2>
        <div class="stats-list">
          <div class="stat-item">
            <span class="stat-index">01</span>
            <div class="stat-body">
              <span class="stat-value">{stats.annualTurnover}</span>
              <span class="stat-label">Annual Turnover</span>
            </div>
          </div>
          <div class="stat-item">
            <span class="stat-index">02</span>
            <div class="stat-body">
              <span class="stat-value">{stats.permanentStaffValue}</span>
              <span class="stat-label">{stats.permanentStaffLabel}</span>
            </div>
          </div>
          <div class="stat-item">
            <span class="stat-index">03</span>
            <div class="stat-body">
              <span class="stat-value">{stats.contractualStaffValue}</span>
              <span class="stat-label">{stats.contractualStaffLabel}</span>
            </div>
          </div>
          <div class="stat-item">
            <span class="stat-index">04</span>
            <div class="stat-body">
              <span class="stat-value">{stats.coverageValue}</span>
              <span class="stat-label">{stats.coverageLabel}</span>
            </div>
          </div>
          <div class="stat-item">
            <span class="stat-index">05</span>
            <div class="stat-body">
              <span class="stat-value">{stats.ownershipValue}</span>
              <span class="stat-label">{stats.ownershipLabel} Ownership</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Right: Board of Directors -->
      <section class="about-col about-board scroll-reveal reveal-up">
        <h2 class="about-group-title">Board of Directors</h2>
        <ol class="board-list">
          {about.boardMembers.map((member, idx) => (
            <li class="board-item">
              <span class="board-index">{String(idx + 1).padStart(2, "0")}</span>
              <span class="board-name">{member}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <!-- Clients Register (Matching Homepage) -->
    <section class="section-clients scroll-reveal reveal-up">
      <div class="clients-header">
        <span class="clients-rule" aria-hidden="true"></span>
        <span class="clients-meta">Selected clients &middot; {clientEntries.length}</span>
      </div>

      <ul class="clients-list">
        {clientEntries.map((entry) => (
          <li class="client-item">{entry.data.name}</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    min-height: 80vh;
  }

  /* Header Block */
  .about-header {
    margin-bottom: var(--space-2xl);
  }

  .about-eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .about-rule {
    display: inline-block;
    width: 48px;
    height: 2px;
    background-color: var(--color-brand);
    flex-shrink: 0;
  }

  .about-subtitle {
    font-size: var(--text-body-large);
    color: var(--color-muted);
    max-width: 44rem;
    line-height: 1.6;
    margin-top: var(--space-md);
  }

  /* Layout */
  .about-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 900px) {
    .about-layout {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .about-group-title {
    font-family: var(--font-mono);
    font-size: var(--text-technical-meta);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    font-weight: 500;
    margin: 0 0 var(--space-md) 0;
  }

  /* Left: Key Figures */
  .stats-list {
    display: flex;
    flex-direction: column;
  }

  .stat-item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--space-md);
    padding: 1.25rem 0 1.25rem 1rem;
    border-top: 1px solid var(--color-border);
  }

  .stat-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .stat-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-brand);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-item:hover::before {
    transform: scaleY(1);
  }

  .stat-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-brand);
  }

  .stat-body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .stat-value {
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-foreground);
    font-family: var(--font-sans);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    font-weight: 500;
  }

  /* Right: Board of Directors */
  .board-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .board-item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--space-md);
    padding: 1.5rem 0 1.5rem 1rem;
    border-top: 1px solid var(--color-border);
  }

  .board-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .board-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-brand);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .board-item:hover::before {
    transform: scaleY(1);
  }

  .board-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-brand);
  }

  .board-name {
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--color-foreground);
    line-height: 1.3;
  }

  /* Clients Section */
  .section-clients {
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .clients-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .clients-rule {
    display: inline-block;
    width: 48px;
    height: 2px;
    background-color: var(--color-brand);
    flex-shrink: 0;
  }

  .clients-meta {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .clients-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    column-gap: var(--space-xl);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .client-item {
    position: relative;
    display: block;
    padding: 0.9rem 0 0.9rem 1rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.3;
    color: var(--color-foreground);
    transition: opacity 250ms ease-out;
  }

  .client-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: calc(0.9rem + 0.65em);
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-brand);
    opacity: 0;
    transition: opacity 250ms ease-out;
  }

  @media (hover: hover) {
    .clients-list:has(li:hover) li:not(:hover) {
      opacity: 0.35;
    }
    .client-item:hover::before {
      opacity: 1;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .stat-item::before,
    .board-item::before,
    .client-item,
    .client-item::before {
      transition: none !important;
    }

    .reveal-up {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  /* About-page scroll reveals — mirrors index.astro's initRevealObserver pattern */
  const initAboutReveals = () => {
    const targets = document.querySelectorAll('.reveal-up');
    if (!targets.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible', 'is-revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -12% 0px' });

    targets.forEach(target => {
      const rect = target.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.75 && rect.bottom > 0) {
        target.classList.add('is-visible', 'is-revealed');
      } else {
        observer.observe(target);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutReveals, { once: true });
  } else {
    initAboutReveals();
  }
  document.addEventListener('astro:page-load', initAboutReveals);
</script>
