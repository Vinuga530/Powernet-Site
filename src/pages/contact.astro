---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, getCollection } from 'astro:content';

const companyEntry = await getEntry('settings', 'company');
const company = companyEntry.data;

const hotlineEntries = await getCollection('hotlines');
hotlineEntries.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Contact Us | Powernet (Pvt) Ltd">
  <div class="contact-page container">
    <header class="contact-header scroll-reveal reveal-up">
      <div class="contact-eyebrow-wrap">
        <span class="contact-rule" aria-hidden="true"></span>
        <span class="text-technical-meta">Contact</span>
      </div>
      <h1 class="text-display-xl">Talk to our engineers.</h1>
      <p class="contact-subtitle">
        Tell us about the project and we'll reply within one business day.
      </p>
    </header>

    <div class="contact-layout">
      <!-- Left: Departments -->
      <section class="contact-col contact-departments scroll-reveal reveal-up">
        <h2 class="contact-group-title">Departments</h2>
        <ol class="hotlines-list">
          {hotlineEntries.map((entry, idx) => {
            const phones = entry.data.phone.split('/').map((p: string) => p.trim());
            return (
              <li class="hotline-item">
                <span class="hotline-index">{String(idx + 1).padStart(2, '0')}</span>
                <span class="hotline-name">{entry.data.department}</span>
                <span class="hotline-phone-wrap">
                  {phones.map((phone: string, pIdx: number) => (
                    <>
                      {pIdx > 0 && <span class="hotline-phone-sep">/</span>}
                      <a href={`tel:${phone.replace(/\s+/g, '')}`} class="hotline-phone">
                        {phone}
                      </a>
                    </>
                  ))}
                </span>
              </li>
            );
          })}
        </ol>
      </section>

      <!-- Right: Offices -->
      <section class="contact-col contact-offices scroll-reveal reveal-up">
        <h2 class="contact-group-title">Offices</h2>
        <div class="offices-wrap">
          <div class="office-block">
            <span class="office-label text-technical-meta">Head Office</span>
            <p class="office-address">
              {company.addressLine1}<br />
              {company.addressLine2}, {company.country}
            </p>
            <div class="office-meta">
              <div class="office-meta-row">
                <span class="office-meta-label">Tel</span>
                <a href={`tel:${company.primaryPhone.replace(/\s+/g, '')}`} class="office-meta-value">
                  {company.primaryPhone}
                </a>
              </div>
              <div class="office-meta-row">
                <span class="office-meta-label">Fax</span>
                <span class="office-meta-value">{company.fax}</span>
              </div>
              <div class="office-meta-row">
                <span class="office-meta-label">Email</span>
                <a href={`mailto:${company.primaryEmail}`} class="office-meta-value">
                  {company.primaryEmail}
                </a>
              </div>
            </div>
          </div>

          <div class="office-block">
            <span class="office-label text-technical-meta">Warehouse Facility</span>
            <p class="office-address">
              {company.warehouseAddressLine1}<br />
              {company.warehouseAddressLine2}
            </p>
          </div>
        </div>
      </section>
    </div>

    <!-- Map Row -->
    <section class="contact-map-section scroll-reveal reveal-up">
      <iframe
        class="contact-map"
        src={company.mapsEmbedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Powernet Head Office Location"
      ></iframe>
      <div class="map-meta-row">
        <span class="map-address">
          {company.addressLine1}, {company.addressLine2}
        </span>
        <a
          href={company.mapsSearchUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="map-directions"
        >
          Get Directions &rarr;
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-top: var(--space-3xl);
    min-height: 80vh;
  }

  /* Header */
  .contact-header {
    margin-bottom: var(--space-2xl);
  }

  .contact-eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .contact-rule {
    display: inline-block;
    width: 48px;
    height: 2px;
    background-color: var(--color-brand);
    flex-shrink: 0;
  }

  .contact-subtitle {
    font-size: var(--text-body-large);
    color: var(--color-muted);
    max-width: 34rem;
    line-height: 1.6;
    margin-top: var(--space-md);
  }

  /* Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 900px) {
    .contact-layout {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .contact-group-title {
    font-family: var(--font-mono);
    font-size: var(--text-technical-meta);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    font-weight: 500;
    margin: 0 0 var(--space-md) 0;
  }

  /* Left: Hotlines */
  .hotlines-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hotline-item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-md);
    padding: 1.5rem 0 1.5rem 1rem;
    border-top: 1px solid var(--color-border);
  }

  .hotline-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .hotline-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-brand);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hotline-item:hover::before,
  .hotline-item:focus-within::before {
    transform: scaleY(1);
  }

  .hotline-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-brand);
  }

  .hotline-name {
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--color-foreground);
    line-height: 1.3;
  }

  .hotline-phone-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .hotline-phone-sep {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--color-muted);
    user-select: none;
  }

  .hotline-phone {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-muted);
    white-space: nowrap;
    text-decoration: none;
    position: relative;
    z-index: 2;
    transition: color 0.2s ease;
  }

  .hotline-phone:hover {
    color: var(--color-brand);
    text-decoration: underline;
  }

  .hotline-item:hover .hotline-phone,
  .hotline-item:focus-within .hotline-phone {
    color: var(--color-brand);
  }

  @media (max-width: 600px) {
    .hotline-item {
      grid-template-columns: auto 1fr;
      row-gap: var(--space-xs);
      column-gap: var(--space-sm);
    }

    .hotline-phone-wrap {
      grid-column: 2 / -1;
      justify-content: flex-start;
    }
  }

  /* Right: Offices */
  .offices-wrap {
    display: flex;
    flex-direction: column;
  }

  .office-block {
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .office-block:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .office-label {
    display: block;
    margin-bottom: var(--space-xs);
  }

  .office-address {
    font-size: var(--text-body-large);
    line-height: 1.5;
    color: var(--color-foreground);
    margin: 0;
  }

  .office-meta {
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .office-meta-row {
    display: flex;
    gap: var(--space-md);
    font-size: var(--text-body);
  }

  .office-meta-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
    width: 48px;
    flex-shrink: 0;
  }

  .office-meta-value {
    color: var(--color-foreground);
    transition: color 0.2s ease;
  }

  a.office-meta-value:hover {
    color: var(--color-brand);
  }

  /* Map Row */
  .contact-map-section {
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-3xl);
  }

  .contact-map {
    display: block;
    width: 100%;
    height: 360px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: none;
    filter: grayscale(0.3) contrast(1.05);
  }

  @media (max-width: 600px) {
    .contact-map {
      height: 280px;
    }
  }

  .map-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding-top: var(--space-sm);
  }

  @media (max-width: 600px) {
    .map-meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
  }

  .map-address {
    font-size: var(--text-body);
    color: var(--color-muted);
  }

  .map-directions {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-brand);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .map-directions:hover {
    color: var(--color-brand-dark);
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .hotline-item::before,
    .hotline-phone,
    .office-meta-value,
    .map-directions {
      transition: none !important;
    }

    .reveal-up {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  /* Contact-page scroll reveals — mirrors index.astro's initRevealObserver pattern */
  const initContactReveals = () => {
    const targets = document.querySelectorAll('.reveal-up');
    if (!targets.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible', 'is-revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -12% 0px' });

    targets.forEach(target => {
      const rect = target.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.75 && rect.bottom > 0) {
        target.classList.add('is-visible', 'is-revealed');
      } else {
        observer.observe(target);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactReveals, { once: true });
  } else {
    initContactReveals();
  }
  document.addEventListener('astro:page-load', initContactReveals);
</script>
