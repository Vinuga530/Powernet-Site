---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, getCollection } from 'astro:content';

const companyEntry = await getEntry('settings', 'company');
const company = companyEntry.data;

const hotlineEntries = await getCollection('hotlines');
hotlineEntries.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Contact Us | Powernet (Pvt) Ltd">
  <section class="section-contact scroll-reveal" style="padding-top: var(--space-3xl); min-height: 80vh;">
    <div class="container fade-in">
      <h1 class="text-display-xl">Get in Touch</h1>
      <p class="text-body-large" style="margin-top: var(--space-md); color: var(--color-muted); max-width: 600px;">
        Reach out to our specialized departments or visit our facilities for more information.
      </p>

      <div class="contact-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: var(--space-2xl); margin-top: var(--space-3xl);">
        
        <!-- Department Hotlines -->
        <div class="contact-card" style="background-color: var(--color-surface); padding: var(--space-xl); border: 1px solid var(--color-border);">
          <h2 class="text-h1" style="margin-bottom: var(--space-lg);">Department Hotlines</h2>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: var(--space-md); padding: 0;">
            {hotlineEntries.map((entry) => (
              <li>
                <span class="text-label" style="display: block; color: var(--color-brand); margin-bottom: 4px;">{entry.data.department}</span>
                <a href={`tel:${entry.data.phone.replace(/\s+/g, '')}`} class="text-h4">{entry.data.phone}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Facilities -->
        <div class="facilities-wrapper" style="display: flex; flex-direction: column; gap: var(--space-xl);">
          <div class="contact-card" style="background-color: var(--color-surface); padding: var(--space-xl); border: 1px solid var(--color-border);">
            <h2 class="text-h1" style="margin-bottom: var(--space-lg);">Head Office</h2>
            <p class="text-body-large" style="color: var(--color-muted);">
              {company.addressLine1}<br />
              {company.addressLine2}
            </p>
            <div style="margin-top: var(--space-md);">
              <p>General Tel: <a href={`tel:${company.primaryPhone.replace(/\s+/g, '')}`}>{company.primaryPhone}</a></p>
              <p>Fax: {company.fax}</p>
              <p>Email: <a href={`mailto:${company.primaryEmail}`} style="color: var(--color-brand);">{company.primaryEmail}</a></p>
            </div>
          </div>

          <div class="contact-card" style="background-color: var(--color-surface); padding: var(--space-xl); border: 1px solid var(--color-border);">
            <h2 class="text-h1" style="margin-bottom: var(--space-lg);">Warehouse Facility</h2>
            <p class="text-body-large" style="color: var(--color-muted);">
              {company.warehouseAddressLine1}<br />
              {company.warehouseAddressLine2}
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
