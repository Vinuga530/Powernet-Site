---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, Picture } from "astro:assets";
import heroImg from "../assets/images/photos/background img.png";
import projectImg from "../assets/images/photos/a guy fixing a server pc.jpg";
---

<BaseLayout title="Powernet (Pvt) Ltd | Power and Infrastructure Solutions">
  <section class="hero-section hero-dark-overlay">
    <div class="hero-bg image-reveal-wrapper is-revealed">
      <Picture
        src={heroImg}
        alt="Powernet Infrastructure"
        class="image-reveal-inner bg-img"
        formats={["avif", "webp"]}
        quality={75}
        widths={[640, 1024, 1600, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="bg-overlay"></div>
    </div>

    <div class="container hero-content">
      <div class="hero-text-wrapper">
        <h1 class="hero-title text-display-xl">
          <span class="text-reveal-wrapper"
            ><span class="text-reveal-inner stagger-2">INFRASTRUCTURE,</span
            ></span
          ><br />
          <span class="text-reveal-wrapper"
            ><span class="text-reveal-inner stagger-3">CONNECTED.</span></span
          >
        </h1>

        <p class="hero-subtitle text-body-large fade-in stagger-4">
          Integrated engineering and technology solutions for Sri Lanka's
          critical operations.
        </p>
      </div>
    </div>
  </section>

  <section class="credibility-strip scroll-reveal">
    <div class="container">
      <div class="strip-grid">
        <div class="strip-item fade-in stagger-1">
          <span class="strip-eyebrow">OWNERSHIP</span>
          <span class="strip-value">100%</span>
          <span class="strip-desc">Sri Lankan</span>
          <svg class="stats-icon stats-icon-1" viewBox="0 0 100 100" fill="none" stroke="#202020" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="draw-path" d="M 25.3,18.7 L 27.2,31.2 L 28.1,31.5 L 30.2,31.6 L 30.7,32.3 L 30.8,33.3 L 31.1,34.2 L 30.5,34.7 L 29.7,35.3 L 28.9,36.2 L 28.5,37.1 L 28.2,38.2 L 28.3,39.5 L 28.1,40.6 L 27.5,41.4 L 27.0,42.3 L 26.7,43.2 L 26.6,44.3 L 26.8,45.5 L 26.9,46.5 L 27.1,47.9 L 27.9,50.7 L 28.6,53.8 L 28.4,54.8 L 28.5,57.0 L 28.8,58.7 L 29.1,61.3 L 28.9,62.4 L 29.1,63.9 L 29.7,65.8 L 29.4,66.9 L 29.4,68.0 L 29.7,69.2 L 30.0,70.7 L 30.3,71.6 L 30.9,73.2 L 31.6,74.9 L 31.9,76.0 L 32.0,77.1 L 32.4,78.2 L 32.8,79.4 L 33.0,80.3 L 33.3,81.5 L 33.7,82.5 L 34.1,83.3 L 34.6,84.2 L 35.2,85.0 L 35.9,85.7 L 36.9,86.6 L 37.8,87.3 L 38.6,87.9 L 39.6,88.3 L 40.8,88.6 L 41.8,89.0 L 42.9,89.3 L 43.9,89.6 L 45.9,89.9 L 47.6,90.0 L 48.6,89.7 L 49.8,89.3 L 51.9,88.4 L 53.2,87.5 L 54.1,87.1 L 55.1,86.8 L 56.3,86.5 L 57.8,86.2 L 58.6,85.9 L 59.5,85.4 L 60.4,85.1 L 61.4,84.8 L 62.3,84.4 L 62.8,84.1 L 63.8,83.5 L 64.6,82.8 L 65.5,82.2 L 66.2,81.6 L 67.0,81.1 L 67.8,80.5 L 68.6,79.8 L 69.6,78.9 L 70.2,78.3 L 71.2,76.9 L 71.8,75.9 L 72.2,75.1 L 72.6,74.0 L 73.0,72.9 L 73.4,72.0 L 73.7,71.0 L 73.9,70.0 L 74.0,68.9 L 74.3,67.8 L 74.5,66.8 L 74.7,65.9 L 74.5,64.8 L 74.3,63.6 L 74.4,61.9 L 74.4,59.9 L 73.8,57.6 L 73.4,56.5 L 72.9,54.5 L 71.6,51.7 L 70.6,50.1 L 69.8,49.3 L 69.1,48.7 L 68.8,47.6 L 68.4,46.6 L 67.8,45.7 L 67.0,44.8 L 66.6,44.1 L 66.1,43.0 L 65.7,41.8 L 65.6,40.7 L 65.4,39.7 L 65.0,38.7 L 64.8,37.5 L 64.2,36.3 L 63.4,35.5 L 62.6,34.9 L 62.2,34.0 L 61.9,32.8 L 61.4,32.1 L 60.6,31.3 L 59.8,30.7 L 59.3,29.8 L 58.7,28.9 L 57.9,28.4 L 57.3,27.6 L 56.8,26.9 L 56.1,25.5 L 55.6,24.8 L 55.3,23.7 L 54.7,22.5 L 54.2,21.6 L 53.5,20.8 L 52.4,20.0 L 51.3,19.0 L 50.1,17.9 L 49.2,17.2 L 45.8,14.5 L 44.7,13.2 L 44.0,12.1 L 43.4,11.3 L 42.4,10.5 L 41.4,10.2 L 40.1,10.0 L 38.2,10.2 L 36.8,10.3 L 35.0,10.5 L 33.8,10.9 L 32.8,11.4 L 31.8,11.8 L 31.1,12.3 L 30.3,13.0 L 29.5,13.7 L 28.8,14.4 L 28.2,15.5 L 27.3,16.0 L 26.4,17.0 L 25.9,18.1 L 25.3,18.7 Z" />
          </svg>
        </div>
        <div class="strip-item fade-in stagger-2">
          <span class="strip-eyebrow">TEAM</span>
          <span class="strip-value">150+</span>
          <span class="strip-desc">Permanent Staff</span>
          <svg class="stats-icon stats-icon-2" viewBox="0 0 100 100" fill="none" stroke="#202020" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="draw-path" d="M30 45 C 30 20, 70 20, 70 45" />
            <path class="draw-path" d="M20 45 L 80 45" />
            <path class="draw-path" d="M35 45 L 35 60 C 35 65, 40 70, 50 70 C 60 70, 65 65, 65 60 L 65 45" />
            <path class="draw-path" d="M20 95 C 20 80, 30 70, 50 70 C 70 70, 80 80, 80 95" />
          </svg>
        </div>
        <div class="strip-item fade-in stagger-3">
          <span class="strip-eyebrow">CAPACITY</span>
          <span class="strip-value">200+</span>
          <span class="strip-desc">Contractual Personnel</span>
          <svg class="stats-icon stats-icon-3" viewBox="0 0 100 100" fill="none" stroke="#202020" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="draw-path" d="M30 15 L 70 15 L 70 85 L 30 85 Z" />
            <path class="draw-path" d="M30 35 L 70 35" />
            <path class="draw-path" d="M30 55 L 70 55" />
            <path class="draw-path" d="M40 25 L 45 25" />
            <path class="draw-path" d="M40 45 L 45 45" />
            <path class="draw-path" d="M40 65 L 45 65" />
            <path class="draw-path" d="M60 70 L 60 75 C 60 90, 85 85, 85 100" />
            <circle class="draw-accent" cx="85" cy="100" r="2.5" fill="var(--color-brand)" stroke="none" />
          </svg>
        </div>
        <div class="strip-item fade-in stagger-4">
          <span class="strip-eyebrow">COVERAGE</span>
          <span class="strip-value">Islandwide</span>
          <span class="strip-desc">Delivery</span>
          <svg class="stats-icon stats-icon-4" viewBox="0 0 100 100" fill="none" stroke="#202020" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="draw-path" d="M15 90 C 40 95, 20 60, 50 65 C 70 68, 65 50, 65 40" />
            <path class="draw-path" d="M65 40 C 55 25, 55 10, 65 10 C 75 10, 75 25, 65 40 Z" />
            <circle class="draw-accent" cx="65" cy="22" r="2.5" fill="var(--color-brand)" stroke="none" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Positioning -->
  <section class="section-positioning scroll-reveal">
    <div class="container">
      <div class="grid-12">
        <div class="pos-left fade-in stagger-1">
          <h2 class="text-display">Infrastructure, Built for your needs.</h2>
        </div>
        <div class="pos-right fade-in stagger-2">
          <p class="text-body-large">
            A client may require networking, electrical, UPS, CCTV, fire
            protection, air conditioning, interior work, and IT systems.
            Powernet coordinates these scopes as a single, integrated project.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="section-services scroll-reveal">
    <div class="container">
      <div class="section-header fade-in">
        <span class="text-label">What Do We Offer?</span>
      </div>

      <div class="service-row fade-in stagger-1">
        <div class="service-num"><span class="text-h4">01</span></div>
        <div class="service-title"><h3 class="text-h1">Data & Voice</h3></div>
        <div class="service-desc">
          <p>
            Structured CAT5/CAT6, fiber optic, LAN/WAN and wireless network
            implementations for enterprise environments.
          </p>
        </div>
      </div>
      <div class="service-row fade-in stagger-2">
        <div class="service-num"><span class="text-h4">02</span></div>
        <div class="service-title"><h3 class="text-h1">Power & UPS</h3></div>
        <div class="service-desc">
          <p>
            Electrical design, installation and reliable backup power
            infrastructure for mission-critical facilities.
          </p>
        </div>
      </div>
      <div class="service-row fade-in stagger-3">
        <div class="service-num"><span class="text-h4">03</span></div>
        <div class="service-title">
          <h3 class="text-h1">Fire Protection</h3>
        </div>
        <div class="service-desc">
          <p>
            Detection, alarm, hydrant and suppression systems designed for
            commercial and industrial safety requirements.
          </p>
        </div>
      </div>
      <div class="service-row fade-in stagger-4">
        <div class="service-num"><span class="text-h4">04</span></div>
        <div class="service-title">
          <h3 class="text-h1">Security Systems</h3>
        </div>
        <div class="service-desc">
          <p>
            Integrated CCTV, PA and access control solutions for safer, smarter
            operations.
          </p>
        </div>
      </div>

      <div class="services-cta fade-in stagger-4">
        <a href="/services" class="btn-secondary"
          >Check out our all services &rarr;</a
        >
      </div>
    </div>
  </section>

  <!-- Featured Projects section to be changed later into a CMS bsed upload of projects -->
  <section class="section-projects scroll-reveal">
    <div class="container">
      <div class="section-header fade-in">
        <span class="text-label">Our Success Stories</span>
      </div>

      <div class="grid-12">
        <div class="project-left fade-in stagger-1">
          <h2 class="text-display">WORLD BANK<br />SRI LANKA</h2>
          <p class="text-technical-meta project-meta">
            Medium-voltage cabling • Internal wiring • Earthing
          </p>
          <a href="/projects" class="btn-secondary mt-md"
            >View Case Study &rarr;</a
          >
        </div>
        <div class="project-right">
          <div class="image-reveal-wrapper project-image">
            <Picture
              src={projectImg}
              alt="World Bank Project"
              class="image-reveal-inner"
              formats={["avif", "webp"]}
              quality={75}
              widths={[400, 800, 1200]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-cta scroll-reveal">
    <div class="container fade-in">
      <h2 class="text-display-xl">LET'S BUILD<br />WHAT'S NEXT.</h2>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary"
          ><span>DISCUSS A PROJECT &rarr;</span></a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    color: var(--color-dark-foreground);
    overflow: hidden;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 160px;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.22) 55%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: #111;
    will-change: transform;
  }

  .bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% center;
  }

  .bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.62) 0%,
      rgba(0, 0, 0, 0.46) 27%,
      rgba(0, 0, 0, 0.18) 52%,
      rgba(0, 0, 0, 0) 72%
    );
  }

  .hero-content {
    position: relative;
    z-index: 10;
    padding-bottom: 6vh; /* Raise content slightly */
  }

  .hero-title {
    margin-bottom: var(--space-md);
    --text-display-xl: clamp(3.2rem, 5.2vw, 5.64rem);
  }

  .hero-subtitle {
    max-width: 580px;
    font-size: clamp(1rem, 1.15vw, 1.18rem);
    line-height: 1.6;
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.88);
  }

  /* Credibility Strip */
  .credibility-strip {
    background-color: var(--color-background);
    padding: 100px 0 var(--space-3xl);
  }

  .strip-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .strip-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: var(--space-xl) var(--space-lg);
    border-left: 1px solid var(--color-border);
    position: relative;
  }

  .strip-item:first-child {
    border-left: none;
  }

  .strip-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand);
  }

  .strip-value {
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-foreground);
    letter-spacing: -0.02em;
  }

  .strip-desc {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .credibility-strip {
      padding: 80px 0 var(--space-2xl);
    }
    .strip-grid {
      grid-template-columns: repeat(2, 1fr);
      border-bottom: none;
    }
    .strip-item {
      padding: var(--space-lg) var(--space-md);
      border-bottom: 1px solid var(--color-border);
    }
    .strip-item:nth-child(odd) {
      border-left: none;
    }
    .strip-item:nth-child(even) {
      border-left: 1px solid var(--color-border);
    }
  }

  /* Stats Icons */
  .stats-icon {
    position: absolute;
    right: var(--space-lg);
    top: 50%;
    transform: translateY(-50%);
    width: 80px;
    height: 70px;
    pointer-events: none;
    opacity: 0.65;
  }
  
  @media (max-width: 768px) {
    .stats-icon {
      right: var(--space-md);
      width: 60px;
      height: 55px;
      opacity: 0.55;
    }
  }

  /* Positioning Section */
  .section-positioning {
    padding: var(--space-3xl) 0;
    background-color: var(--color-background);
  }
  .pos-left {
    grid-column: span 7;
  }
  .pos-right {
    grid-column: 9 / -1;
    display: flex;
    align-items: center;
  }

  /* Services Overview */
  .section-services {
    padding: var(--space-3xl) 0;
  }
  .section-header {
    margin-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
  }
  .service-row {
    display: flex;
    align-items: baseline;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.3s;
  }
  .service-row:hover {
    background-color: var(--color-surface);
  }
  .service-num {
    width: 10%;
    color: var(--color-muted);
  }
  .service-title {
    width: 45%;
  }
  .service-desc {
    width: 45%;
    color: var(--color-muted);
  }
  .services-cta {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: flex-end;
  }
  .btn-secondary {
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    border-bottom: 1px solid var(--color-brand);
    padding-bottom: 4px;
    transition: color 0.3s;
  }
  .btn-secondary:hover {
    color: var(--color-brand);
  }

  /* Projects Section */
  .section-projects {
    padding: var(--space-3xl) 0;
    background-color: var(--color-surface);
  }
  .project-left {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .project-meta {
    margin-top: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .project-right {
    grid-column: 7 / -1;
  }
  .project-image {
    aspect-ratio: 4/3;
    width: 100%;
  }

  .mt-md {
    margin-top: var(--space-md);
    align-self: flex-start;
  }

  /* CTA Section */
  .section-cta {
    padding: var(--space-3xl) 0;
    background-color: var(--color-brand);
    color: white;
    text-align: center;
  }
  .cta-actions {
    margin-top: var(--space-2xl);
  }
  .section-cta .btn-primary {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
  .section-cta .btn-primary:hover {
    background-color: var(--color-surface);
  }

  @media (max-width: 1024px) {
    .pos-left,
    .pos-right {
      grid-column: 1 / -1;
    }
    .pos-right {
      margin-top: var(--space-md);
    }
    .service-row {
      flex-direction: column;
      gap: var(--space-sm);
    }
    .service-num,
    .service-title,
    .service-desc {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion || window.innerWidth < 768) return;

    const heroBg = document.querySelector('.hero-bg');
    if (!(heroBg instanceof HTMLElement)) return;

    let ticking = false;
    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrolled = Math.max(0, window.scrollY);
          // Animate only while hero section is in view
          if (scrolled < window.innerHeight * 1.5) {
            const yPos = scrolled * 0.16; // 16% parallax depth
            // Overscale slightly to prevent edges from showing
            heroBg.style.transform = `translate3d(0, ${yPos}px, 0) scale(1.05)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Initialize on load

    // Stats Animation Logic
    const credibilityStrip = document.querySelector('.credibility-strip');
    const svgIcons = document.querySelectorAll('.stats-icon');
    
    if (credibilityStrip && svgIcons.length > 0) {
      if (prefersReducedMotion) {
        svgIcons.forEach(svg => {
          const accent = svg.querySelector('.draw-accent');
          if (accent) accent.style.opacity = '1';
        });
      } else {
        const svgAnimations = [];
        
        svgIcons.forEach(svg => {
          const paths = svg.querySelectorAll('.draw-path');
          const accent = svg.querySelector('.draw-accent');
          
          if (accent) accent.style.opacity = '0';
          
          const pathData = Array.from(paths).map(path => {
            const length = path.getTotalLength();
            path.style.strokeDasharray = length;
            path.style.strokeDashoffset = length;
            path.getBoundingClientRect(); // trigger reflow
            return { el: path, length: length };
          });
          
          svgAnimations.push({ svg, paths: pathData, accent });
        });
        
        const animateIcon = (iconData) => {
          let currentDelay = 0;
          const totalLength = iconData.paths.reduce((sum, p) => sum + p.length, 0);
          const totalDuration = 1400; // 1.4s per illustration

          iconData.paths.forEach(p => {
            const duration = Math.max(250, (p.length / totalLength) * totalDuration);
            p.el.style.transition = `stroke-dashoffset ${duration}ms cubic-bezier(0.22, 1, 0.36, 1) ${currentDelay}ms`;
            p.el.style.strokeDashoffset = '0';
            currentDelay += duration - 80;
          });
          
          if (iconData.accent) {
            iconData.accent.style.transition = `opacity 400ms ease ${currentDelay}ms`;
            iconData.accent.style.opacity = '1';
          }
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              obs.unobserve(entry.target);
              svgAnimations.forEach((iconData, index) => {
                setTimeout(() => {
                  animateIcon(iconData);
                }, index * 1700); // 1.4s animation + 300ms sequence delay
              });
            }
          });
        }, { threshold: 0.35 });

        observer.observe(credibilityStrip);
      }
    }
  });
</script>
