<script>
  document.addEventListener("DOMContentLoaded", () => {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion || window.innerWidth < 768) return;

    const heroBg = document.querySelector('.hero-bg');
    if (!(heroBg instanceof HTMLElement)) return;

    let ticking = false;
    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrolled = Math.max(0, window.scrollY);
          // Animate only while hero section is in view
          if (scrolled < window.innerHeight * 1.5) {
            const yPos = scrolled * 0.16; // 16% parallax depth
            // Overscale slightly to prevent edges from showing
            heroBg.style.transform = `translate3d(0, ${yPos}px, 0) scale(1.05)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Initialize on load

    // Stats Animation Logic
    const credibilityStrip = document.querySelector('.credibility-strip');
    const svgIcons = document.querySelectorAll('.stats-icon');
    
    if (credibilityStrip && svgIcons.length > 0) {
      if (prefersReducedMotion) {
        svgIcons.forEach(svg => {
          const accent = svg.querySelector('.draw-accent');
          if (accent) accent.style.opacity = '1';
        });
      } else {
        const svgAnimations = [];
        
        svgIcons.forEach(svg => {
          const paths = svg.querySelectorAll('.draw-path');
          const accent = svg.querySelector('.draw-accent');
          
          if (accent) accent.style.opacity = '0';
          
          const pathData = Array.from(paths).map(path => {
            const length = path.getTotalLength();
            path.style.strokeDasharray = length;
            path.style.strokeDashoffset = length;
            path.getBoundingClientRect(); // trigger reflow
            return { el: path, length: length };
          });
          
          svgAnimations.push({ svg, paths: pathData, accent });
        });
        
        const animateIcon = (iconData) => {
          let currentDelay = 0;
          const totalLength = iconData.paths.reduce((sum, p) => sum + p.length, 0);
          const totalDuration = 1400; // 1.4s per illustration

          iconData.paths.forEach(p => {
            const duration = Math.max(250, (p.length / totalLength) * totalDuration);
            p.el.style.transition = `stroke-dashoffset ${duration}ms cubic-bezier(0.22, 1, 0.36, 1) ${currentDelay}ms`;
            p.el.style.strokeDashoffset = '0';
            currentDelay += duration - 80;
          });
          
          if (iconData.accent) {
            iconData.accent.style.transition = `opacity 400ms ease ${currentDelay}ms`;
            iconData.accent.style.opacity = '1';
          }
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              obs.unobserve(entry.target);
              svgAnimations.forEach((iconData, index) => {
                setTimeout(() => {
                  animateIcon(iconData);
                }, index * 1700); // 1.4s animation + 300ms sequence delay
              });
            }
          });
        }, { threshold: 0.35 });

        observer.observe(credibilityStrip);
      }
    }
  });
</script>
