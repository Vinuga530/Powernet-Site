---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, Picture } from 'astro:assets';
import heroImg from '../assets/images/photos/guy working on a project on site.jpg';
import projectImg from '../assets/images/photos/a guy fixing a server pc.jpg';
---

<BaseLayout title="Powernet (Pvt) Ltd | Premium Infrastructure Solutions Sri Lanka">
  
  <section class="hero-section hero-dark-overlay">
    <div class="hero-bg image-reveal-wrapper is-revealed">
      <Picture src={heroImg} alt="Powernet Infrastructure" class="image-reveal-inner bg-img" formats={["avif", "webp"]} quality={75} widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="bg-overlay"></div>
    </div>
    
    <div class="container hero-content">
      <div class="hero-text-wrapper">
        <h1 class="hero-title text-display-xl">
          <span class="text-reveal-wrapper"><span class="text-reveal-inner stagger-2">INFRASTRUCTURE,</span></span><br>
          <span class="text-reveal-wrapper"><span class="text-reveal-inner stagger-3">CONNECTED.</span></span>
        </h1>
        
        <p class="hero-subtitle text-body-large fade-in stagger-4">
          Integrated engineering and technology solutions for Sri Lanka's critical operations.
        </p>
      </div>
    </div>
  </section>

  <section class="credibility-strip scroll-reveal">
    <div class="container">
      <div class="strip-grid">
        <div class="strip-item fade-in stagger-1">
          <span class="text-label">Established</span>
          <span class="text-h4">100% Sri Lankan</span>
        </div>
        <div class="strip-item fade-in stagger-2">
          <span class="text-label">Workforce</span>
          <span class="text-h4">150+ Permanent Staff</span>
        </div>
        <div class="strip-item fade-in stagger-3">
          <span class="text-label">Capacity</span>
          <span class="text-h4">200+ Contractual</span>
        </div>
        <div class="strip-item fade-in stagger-4">
          <span class="text-label">Reach</span>
          <span class="text-h4">Island-Wide Delivery</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Positioning -->
  <section class="section-positioning scroll-reveal">
    <div class="container">
      <div class="grid-12">
        <div class="pos-left fade-in stagger-1">
          <h2 class="text-display">NOT JUST ANOTHER IT COMPANY.</h2>
        </div>
        <div class="pos-right fade-in stagger-2">
          <p class="text-body-large">
            A client may require networking, electrical, UPS, CCTV, fire protection, air conditioning, interior work, and IT systems. Powernet coordinates these scopes as a single, integrated project.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="section-services scroll-reveal">
    <div class="container">
      <div class="section-header fade-in">
        <span class="text-label">01 // Disciplines</span>
      </div>
      
      <div class="service-row fade-in stagger-1">
        <div class="service-num"><span class="text-h4">01</span></div>
        <div class="service-title"><h3 class="text-h1">Data & Voice</h3></div>
        <div class="service-desc"><p>Structured CAT5/CAT6, fiber optic, LAN/WAN and wireless network implementations for enterprise environments.</p></div>
      </div>
      <div class="service-row fade-in stagger-2">
        <div class="service-num"><span class="text-h4">02</span></div>
        <div class="service-title"><h3 class="text-h1">Power & UPS</h3></div>
        <div class="service-desc"><p>Electrical design, installation and reliable backup power infrastructure for mission-critical facilities.</p></div>
      </div>
      <div class="service-row fade-in stagger-3">
        <div class="service-num"><span class="text-h4">03</span></div>
        <div class="service-title"><h3 class="text-h1">Fire Protection</h3></div>
        <div class="service-desc"><p>Detection, alarm, hydrant and suppression systems designed for commercial and industrial safety requirements.</p></div>
      </div>
      <div class="service-row fade-in stagger-4">
        <div class="service-num"><span class="text-h4">04</span></div>
        <div class="service-title"><h3 class="text-h1">Security Systems</h3></div>
        <div class="service-desc"><p>Integrated CCTV, PA and access control solutions for safer, smarter operations.</p></div>
      </div>
      
      <div class="services-cta fade-in stagger-4">
        <a href="/services" class="btn-secondary">View All Disciplines &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section-projects scroll-reveal">
    <div class="container">
      <div class="section-header fade-in">
        <span class="text-label">02 // Success Stories</span>
      </div>
      
      <div class="grid-12">
        <div class="project-left fade-in stagger-1">
          <h2 class="text-display">WORLD BANK<br>SRI LANKA</h2>
          <p class="text-technical-meta project-meta">Medium-voltage cabling • Internal wiring • Earthing</p>
          <a href="/projects" class="btn-secondary mt-md">View Case Study &rarr;</a>
        </div>
        <div class="project-right">
          <div class="image-reveal-wrapper project-image">
            <Picture src={projectImg} alt="World Bank Project" class="image-reveal-inner" formats={["avif", "webp"]} quality={75} widths={[400, 800, 1200]} sizes="(max-width: 1024px) 100vw, 50vw" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-cta scroll-reveal">
    <div class="container fade-in">
      <h2 class="text-display-xl">LET'S BUILD<br>WHAT'S NEXT.</h2>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary"><span>DISCUSS A PROJECT &rarr;</span></a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    color: var(--color-dark-foreground); /* Forces text white on hero */
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: #111;
  }

  .bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    padding-top: var(--space-3xl);
  }

  .hero-title {
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    max-width: 600px;
    opacity: 0.9;
  }

  /* Credibility Strip */
  .credibility-strip {
    background-color: var(--color-brand);
    color: white;
    padding: var(--space-lg) 0;
  }

  .strip-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .strip-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .strip-item .text-label {
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .strip-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-xl);
    }
  }

  /* Positioning Section */
  .section-positioning {
    padding: var(--space-3xl) 0;
    background-color: var(--color-background);
  }
  .pos-left {
    grid-column: span 7;
  }
  .pos-right {
    grid-column: 9 / -1;
    display: flex;
    align-items: center;
  }
  
  /* Services Overview */
  .section-services {
    padding: var(--space-3xl) 0;
  }
  .section-header {
    margin-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
  }
  .service-row {
    display: flex;
    align-items: baseline;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.3s;
  }
  .service-row:hover {
    background-color: var(--color-surface);
  }
  .service-num {
    width: 10%;
    color: var(--color-muted);
  }
  .service-title {
    width: 45%;
  }
  .service-desc {
    width: 45%;
    color: var(--color-muted);
  }
  .services-cta {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: flex-end;
  }
  .btn-secondary {
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    border-bottom: 1px solid var(--color-brand);
    padding-bottom: 4px;
    transition: color 0.3s;
  }
  .btn-secondary:hover {
    color: var(--color-brand);
  }

  /* Projects Section */
  .section-projects {
    padding: var(--space-3xl) 0;
    background-color: var(--color-surface);
  }
  .project-left {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .project-meta {
    margin-top: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .project-right {
    grid-column: 7 / -1;
  }
  .project-image {
    aspect-ratio: 4/3;
    width: 100%;
  }

  .mt-md {
    margin-top: var(--space-md);
    align-self: flex-start;
  }

  /* CTA Section */
  .section-cta {
    padding: var(--space-3xl) 0;
    background-color: var(--color-brand);
    color: white;
    text-align: center;
  }
  .cta-actions {
    margin-top: var(--space-2xl);
  }
  .section-cta .btn-primary {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
  .section-cta .btn-primary:hover {
    background-color: var(--color-surface);
  }
  
  @media (max-width: 1024px) {
    .pos-left, .pos-right {
      grid-column: 1 / -1;
    }
    .pos-right {
      margin-top: var(--space-md);
    }
    .service-row {
      flex-direction: column;
      gap: var(--space-sm);
    }
    .service-num, .service-title, .service-desc {
      width: 100%;
    }
  }
</style>


