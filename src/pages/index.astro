---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, Picture } from "astro:assets";
import heroImg from "../assets/images/photos/background img.png";
import projectImg from "../assets/images/photos/a guy fixing a server pc.jpg";
---

<BaseLayout title="Powernet (Pvt) Ltd | Power and Infrastructure Solutions">
  <section class="hero-section hero-dark-overlay">
    <div class="hero-bg image-reveal-wrapper is-revealed">
      <Picture
        src={heroImg}
        alt="Powernet Infrastructure"
        class="image-reveal-inner bg-img"
        formats={["avif", "webp"]}
        quality={75}
        widths={[640, 1024, 1600, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="bg-overlay"></div>
    </div>

    <div class="container hero-content">
      <div class="hero-text-wrapper">
        <h1 class="hero-title text-display-xl">
          <span class="text-reveal-wrapper"
            ><span class="text-reveal-inner stagger-2">INFRASTRUCTURE,</span
            ></span
          ><br />
          <span class="text-reveal-wrapper"
            ><span class="text-reveal-inner stagger-3">CONNECTED.</span></span
          >
        </h1>

        <p class="hero-subtitle text-body-large fade-in stagger-4">
          Integrated engineering and technology solutions for Sri Lanka's
          critical operations.
        </p>
      </div>
    </div>
  </section>

  <section class="credibility-strip scroll-reveal">
    <div class="container">
      <div class="strip-grid">
        <div class="strip-item fade-in stagger-1">
          <span class="strip-eyebrow">OWNERSHIP</span>
          <span class="strip-value">100%</span>
          <span class="strip-desc">Sri Lankan</span>
          <svg class="stats-icon stats-icon-1" viewBox="0 0 100 100" fill="none" stroke="#202020" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="draw-path" d="M42 12 C 45 8, 48 8, 50 12 C 55 22, 60 28, 65 38 C 72 50, 75 65, 62 82 C 55 90, 40 92, 32 82 C 25 72, 28 55, 34 45 C 38 38, 40 25, 42 12 Z" />
            <circle class="draw-accent" cx="42" cy="65" r="2.5" fill="var(--color-brand)" stroke="none" />
          </svg>
        </div>
        <div class="strip-item fade-in stagger-2">
          <span class="strip-eyebrow">TEAM</span>
          <span class="strip-value">150+</span>
          <span class="strip-desc">Permanent Staff</span>
          <svg class="stats-icon stats-icon-2" viewBox="0 0 100 100" fill="none" stroke="#202020" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="draw-path" d="M30 45 C 30 25, 70 25, 70 45 L 75 45 L 75 50 L 25 50 L 25 45 Z" />
            <path class="draw-path" d="M50 22 L 50 45" />
            <path class="draw-path" d="M35 50 L 35 65 C 35 75, 20 85, 20 100" />
            <path class="draw-path" d="M65 50 L 65 65 C 65 75, 80 85, 80 100" />
            <path class="draw-path" d="M35 65 L 50 75 L 65 65" />
            <circle class="draw-accent" cx="50" cy="75" r="2.5" fill="var(--color-brand)" stroke="none" />
          </svg>
        </div>
        <div class="strip-item fade-in stagger-3">
          <span class="strip-eyebrow">CAPACITY</span>
          <span class="strip-value">200+</span>
          <span class="strip-desc">Contractual Personnel</span>
          <svg class="stats-icon stats-icon-3" viewBox="0 0 100 100" fill="none" stroke="#202020" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="draw-path" d="M30 15 L 70 15 L 70 85 L 30 85 Z" />
            <path class="draw-path" d="M30 30 L 70 30" />
            <path class="draw-path" d="M30 45 L 70 45" />
            <path class="draw-path" d="M30 60 L 70 60" />
            <path class="draw-path" d="M40 22.5 L 42 22.5" />
            <path class="draw-path" d="M40 37.5 L 42 37.5" />
            <path class="draw-path" d="M40 52.5 L 42 52.5" />
            <path class="draw-path" d="M55 70 C 55 90, 85 70, 85 90" />
            <circle class="draw-accent" cx="85" cy="90" r="2.5" fill="var(--color-brand)" stroke="none" />
          </svg>
        </div>
        <div class="strip-item fade-in stagger-4">
          <span class="strip-eyebrow">COVERAGE</span>
          <span class="strip-value">Islandwide</span>
          <span class="strip-desc">Delivery</span>
          <svg class="stats-icon stats-icon-4" viewBox="0 0 100 100" fill="none" stroke="#202020" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="draw-path" d="M15 85 C 30 85, 25 55, 45 60 C 65 65, 55 45, 75 35" />
            <path class="draw-path" d="M75 35 C 65 25, 65 10, 75 10 C 85 10, 85 25, 75 35 Z" />
            <circle class="draw-accent" cx="75" cy="18" r="2.5" fill="var(--color-brand)" stroke="none" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Positioning -->
  <section class="section-positioning scroll-reveal">
    <div class="container">
      <div class="grid-12">
        <div class="pos-left fade-in stagger-1">
          <h2 class="text-display">Infrastructure, Built for your needs.</h2>
        </div>
        <div class="pos-right fade-in stagger-2">
          <p class="text-body-large">
            A client may require networking, electrical, UPS, CCTV, fire
            protection, air conditioning, interior work, and IT systems.
            Powernet coordinates these scopes as a single, integrated project.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="section-services scroll-reveal">
    <div class="container">
      <div class="section-header fade-in">
        <span class="text-label">What Do We Offer?</span>
      </div>

      <div class="service-row fade-in stagger-1">
        <div class="service-num"><span class="text-h4">01</span></div>
        <div class="service-title"><h3 class="text-h1">Data & Voice</h3></div>
        <div class="service-desc">
          <p>
            Structured CAT5/CAT6, fiber optic, LAN/WAN and wireless network
            implementations for enterprise environments.
          </p>
        </div>
      </div>
      <div class="service-row fade-in stagger-2">
        <div class="service-num"><span class="text-h4">02</span></div>
        <div class="service-title"><h3 class="text-h1">Power & UPS</h3></div>
        <div class="service-desc">
          <p>
            Electrical design, installation and reliable backup power
            infrastructure for mission-critical facilities.
          </p>
        </div>
      </div>
      <div class="service-row fade-in stagger-3">
        <div class="service-num"><span class="text-h4">03</span></div>
        <div class="service-title">
          <h3 class="text-h1">Fire Protection</h3>
        </div>
        <div class="service-desc">
          <p>
            Detection, alarm, hydrant and suppression systems designed for
            commercial and industrial safety requirements.
          </p>
        </div>
      </div>
      <div class="service-row fade-in stagger-4">
        <div class="service-num"><span class="text-h4">04</span></div>
        <div class="service-title">
          <h3 class="text-h1">Security Systems</h3>
        </div>
        <div class="service-desc">
          <p>
            Integrated CCTV, PA and access control solutions for safer, smarter
            operations.
          </p>
        </div>
      </div>

      <div class="services-cta fade-in stagger-4">
        <a href="/services" class="btn-secondary"
          >Check out our all services &rarr;</a
        >
      </div>
    </div>
  </section>

  <!-- Featured Projects section to be changed later into a CMS bsed upload of projects -->
  <section class="section-projects scroll-reveal">
    <div class="container">
      <div class="section-header fade-in">
        <span class="text-label">Our Success Stories</span>
      </div>

      <div class="grid-12">
        <div class="project-left fade-in stagger-1">
          <h2 class="text-display">WORLD BANK<br />SRI LANKA</h2>
          <p class="text-technical-meta project-meta">
            Medium-voltage cabling • Internal wiring • Earthing
          </p>
          <a href="/projects" class="btn-secondary mt-md"
            >View Case Study &rarr;</a
          >
        </div>
        <div class="project-right">
          <div class="image-reveal-wrapper project-image">
            <Picture
              src={projectImg}
              alt="World Bank Project"
              class="image-reveal-inner"
              formats={["avif", "webp"]}
              quality={75}
              widths={[400, 800, 1200]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-cta scroll-reveal">
    <div class="container fade-in">
      <h2 class="text-display-xl">LET'S BUILD<br />WHAT'S NEXT.</h2>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary"
          ><span>DISCUSS A PROJECT &rarr;</span></a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    color: var(--color-dark-foreground);
    overflow: hidden;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 160px;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.22) 55%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: #111;
    will-change: transform;
  }

  .bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% center;
  }

  .bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.62) 0%,
      rgba(0, 0, 0, 0.46) 27%,
      rgba(0, 0, 0, 0.18) 52%,
      rgba(0, 0, 0, 0) 72%
    );
  }

  .hero-content {
    position: relative;
    z-index: 10;
    padding-bottom: 6vh; /* Raise content slightly */
  }

  .hero-title {
    margin-bottom: var(--space-md);
    --text-display-xl: clamp(3.2rem, 5.2vw, 5.64rem);
  }

  .hero-subtitle {
    max-width: 580px;
    font-size: clamp(1rem, 1.15vw, 1.18rem);
    line-height: 1.6;
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.88);
  }

  /* Credibility Strip */
  .credibility-strip {
    background-color: var(--color-background);
    padding: 100px 0 var(--space-3xl);
  }

  .strip-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .strip-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: var(--space-xl) var(--space-lg);
    border-left: 1px solid var(--color-border);
    position: relative;
  }

  .strip-item:first-child {
    border-left: none;
  }

  .strip-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand);
  }

  .strip-value {
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-foreground);
    letter-spacing: -0.02em;
  }

  .strip-desc {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .credibility-strip {
      padding: 80px 0 var(--space-2xl);
    }
    .strip-grid {
      grid-template-columns: repeat(2, 1fr);
      border-bottom: none;
    }
    .strip-item {
      padding: var(--space-lg) var(--space-md);
      border-bottom: 1px solid var(--color-border);
    }
    .strip-item:nth-child(odd) {
      border-left: none;
    }
    .strip-item:nth-child(even) {
      border-left: 1px solid var(--color-border);
    }
  }

  /* Stats Icons */
  .stats-icon {
    position: absolute;
    right: var(--space-lg);
    top: 50%;
    transform: translateY(-50%);
    width: 80px;
    height: 70px;
    pointer-events: none;
    opacity: 0.22;
  }
  
  @media (max-width: 768px) {
    .stats-icon {
      right: var(--space-md);
      width: 60px;
      height: 55px;
      opacity: 0.15;
    }
  }

  /* Positioning Section */
  .section-positioning {
    padding: var(--space-3xl) 0;
    background-color: var(--color-background);
  }
  .pos-left {
    grid-column: span 7;
  }
  .pos-right {
    grid-column: 9 / -1;
    display: flex;
    align-items: center;
  }

  /* Services Overview */
  .section-services {
    padding: var(--space-3xl) 0;
  }
  .section-header {
    margin-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
  }
  .service-row {
    display: flex;
    align-items: baseline;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.3s;
  }
  .service-row:hover {
    background-color: var(--color-surface);
  }
  .service-num {
    width: 10%;
    color: var(--color-muted);
  }
  .service-title {
    width: 45%;
  }
  .service-desc {
    width: 45%;
    color: var(--color-muted);
  }
  .services-cta {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: flex-end;
  }
  .btn-secondary {
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    border-bottom: 1px solid var(--color-brand);
    padding-bottom: 4px;
    transition: color 0.3s;
  }
  .btn-secondary:hover {
    color: var(--color-brand);
  }

  /* Projects Section */
  .section-projects {
    padding: var(--space-3xl) 0;
    background-color: var(--color-surface);
  }
  .project-left {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .project-meta {
    margin-top: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .project-right {
    grid-column: 7 / -1;
  }
  .project-image {
    aspect-ratio: 4/3;
    width: 100%;
  }

  .mt-md {
    margin-top: var(--space-md);
    align-self: flex-start;
  }

  /* CTA Section */
  .section-cta {
    padding: var(--space-3xl) 0;
    background-color: var(--color-brand);
    color: white;
    text-align: center;
  }
  .cta-actions {
    margin-top: var(--space-2xl);
  }
  .section-cta .btn-primary {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
  .section-cta .btn-primary:hover {
    background-color: var(--color-surface);
  }

  @media (max-width: 1024px) {
    .pos-left,
    .pos-right {
      grid-column: 1 / -1;
    }
    .pos-right {
      margin-top: var(--space-md);
    }
    .service-row {
      flex-direction: column;
      gap: var(--space-sm);
    }
    .service-num,
    .service-title,
    .service-desc {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion || window.innerWidth < 768) return;

    const heroBg = document.querySelector('.hero-bg');
    if (!(heroBg instanceof HTMLElement)) return;

    let ticking = false;
    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrolled = Math.max(0, window.scrollY);
          // Animate only while hero section is in view
          if (scrolled < window.innerHeight * 1.5) {
            const yPos = scrolled * 0.16; // 16% parallax depth
            // Overscale slightly to prevent edges from showing
            heroBg.style.transform = `translate3d(0, ${yPos}px, 0) scale(1.05)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Initialize on load

    // Stats Animation Logic
    const credibilityStrip = document.querySelector('.credibility-strip');
    const svgIcons = document.querySelectorAll('.stats-icon');
    
    if (credibilityStrip && svgIcons.length > 0) {
      if (prefersReducedMotion) {
        svgIcons.forEach(svg => {
          const accent = svg.querySelector('.draw-accent');
          if (accent) accent.style.opacity = '1';
        });
      } else {
        const svgAnimations = [];
        
        svgIcons.forEach(svg => {
          const paths = svg.querySelectorAll('.draw-path');
          const accent = svg.querySelector('.draw-accent');
          
          if (accent) accent.style.opacity = '0';
          
          const pathData = Array.from(paths).map(path => {
            const length = path.getTotalLength();
            path.style.strokeDasharray = length;
            path.style.strokeDashoffset = length;
            path.getBoundingClientRect(); // trigger reflow
            return { el: path, length: length };
          });
          
          svgAnimations.push({ svg, paths: pathData, accent });
        });
        
        const animateIcon = (iconData) => {
          let currentDelay = 0;
          iconData.paths.forEach(p => {
            p.el.style.transition = `stroke-dashoffset 700ms cubic-bezier(0.22, 1, 0.36, 1) ${currentDelay}ms`;
            p.el.style.strokeDashoffset = '0';
            currentDelay += 120; // short internal delay
          });
          
          if (iconData.accent) {
            iconData.accent.style.transition = `opacity 500ms ease ${currentDelay}ms`;
            iconData.accent.style.opacity = '1';
          }
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              obs.unobserve(entry.target);
              svgAnimations.forEach((iconData, index) => {
                setTimeout(() => {
                  animateIcon(iconData);
                }, index * 160); // sequence delay
              });
            }
          });
        }, { threshold: 0.35 });

        observer.observe(credibilityStrip);
      }
    }
  });
</script>
