---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Powernet (Pvt) Ltd — Sri Lanka's trusted one-stop infrastructure partner." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/png" href="/powernet-logo-coloured.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" type="image/png" href="/powernet-logo-coloured.png" />
    <link rel="apple-touch-icon" href="/powernet-logo-coloured.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileImage" content="/powernet-logo-coloured.png" />
    <meta name="theme-color" content="#ee1c25" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <div id="initial-loader" class="loader-overlay">
      <div class="loader-dots">
        <div class="dot dot-1"></div>
        <div class="dot dot-2"></div>
        <div class="dot dot-3"></div>
      </div>
    </div>
    <Header />
    <main id="swup" class="transition-fade">
      <slot />
    </main>
    <Footer />
    
    <script>
      /* loader dismissal */
      const hideLoader = () => {
        const loader = document.getElementById('initial-loader');
        if (loader && !loader.classList.contains('is-hidden')) {
          loader.classList.add('is-hidden');
          
          document.querySelectorAll('.hero-section').forEach(el => el.classList.add('is-revealed'));
          document.querySelectorAll('.header').forEach(el => el.classList.add('is-revealed'));
        }
      };

      const initBaseLayout = () => {
        /* hero image load check */
        const heroImg = document.querySelector('.bg-img') as HTMLImageElement | null;
        if (heroImg && !heroImg.complete) {
          heroImg.addEventListener('load', hideLoader, { once: true });
          setTimeout(hideLoader, 600);
        } else {
          hideLoader();
        }

        /* ─── Viewport-batched scroll-reveal observer ──────────────────────
           Elements that intersect within the same rAF tick share an
           animation "breath" — staggered by 55ms per DOM order.
           This matches Duten's data-lg-reveal batching.
        ──────────────────────────────────────────────────────────────────── */
        const STAGGER_MS = 55;
        let pendingBatch: Element[] = [];
        let batchRAF: number | null = null;

        const flushBatch = () => {
          // Sort by DOM order (closest to viewport top first)
          pendingBatch.sort((a, b) => {
            const aTop = a.getBoundingClientRect().top;
            const bTop = b.getBoundingClientRect().top;
            return aTop - bTop;
          });

          pendingBatch.forEach((el, i) => {
            const delay = i * STAGGER_MS;
            (el as HTMLElement).style.setProperty('--stagger-delay', `${delay}ms`);
            // double-rAF so the CSS variable is applied before class triggers transition
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                el.classList.add('is-revealed');
                el.classList.add('is-visible');
              });
            });
          });

          pendingBatch = [];
          batchRAF = null;
        };

        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -12% 0px',
          threshold: 0.1
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              obs.unobserve(entry.target);
              pendingBatch.push(entry.target);
              if (!batchRAF) {
                batchRAF = requestAnimationFrame(flushBatch);
              }
            }
          });
        }, observerOptions);

        document.querySelectorAll('.scroll-reveal:not(.is-revealed)').forEach(el => {
          // Instantly reveal only if well within the primary viewport on initial mount
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.75 && rect.bottom > 0) {
            el.classList.add('is-revealed');
            el.classList.add('is-visible');
          } else {
            observer.observe(el);
          }
        });
      };

      document.addEventListener('DOMContentLoaded', initBaseLayout);
      document.addEventListener('astro:page-load', initBaseLayout);

      if (document.readyState === 'interactive' || document.readyState === 'complete') {
        initBaseLayout();
      }
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    overflow-x: clip;
  }

  /* section anchor offsets */
  #services,
  #projects,
  #about,
  #contact {
    scroll-margin-top: 100px;
  }

  /* swup transition fallback */
  .transition-fade {
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 1;
  }
  html.is-animating .transition-fade {
    opacity: 0;
  }

  /* View Transitions API (ClientRouter) — fluid cross-dissolve */
  ::view-transition-old(root) {
    animation: 180ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
  }
  ::view-transition-new(root) {
    animation: 240ms cubic-bezier(0, 0, 0.2, 1) both vt-fade-in;
  }

  @keyframes vt-fade-out {
    from { opacity: 1; transform: scale(1); }
    to { opacity: 0; transform: scale(0.995); }
  }
  @keyframes vt-fade-in {
    from { opacity: 0; transform: scale(1.005); }
    to { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none !important;
    }
  }

  /* root header stacking */
  header#main-header,
  header.header,
  .site-header {
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 9999 !important;
  }

  main#swup {
    position: relative;
    z-index: 1;
  }

  /* initial loader */
  .loader-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background-color: #050505;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .loader-overlay.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  .loader-dots {
    display: flex;
    gap: 8px;
  }

  .dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-brand);
    border-radius: 50%;
    animation: pulse-dot 1s cubic-bezier(0.76, 0, 0.24, 1) infinite;
  }

  .dot-1 { animation-delay: 0s; }
  .dot-2 { animation-delay: 0.15s; }
  .dot-3 { animation-delay: 0.3s; }

  @keyframes pulse-dot {
    0%, 100% { transform: scale(0.4); opacity: 0.3; }
    50% { transform: scale(1); opacity: 1; }
  }
</style>
