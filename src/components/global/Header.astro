---
import { Image } from 'astro:assets';
import logoImg from '../../assets/images/icons/Just the logo colored.jpg';

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === '/' || pathname === '/index.html';
---

<header class={`header ${isHome ? 'header-transparent-dark' : ''}`}>
  <div class="container header-container">
    <div class="logo fade-in stagger-1">
      <a href="/" class="logo-link">
        <Image src={logoImg} alt="Powernet Logo" class="logo-img" />
      </a>
    </div>
    
    <nav class="desktop-nav fade-in stagger-2">
      <ul class="nav-list">
        <li><a href="/services" class="nav-link">Services</a></li>
        <li><a href="/projects" class="nav-link">Projects</a></li>
        <li><a href="/about" class="nav-link">About</a></li>
        <li><a href="/contact" class="nav-link">Contact</a></li>
      </ul>
    </nav>

    <div class="header-actions fade-in stagger-3">
      <a href="/contact" class="btn-primary">START A PROJECT <span class="cta-arrow">&#8599;</span></a>
    </div>
  </div>
</header>

<style>
  .header {
    position: absolute; /* Blends with background as requested */
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: var(--space-md) 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-link {
    display: flex;
    align-items: center;
    width: clamp(180px, 15vw, 230px);
  }

  .logo-img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Removed logo inversion to keep full color */

  .header-transparent-dark .nav-link {
    color: var(--color-dark-foreground);
  }

  .nav-list {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-mono); /* Engineered personality */
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    text-decoration: none;
    display: inline-block;
    padding: 0.5rem 0;
    position: relative;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-brand);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .nav-link:hover {
    opacity: 1;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-transparent-dark .nav-link {
    color: var(--color-dark-foreground);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border: 1px solid var(--color-brand);
    color: #fff;
    padding: 0.5rem 1.25rem;
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    transition: background-color 0.3s ease, transform 0.3s ease;
    will-change: transform;
  }

  .cta-arrow {
    margin-left: 0.5rem;
    font-size: 1.1em;
  }

  .btn-primary:hover {
    background-color: var(--color-brand);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .desktop-nav {
      display: none; /* We'll need a mobile menu later */
    }
  }
</style>
