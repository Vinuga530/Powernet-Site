---
import { Image } from "astro:assets";
import logoImg from "../../assets/images/icons/powernet-logo.png";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/" || pathname === "/index.html";
const navItems = [
  { href: "/#services", label: "Services" },
  { href: "/#projects", label: "Projects" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---

<header
  id="main-header"
  class={`header ${isHome ? "header-transparent-dark" : ""}`}
>
  <div class="container header-container">
    <div class="logo">
      <a href="/" class="logo-link">
        <Image
          src={logoImg}
          alt="Powernet Logo"
          class="logo-img"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <div class="original-nav-container">
      <nav class="desktop-nav">
        <ul class="nav-list">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="nav-link" aria-label={item.label}>
                  <span class="nav-word" aria-hidden="true">
                    <span class="nav-layer nav-layer-top">
                      {Array.from(item.label).map((letter, index) => (
                        <span class="nav-char" style={`--i:${index}; --char-index:${index}`}>
                          {letter}
                        </span>
                      ))}
                    </span>
                    <span class="nav-layer nav-layer-bottom" aria-hidden="true">
                      {Array.from(item.label).map((letter, index) => (
                        <span class="nav-char" style={`--i:${index}; --char-index:${index}`}>
                          {letter}
                        </span>
                      ))}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        id="mobile-menu-toggle"
        class="mobile-menu-btn hamburger"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <div class="header-actions">
        <a href="/#contact" class="btn-primary" aria-label="Let's Talk">
          <span class="cta-accent" aria-hidden="true"></span>
          <span class="btn-roll-wrapper" aria-hidden="true">
            {
              Array.from("LET'S TALK").map((letter, index) => (
                <span class="char-wrap" style={`--char-index:${index}`}>
                  <span class="char-main">{letter === " " ? "\u00A0" : letter}</span>
                  <span class="char-clone" aria-hidden="true">{letter === " " ? "\u00A0" : letter}</span>
                </span>
              ))
            }
          </span>
        </a>
      </div>
    </div>
  </div>

  <!-- mobile drawer container -->
  <div id="mobile-nav-overlay" class="mobile-nav nav-links-wrapper" aria-hidden="true">
    <div class="mobile-nav-content">
      <ul class="mobile-nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="mobile-nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-nav-actions">
        <a href="/#contact" class="btn-primary mobile-cta" aria-label="Let's Talk">
          <span class="btn-roll-wrapper" aria-hidden="true">
            {
              Array.from("LET'S TALK").map((letter, index) => (
                <span class="char-wrap" style={`--char-index:${index}`}>
                  <span class="char-main">{letter === " " ? "\u00A0" : letter}</span>
                  <span class="char-clone" aria-hidden="true">{letter === " " ? "\u00A0" : letter}</span>
                </span>
              ))
            }
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* root header stacking */
  header, 
  .site-header,
  .header,
  #main-header {
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 9999 !important;
    padding-top: 0;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transform: translateY(0);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.3s ease,
      border-color 0.3s ease,
      backdrop-filter 0.3s ease,
      -webkit-backdrop-filter 0.3s ease;
    pointer-events: none;
  }

  /* directional scroll states */
  #main-header.is-hidden {
    transform: translateY(-100%);
  }

  #main-header.is-scrolled {
    transform: translateY(0);
    background-color: rgba(13, 14, 18, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  #main-header.is-top {
    transform: translateY(0);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header-container {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 95%;
    max-width: 1400px;
    margin: 0 auto;
    min-height: 80px;
    pointer-events: none;
    position: relative;
    transition: min-height 0.3s ease;
  }

  .original-nav-container {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
    margin-top: 20px;
    margin-bottom: 20px;
    pointer-events: auto;
    transition: margin 0.3s ease;
  }

  #main-header.is-scrolled .original-nav-container {
    margin-top: 12px;
    margin-bottom: 12px;
  }

  /* logo anchor */
  .logo {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 50;
    pointer-events: auto;
  }

  .logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 16px 36px 24px 24px;
    background: rgba(255, 255, 255, 0.98);
    border-radius: 0 0 42px 0;
    text-decoration: none;
    box-shadow: 4px 8px 24px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: transform 0.3s ease, padding 0.3s ease, border-radius 0.3s ease;
  }

  #main-header.is-scrolled .logo-link {
    padding: 12px 28px 18px 20px;
    border-radius: 0 0 28px 0;
  }

  .logo-img {
    display: block;
    width: 150px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* desktop navigation */
  .desktop-nav {
    background: rgba(20, 20, 20, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 50px;
    padding: 12px 32px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    margin: 0;
  }

  .nav-list {
    display: flex;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: gap 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
    text-decoration: none;
    display: inline-block;
    height: 1.2em;
    overflow: hidden;
    opacity: 0.9;
    transition:
      color 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      text-shadow 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
  }

  .nav-layer {
    display: flex;
    white-space: nowrap;
  }

  .nav-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }

  .nav-char {
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--char-index, var(--i)) * 20ms);
  }

  .nav-link:hover .nav-layer-top .nav-char,
  .nav-link:hover .nav-layer-bottom .nav-char {
    transform: translateY(-100%);
  }

  .nav-link:hover {
    opacity: 1;
    color: var(--color-brand, #e63946);
  }

  /* primary action button */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand, #d62828);
    border: 1px solid var(--color-brand, #d62828);
    color: #fff;
    padding: 12px 28px 12px 22px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 50px;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    gap: 12px;
    box-shadow: none;
  }

  .btn-primary:hover {
    background-color: #b01e1e;
    border-color: #b01e1e;
    transform: translateY(-2px);
  }

  .cta-accent {
    display: block;
    width: 12px;
    height: 2px;
    background: #fff;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    flex-shrink: 0;
  }

  .btn-primary:hover .cta-accent {
    width: 24px;
  }

  .btn-primary:hover .char-main,
  .btn-primary:hover .char-clone {
    transform: translateY(-100%);
  }

  /* mobile menu toggle */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    cursor: pointer;
    padding: 12px 16px;
    z-index: 10000;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hamburger-line {
    width: 20px;
    height: 2px;
    background-color: #ffffff;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .mobile-menu-btn.is-active {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .mobile-menu-btn.is-active .hamburger-line {
    background-color: #ffffff;
  }

  .mobile-menu-btn.is-active .hamburger-line:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .mobile-menu-btn.is-active .hamburger-line:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* responsive queries */
  @media (min-width: 1025px) {
    .mobile-nav,
    .nav-links-wrapper {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    #main-header {
      top: 0;
    }

    .header-container {
      min-height: 70px;
    }

    .logo-link {
      padding: 12px 20px 16px 20px;
      border-radius: 0 0 24px 24px;
    }

    .logo-img {
      width: 120px;
    }

    .desktop-nav,
    .header-actions {
      display: none;
    }

    .original-nav-container {
      margin-top: 14px;
      margin-bottom: 14px;
    }

    /* explicit mobile menu toggle */
    .mobile-menu-btn,
    .hamburger, 
    #mobile-menu-toggle {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
      position: relative;
      z-index: 10000 !important; 
      pointer-events: auto !important;
      cursor: pointer;
    }

    /* mobile drawer */
    .mobile-nav,
    .nav-links-wrapper {
      position: fixed;
      top: 76px;
      left: 16px;
      right: 16px;
      width: auto;
      padding: 28px 24px;
      background: rgba(13, 14, 18, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      gap: 16px;
      transform: translateY(-16px) scale(0.98);
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.3s ease,
        visibility 0.3s ease;
      z-index: 9998;
    }

    .mobile-nav.is-active,
    .nav-links-wrapper.is-active {
      transform: translateY(0) scale(1);
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }

    .mobile-nav-content {
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
    }

    .mobile-nav-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .mobile-nav-link {
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: #ffffff !important;
      text-decoration: none;
      padding: 14px 4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      transition: color 0.2s ease;
      display: block;
      text-transform: uppercase;
    }

    .mobile-nav-link:hover {
      color: var(--color-brand, #d62828) !important;
    }

    .mobile-nav-actions {
      width: 100%;
      margin-top: 8px;
    }

    .mobile-cta {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      box-sizing: border-box;
      padding: 14px 20px;
      border-radius: 9999px;
      background-color: var(--color-brand, #d62828);
      color: #ffffff;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.85rem;
      border: none;
    }
  }

  @media (max-width: 768px) {
    .header-container {
      min-height: 64px;
    }

    .original-nav-container {
      margin-top: 10px;
      margin-bottom: 10px;
    }

    .mobile-nav,
    .nav-links-wrapper {
      top: 68px;
      padding: 24px 18px;
    }
  }
</style>

<script>
  /* directional scroll and drawer lifecycle */
  let headerScrollHandler: (() => void) | null = null;
  let headerClickHandler: ((e: MouseEvent) => void) | null = null;

  const initHeader = () => {
    const header = document.getElementById("main-header");
    const menuBtn = document.getElementById("mobile-menu-toggle");
    const mobileNav = document.getElementById("mobile-nav-overlay");

    if (!header) return;

    if (headerScrollHandler) {
      window.removeEventListener("scroll", headerScrollHandler);
      headerScrollHandler = null;
    }
    if (headerClickHandler) {
      document.removeEventListener("click", headerClickHandler);
      headerClickHandler = null;
    }

    let lastScrollY = window.scrollY;
    let ticking = false;
    let isMenuOpen = false;

    const updateHeaderState = () => {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;

      /* drawer open lock */
      if (isMenuOpen) {
        lastScrollY = currentScrollY;
        ticking = false;
        return;
      }

      if (currentScrollY < 20) {
        /* page top */
        header.classList.remove("is-hidden");
        header.classList.remove("is-scrolled");
        header.classList.add("is-top");
      } else {
        header.classList.remove("is-top");
        if (delta > 0 && currentScrollY > 80) {
          /* scroll down past 80px */
          header.classList.add("is-hidden");
          header.classList.remove("is-scrolled");
        } else if (delta < 0) {
          /* scroll up */
          header.classList.remove("is-hidden");
          header.classList.add("is-scrolled");
        }
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    /* initial state on load */
    if (window.scrollY < 20) {
      header.classList.add("is-top");
      header.classList.remove("is-scrolled", "is-hidden");
    } else {
      header.classList.add("is-scrolled");
      header.classList.remove("is-top", "is-hidden");
    }

    headerScrollHandler = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeaderState);
        ticking = true;
      }
    };

    window.addEventListener("scroll", headerScrollHandler, { passive: true });

    /* mobile drawer toggle */
    if (menuBtn && mobileNav) {
      const toggleMenu = (open?: boolean) => {
        const willOpen = typeof open === "boolean" ? open : !isMenuOpen;
        isMenuOpen = willOpen;
        menuBtn.setAttribute("aria-expanded", String(willOpen));
        menuBtn.classList.toggle("is-active", willOpen);
        mobileNav.classList.toggle("is-active", willOpen);
        mobileNav.setAttribute("aria-hidden", String(!willOpen));
        if (willOpen) {
          header.classList.remove("is-hidden");
          header.classList.add("is-scrolled");
        }
      };

      menuBtn.onclick = (e) => {
        e.stopPropagation();
        toggleMenu();
      };

      mobileNav.querySelectorAll("a").forEach((link) => {
        link.onclick = () => {
          toggleMenu(false);
        };
      });

      /* backdrop click close */
      headerClickHandler = (e: MouseEvent) => {
        if (isMenuOpen && !mobileNav.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
          toggleMenu(false);
        }
      };
      document.addEventListener("click", headerClickHandler);
    }
  };

  document.addEventListener("DOMContentLoaded", initHeader);
  document.addEventListener("astro:page-load", initHeader);

  if (document.readyState === "interactive" || document.readyState === "complete") {
    initHeader();
  }
</script>
