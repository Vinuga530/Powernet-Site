---
import { Image } from "astro:assets";
import logoImg from "../../assets/images/icons/powernet-logo.png";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/" || pathname === "/index.html";
const navItems = [
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header id="main-header" class={`header ${isHome ? "header-transparent-dark" : ""}`}>
  <div class="container header-container">
    <div class="logo fade-in stagger-1">
      <a href="/" class="logo-link">
        <Image
          src={logoImg}
          alt="Powernet Logo"
          class="logo-img"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <div class="original-nav-container fade-in stagger-2">
      <nav class="desktop-nav">
        <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                <span class="nav-word">
                  <span class="nav-layer nav-layer-top">
                    {Array.from(item.label).map((letter, index) => (
                      <span class="nav-char" style={`--i:${index}`}>
                        {letter}
                      </span>
                    ))}
                  </span>
                  <span class="nav-layer nav-layer-bottom" aria-hidden="true">
                    {Array.from(item.label).map((letter, index) => (
                      <span class="nav-char" style={`--i:${index}`}>
                        {letter}
                      </span>
                    ))}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
        </ul>
      </nav>
      <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <div class="header-actions">
        <a href="/contact" class="btn-primary">
          <span class="cta-accent" aria-hidden="true"></span>
          <span class="cta-word">
            <span class="cta-layer cta-layer-top">
              {Array.from("LET'S TALK").map((letter, index) => (
                <span class="cta-char" style={`--i:${index}`}>
                  {letter === " " ? "\u00A0" : letter}
                </span>
              ))}
            </span>
            <span class="cta-layer cta-layer-bottom" aria-hidden="true">
              {Array.from("LET'S TALK").map((letter, index) => (
                <span class="cta-char" style={`--i:${index}`}>
                  {letter === " " ? "\u00A0" : letter}
                </span>
              ))}
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

<div id="floating-nav" class="floating-nav" aria-hidden="true">
  <div class="floating-nav-inner">
    <nav class="desktop-nav">
      <ul class="nav-list">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="nav-link">
              <span class="nav-word">
                <span class="nav-layer nav-layer-top">
                  {Array.from(item.label).map((letter, index) => (
                    <span class="nav-char" style={`--i:${index}`}>
                      {letter}
                    </span>
                  ))}
                </span>
                <span class="nav-layer nav-layer-bottom" aria-hidden="true">
                  {Array.from(item.label).map((letter, index) => (
                    <span class="nav-char" style={`--i:${index}`}>
                      {letter}
                    </span>
                  ))}
                </span>
              </span>
            </a>
          </li>
        ))
      }
      </ul>
    </nav>
    <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    <div class="header-actions">
      <a href="/contact" class="btn-primary">
        <span class="cta-accent" aria-hidden="true"></span>
        <span class="cta-word">
          <span class="cta-layer cta-layer-top">
            {Array.from("LET'S TALK").map((letter, index) => (
              <span class="cta-char" style={`--i:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
          <span class="cta-layer cta-layer-bottom" aria-hidden="true">
            {Array.from("LET'S TALK").map((letter, index) => (
              <span class="cta-char" style={`--i:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
        </span>
      </a>
    </div>
  </div>
</div>

<style>
  .header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding-top: 0;
    background-color: transparent;
    pointer-events: none;
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    gap: 24px;
    pointer-events: none;
  }

  .original-nav-container {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 48px;
    padding-top: 16px;
    flex-grow: 1;
    pointer-events: auto;
  }

  /* ========================================
     POWERNET LEFT EDGE LOGO
     ======================================== */

  .logo {
    position: absolute;
    top: 0;
    left: 0;
    width: 330px;
    height: 82px;
    z-index: 50;
    overflow: visible;
    isolation: isolate;
    pointer-events: auto;
  }

  /* SOLID WHITE LOGO AREA */
  .logo-link {
    position: relative;
    width: 275px;
    height: 82px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 0 24px;
    background: #ffffff;
    text-decoration: none;
    overflow: visible;
    z-index: 2;
  }

  /* LOGO */
  .logo-img {
    display: block;
    width: 175px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    transform: translateX(4px);
    position: relative;
    z-index: 3;
  }

  /* ========================================
     SOFT ANGLED TRANSITION INTO HERO
     ======================================== */
  .logo-link::after {
    content: "";
    position: absolute;
    top: 0;
    left: calc(100% - 1px);
    width: 72px;
    height: 100%;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 0.98) 18%,
      rgba(255, 255, 255, 0.86) 38%,
      rgba(255, 255, 255, 0.60) 58%,
      rgba(255, 255, 255, 0.30) 76%,
      rgba(255, 255, 255, 0.08) 90%,
      rgba(255, 255, 255, 0) 100%
    );
    clip-path: polygon(
      0 0,
      100% 0,
      82% 72%,
      42% 100%,
      0 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      #000 0%,
      #000 48%,
      rgba(0, 0, 0, 0.85) 65%,
      rgba(0, 0, 0, 0.45) 82%,
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      #000 0%,
      #000 48%,
      rgba(0, 0, 0, 0.85) 65%,
      rgba(0, 0, 0, 0.45) 82%,
      transparent 100%
    );
    z-index: 1;
  }

  /* ========================================
     VERY SUBTLE DEPTH
     ======================================== */
  .logo-link::before {
    content: "";
    position: absolute;
    left: 18px;
    right: -28px;
    bottom: -5px;
    height: 12px;
    background: rgba(0, 0, 0, 0.10);
    filter: blur(11px);
    opacity: 0.22;
    pointer-events: none;
    z-index: -1;
  }

  .desktop-nav {
    margin: 0;
  }

  .floating-nav {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translate(-50%, -120%);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), 
                opacity 0.3s ease,
                visibility 0.3s;
    width: max-content;
    max-width: calc(100vw - 32px);
    pointer-events: none;
  }

  .floating-nav.visible {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .floating-nav-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 20px; /* Restrained curve */
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.8);
    padding: 0 12px 0 28px;
    height: 56px;
    gap: 32px;
  }
  
  .floating-nav-inner .btn-primary {
    border-radius: 28px;
    padding: 10px 16px;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
    text-decoration: none;
    display: inline-block;
    height: 1.2em;
    overflow: hidden;
    opacity: 0.9;
    transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1), text-shadow 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .floating-nav .nav-link {
    color: #1a1a1a;
    text-shadow: none;
  }

  .nav-list {
    display: flex;
    gap: 48px;
    list-style: none;
    transition: gap 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .floating-nav .nav-list {
    gap: 32px;
  }

  .nav-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
  }

  .nav-layer {
    display: flex;
    white-space: nowrap;
  }

  .nav-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }

  .nav-char {
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 35ms);
  }

  .nav-link:hover .nav-layer-top .nav-char {
    transform: translateY(-100%);
  }

  .nav-link:hover .nav-layer-bottom .nav-char {
    transform: translateY(-100%);
  }

  .nav-link:hover {
    opacity: 1;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand);
    border: 1px solid var(--color-brand);
    color: #fff;
    padding: 12px 20px;
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    transition: transform 0.3s ease, border-radius 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s !important;
    gap: 12px;
  }

  .btn-primary:hover {
    background-color: var(--color-brand);
  }

  .cta-accent {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                border-radius 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-primary:hover .cta-accent {
    width: 28px;
    border-radius: 2px;
  }

  .cta-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
  }

  .cta-layer {
    display: flex;
    white-space: nowrap;
  }

  .cta-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }

  .cta-char {
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 25ms);
  }

  .btn-primary:hover .cta-layer-top .cta-char {
    transform: translateY(-100%);
  }

  .btn-primary:hover .cta-layer-bottom .cta-char {
    transform: translateY(-100%);
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 101;
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background-color: #1a1a1a;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  @media (max-width: 1024px) {
    .header-container {
      padding: 0 16px;
    }
    
    .logo {
      width: 280px;
      height: 72px;
    }

    .logo-link {
      width: 230px;
      height: 72px;
      padding: 0 20px;
    }

    .logo-img {
      width: 150px;
      transform: translateX(0); /* Reset transform for smaller width if needed, or keep provided CSS */
    }

    .logo-link::after {
      width: 58px;
      clip-path: polygon(
        0 0,
        100% 0,
        82% 72%,
        42% 100%,
        0 100%
      );
    }

    .original-nav-container {
      padding-top: 24px;
      gap: 24px;
    }

    .desktop-nav,
    .header-actions {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
    
    .floating-nav {
      top: 16px;
    }
    
    .floating-nav-inner {
      padding: 0 24px;
      justify-content: center;
    }
    
    .floating-nav-inner .desktop-nav,
    .floating-nav-inner .header-actions {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Mobile menu toggle
    const btns = document.querySelectorAll(".mobile-menu-btn");
    btns.forEach(btn => {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btns.forEach(b => b.setAttribute("aria-expanded", !expanded));
      });
    });

    // Direction-aware floating nav logic
    const floatingNav = document.getElementById("floating-nav");
    if (!floatingNav) return;

    let lastScrollY = window.scrollY;
    let ticking = false;
    
    // Thresholds
    const TOP_THRESHOLD = 150; 
    const SCROLL_DELTA_THRESHOLD = 20; 
    
    let scrollAnchor = window.scrollY;
    let lastDirection = 0; // 1 for down, -1 for up

    const updateNav = () => {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;
      
      const currentDirection = delta === 0 ? 0 : Math.sign(delta);
      
      if (currentDirection !== 0 && currentDirection !== lastDirection) {
        scrollAnchor = currentScrollY;
        lastDirection = currentDirection;
      }
      
      const distanceFromAnchor = Math.abs(currentScrollY - scrollAnchor);

      if (currentScrollY <= TOP_THRESHOLD) {
        floatingNav.classList.remove("visible");
      } 
      else if (currentDirection === -1 && distanceFromAnchor >= SCROLL_DELTA_THRESHOLD) {
        floatingNav.classList.add("visible");
      } 
      else if (currentDirection === 1 && distanceFromAnchor >= SCROLL_DELTA_THRESHOLD) {
        floatingNav.classList.remove("visible");
      }
      
      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(updateNav);
        ticking = true;
      }
    }, { passive: true });
  });
</script>
