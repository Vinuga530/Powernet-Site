---
import { Image } from "astro:assets";
import logoImg from "../../assets/images/icons/powernet-logo.png";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/" || pathname === "/index.html";
const navItems = [
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header id="main-header" class={`header ${isHome ? "header-transparent-dark" : ""}`}>
  <div class="container header-container">
    <div class="logo-island fade-in stagger-1">
      <a href="/" class="logo-link">
        <Image
          src={logoImg}
          alt="Powernet Logo"
          class="logo-img"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <div class="nav-pill fade-in stagger-2">
      <nav class="desktop-nav">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                <span class="nav-word">
                  <span class="nav-layer nav-layer-top">
                    {Array.from(item.label).map((letter, index) => (
                      <span class="nav-char" style={`--i:${index}`}>
                        {letter}
                      </span>
                    ))}
                  </span>

                  <span class="nav-layer nav-layer-bottom" aria-hidden="true">
                    {Array.from(item.label).map((letter, index) => (
                      <span class="nav-char" style={`--i:${index}`}>
                        {letter}
                      </span>
                    ))}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      class="mobile-menu-btn"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <div class="header-actions">
      <a href="/contact" class="btn-primary">
        <span class="cta-accent" aria-hidden="true"></span>
        <span class="cta-word">
          <span class="cta-layer cta-layer-top">
            {Array.from("LET'S TALK").map((letter, index) => (
              <span class="cta-char" style={`--i:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
          <span class="cta-layer cta-layer-bottom" aria-hidden="true">
            {Array.from("LET'S TALK").map((letter, index) => (
              <span class="cta-char" style={`--i:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
        </span>
      </a>
    </div>
    </div>
  </div>
</header>

<style>
  :root {
    --logo-island-expanded-width: 200px;
    --logo-island-expanded-height: 78px;
    --logo-island-collapsed-width: 160px;
    --logo-island-collapsed-height: 58px;
    --logo-island-expanded-radius: 25px;
    --logo-island-collapsed-radius: 20px;
    --header-component-gap: 24px;
    --logo-transition-duration: 620ms;
    --logo-transition-easing: cubic-bezier(.16, 1, .3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      --logo-transition-duration: 0.01s;
    }
  }

  .header {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 100%;
    z-index: 100;
    padding: 24px 0;
    background-color: transparent;
    pointer-events: none; /* Let clicks pass through transparent gap */
    transition: padding var(--logo-transition-duration) var(--logo-transition-easing);
  }

  .header.scrolled {
    padding: 16px 0;
  }

  .header-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    gap: var(--header-component-gap);
    pointer-events: auto; /* Re-enable pointer events for the items */
  }

  .logo-island {
    background-color: rgba(255, 255, 255, 0.97);
    border-radius: var(--logo-island-expanded-radius);
    width: var(--logo-island-expanded-width);
    height: var(--logo-island-expanded-height);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    flex-shrink: 0;
    box-shadow: 0 10px 35px rgba(0,0,0,0.06);
    border: 1px solid rgba(0, 0, 0, 0.04);
    
    transition: 
      width var(--logo-transition-duration) var(--logo-transition-easing),
      height var(--logo-transition-duration) var(--logo-transition-easing),
      border-radius var(--logo-transition-duration) var(--logo-transition-easing);
  }

  .header.scrolled .logo-island {
    width: var(--logo-island-collapsed-width);
    height: var(--logo-island-collapsed-height);
    border-radius: var(--logo-island-collapsed-radius);
  }

  .logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    background-color: rgba(15, 15, 15, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 100px;
    height: 60px;
    padding: 0 12px 0 32px;
    flex-grow: 1;
    box-shadow: 0 10px 35px rgba(0,0,0,0.1);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .desktop-nav {
    margin: 0 auto; /* Keep centered in available space */
  }

  /* Removed logo inversion to keep full color */

  .header-transparent-dark .nav-link {
    color: var(--color-dark-foreground);
  }

  .nav-list {
    display: flex;
    gap: 48px;
    list-style: none;
    transition: gap 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header.scrolled .nav-list {
    gap: 32px;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-foreground);
    text-decoration: none;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);

    display: inline-block;
    height: 1.2em;
    overflow: hidden;

    opacity: 0.9;
    transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1), text-shadow 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header.scrolled .nav-link,
  .header.header-transparent-dark.scrolled .nav-link {
    /* Intentionally blank to preserve dark nav text styling */
  }

  .nav-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
  }

  .nav-layer {
    display: flex;
    white-space: nowrap;
  }

  .nav-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }

  .nav-char {
    display: inline-block;

    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);

    transition-delay: calc(var(--i) * 35ms);
  }

  /* Original letters leave upward */
  .nav-link:hover .nav-layer-top .nav-char {
    transform: translateY(-100%);
  }

  /* New letters enter from below */
  .nav-link:hover .nav-layer-bottom .nav-char {
    transform: translateY(-100%);
  }

  .nav-link:hover {
    opacity: 1;
  }
  .header-transparent-dark .nav-link {
    color: var(--color-dark-foreground);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand);
    border: 1px solid var(--color-brand);
    color: #fff;
    padding: 12px 20px;
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    transition: transform 0.3s ease, border-radius 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s !important;
    gap: 12px;
  }

  .header.scrolled .btn-primary {
    border-radius: 12px;
  }

  .btn-primary:hover {
    background-color: var(--color-brand);
  }

  .cta-accent {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                border-radius 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-primary:hover .cta-accent {
    width: 28px;
    border-radius: 2px;
  }

  .cta-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
  }

  .cta-layer {
    display: flex;
    white-space: nowrap;
  }

  .cta-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }

  .cta-char {
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 25ms);
  }

  /* Original letters leave upward */
  .btn-primary:hover .cta-layer-top .cta-char {
    transform: translateY(-100%);
  }

  /* New letters enter from below */
  .btn-primary:hover .cta-layer-bottom .cta-char {
    transform: translateY(-100%);
  }

  /* Mobile Menu Styles */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 101;
    justify-self: end;
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background-color: var(--color-foreground);
    transition:
      transform 0.3s ease,
      opacity 0.3s ease,
      background-color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header-transparent-dark .hamburger-line {
    background-color: var(--color-dark-foreground);
  }

  .header.scrolled .hamburger-line,
  .header.header-transparent-dark.scrolled .hamburger-line {
    /* Preserved white hamburger lines */
  }

  @media (max-width: 1024px) {
    .header-container {
      padding: 0 16px;
    }

    .desktop-nav,
    .header-actions {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .logo-island {
      width: 160px;
      height: 60px;
      padding: 0 16px;
      border-radius: 20px;
    }

    .nav-pill {
      flex-grow: 0;
      padding: 0 16px;
      height: 60px;
      border-radius: 20px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.querySelector(".mobile-menu-btn");
    if (btn) {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true" || false;
        btn.setAttribute("aria-expanded", !expanded);
        // Minimal toggle logic for future mobile menu
        // Right now we just toggle the button state
      });
    }

    const header = document.getElementById("main-header");
    if (header) {
      const handleScroll = () => {
        if (window.scrollY > 80) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      };
      
      window.addEventListener("scroll", handleScroll, { passive: true });
      handleScroll(); // Check initial scroll position
    }
  });
</script>
