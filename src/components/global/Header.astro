---
import { Image } from "astro:assets";
import logoImg from "../../assets/images/icons/powernet-logo.png";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/" || pathname === "/index.html";
const navItems = [
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header
  id="main-header"
  class={`header ${isHome ? "header-transparent-dark" : ""}`}
>
  <div class="container header-container">
    <div class="logo fade-in stagger-1">
      <a href="/" class="logo-link">
        <Image
          src={logoImg}
          alt="Powernet Logo"
          class="logo-img"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <div class="original-nav-container fade-in stagger-2">
      <nav class="desktop-nav">
        <ul class="nav-list">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="nav-link">
                  <span class="nav-word">
                    <span class="nav-layer nav-layer-top">
                      {Array.from(item.label).map((letter, index) => (
                        <span class="nav-char" style={`--i:${index}`}>
                          {letter}
                        </span>
                      ))}
                    </span>
                    <span class="nav-layer nav-layer-bottom" aria-hidden="true">
                      {Array.from(item.label).map((letter, index) => (
                        <span class="nav-char" style={`--i:${index}`}>
                          {letter}
                        </span>
                      ))}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        class="mobile-menu-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <div class="header-actions">
        <a href="/contact" class="btn-primary">
          <span class="cta-accent" aria-hidden="true"></span>
          <span class="cta-word">
            <span class="cta-layer cta-layer-top">
              {
                Array.from("LET'S TALK").map((letter, index) => (
                  <span class="cta-char" style={`--i:${index}`}>
                    {letter === " " ? "\u00A0" : letter}
                  </span>
                ))
              }
            </span>
            <span class="cta-layer cta-layer-bottom" aria-hidden="true">
              {
                Array.from("LET'S TALK").map((letter, index) => (
                  <span class="cta-char" style={`--i:${index}`}>
                    {letter === " " ? "\u00A0" : letter}
                  </span>
                ))
              }
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

<div id="floating-nav" class="floating-nav" aria-hidden="true">
  <div class="floating-nav-inner">
    <nav class="desktop-nav">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                <span class="nav-word">
                  <span class="nav-layer nav-layer-top">
                    {Array.from(item.label).map((letter, index) => (
                      <span class="nav-char" style={`--i:${index}`}>
                        {letter}
                      </span>
                    ))}
                  </span>
                  <span class="nav-layer nav-layer-bottom" aria-hidden="true">
                    {Array.from(item.label).map((letter, index) => (
                      <span class="nav-char" style={`--i:${index}`}>
                        {letter}
                      </span>
                    ))}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      class="mobile-menu-btn"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    <div class="header-actions">
      <a href="/contact" class="btn-primary">
        <span class="cta-accent" aria-hidden="true"></span>
        <span class="cta-word">
          <span class="cta-layer cta-layer-top">
            {
              Array.from("LET'S TALK").map((letter, index) => (
                <span class="cta-char" style={`--i:${index}`}>
                  {letter === " " ? "\u00A0" : letter}
                </span>
              ))
            }
          </span>
          <span class="cta-layer cta-layer-bottom" aria-hidden="true">
            {
              Array.from("LET'S TALK").map((letter, index) => (
                <span class="cta-char" style={`--i:${index}`}>
                  {letter === " " ? "\u00A0" : letter}
                </span>
              ))
            }
          </span>
        </span>
      </a>
    </div>
  </div>
</div>

<style>
  /* ========================================
     MAIN HEADER LAYOUT
     ======================================== */
  .header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding-top: 0;
    background-color: transparent;
    pointer-events: none;
  }

  .header-container {
    display: flex;
    justify-content: space-between; /* Pushes Logo left, Nav/CTA right */
    align-items: center;
    width: 95%;
    max-width: 1400px;
    margin: 0 auto;
    pointer-events: none;
  }

  .original-nav-container {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px; /* Space between Nav Capsule and CTA Capsule */
    margin-top: 24px;
    pointer-events: auto;
  }

  /* ========================================
     LOGO ISLAND
     ======================================== */
  .logo {
    position: relative; /* Removed absolute positioning */
    align-self: flex-start;
    z-index: 50;
    pointer-events: auto;
  }

  .logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 24px 32px 32px 32px;
    background: rgba(255, 255, 255, 0.98);
    border-radius: 0 0 40px 40px;
    text-decoration: none;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: transform 0.3s ease;
  }

  .logo-img {
    display: block;
    width: 140px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* ========================================
     NAVIGATION ISLAND
     ======================================== */
  .desktop-nav {
    background: rgba(20, 20, 20, 0.85); /* Dark capsule */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 50px;
    padding: 12px 32px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    margin: 0;
  }

  .nav-list {
    display: flex;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: gap 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
    text-decoration: none;
    display: inline-block;
    height: 1.2em;
    overflow: hidden;
    opacity: 0.9;
    transition:
      color 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      text-shadow 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
  }

  .nav-layer {
    display: flex;
    white-space: nowrap;
  }

  .nav-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }

  .nav-char {
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 35ms);
  }

  .nav-link:hover .nav-layer-top .nav-char,
  .nav-link:hover .nav-layer-bottom .nav-char {
    transform: translateY(-100%);
  }

  .nav-link:hover {
    opacity: 1;
    color: var(--color-brand, #e63946); /* Inherits your brand color on hover */
  }

  /* ========================================
     CTA ISLAND
     ======================================== */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand);
    border: 1px solid var(--color-brand);
    color: #fff;
    padding: 12px 28px 12px 22px; 
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 50px; 
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    gap: 12px;
    box-shadow: none; 
  }

  .btn-primary:hover {
    background-color: #d62828; 
    border-color: #d62828;
    transform: translateY(-2px);
  }

  .cta-accent {
    display: block;
    width: 12px;
    height: 2px; 
    background: #fff;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-primary:hover .cta-accent {
    width: 24px; 
  }

  .cta-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
  }

  .cta-layer {
    display: flex;
    white-space: nowrap;
  }

  .cta-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }

  .cta-char {
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 25ms);
  }

  .btn-primary:hover .cta-layer-top .cta-char,
  .btn-primary:hover .cta-layer-bottom .cta-char {
    transform: translateY(-100%);
  }

  /* ========================================
     FLOATING SCROLL NAV
     ======================================== */
  .floating-nav {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translate(-50%, -150%);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      visibility 0.3s;
    width: max-content;
    max-width: calc(100vw - 32px);
    pointer-events: none;
  }

  .floating-nav.visible {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .floating-nav-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 20, 20, 0.95); /* Matched to dark capsule */
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 50px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px 12px 8px 32px; /* Asymmetric padding to wrap the button cleanly */
    gap: 32px;
  }

  .floating-nav-inner .desktop-nav {
    background: transparent;
    box-shadow: none;
    border: none;
    padding: 0;
  }

  .floating-nav .nav-list {
    gap: 28px;
  }

  /* ========================================
     MOBILE & RESPONSIVE
     ======================================== */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    cursor: pointer;
    padding: 12px 16px;
    z-index: 101;
    backdrop-filter: blur(8px);
  }

  .hamburger-line {
    width: 20px;
    height: 2px;
    background-color: #ffffff;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  @media (max-width: 1024px) {
    .header {
      top: 16px;
    }

    .logo-link {
      padding: 16px 24px 24px 24px;
      border-radius: 0 0 32px 32px;
    }

    .logo-img {
      width: 130px;
    }

    .desktop-nav,
    .header-actions {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .floating-nav {
      top: 16px;
    }

    .floating-nav-inner {
      padding: 8px 24px;
      gap: 0;
    }

    .floating-nav-inner .desktop-nav,
    .floating-nav-inner .header-actions {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Mobile menu toggle
    const btns = document.querySelectorAll(".mobile-menu-btn");
    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btns.forEach((b) => b.setAttribute("aria-expanded", !expanded));
      });
    });

    // Direction-aware floating nav logic
    const floatingNav = document.getElementById("floating-nav");
    if (!floatingNav) return;

    let lastScrollY = window.scrollY;
    let ticking = false;

    // Thresholds
    const TOP_THRESHOLD = 150;
    const SCROLL_DELTA_THRESHOLD = 20;

    let scrollAnchor = window.scrollY;
    let lastDirection = 0; // 1 for down, -1 for up

    const updateNav = () => {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;

      const currentDirection = delta === 0 ? 0 : Math.sign(delta);

      if (currentDirection !== 0 && currentDirection !== lastDirection) {
        scrollAnchor = currentScrollY;
        lastDirection = currentDirection;
      }

      const distanceFromAnchor = Math.abs(currentScrollY - scrollAnchor);

      if (currentScrollY <= TOP_THRESHOLD) {
        floatingNav.classList.remove("visible");
      } else if (
        currentDirection === -1 &&
        distanceFromAnchor >= SCROLL_DELTA_THRESHOLD
      ) {
        floatingNav.classList.add("visible");
      } else if (
        currentDirection === 1 &&
        distanceFromAnchor >= SCROLL_DELTA_THRESHOLD
      ) {
        floatingNav.classList.remove("visible");
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateNav);
          ticking = true;
        }
      },
      { passive: true },
    );
  });
</script>
