---
import { Image } from 'astro:assets';
import logoImg from '../../assets/images/icons/colored small bg removed.png';

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === '/' || pathname === '/index.html';
---

<header class={`header ${isHome ? 'header-transparent-dark' : ''}`}>
  <div class="container header-container">
    <div class="logo fade-in stagger-1">
      <a href="/" class="logo-link">
        <Image src={logoImg} alt="Powernet Logo" class="logo-img" />
      </a>
    </div>
    
    <nav class="desktop-nav fade-in stagger-2">
      <ul class="nav-list">
        <li><a href="/services" class="nav-link"><span class="nav-link-inner" data-text="Services"><span class="nav-text">Services</span></span></a></li>
        <li><a href="/projects" class="nav-link"><span class="nav-link-inner" data-text="Projects"><span class="nav-text">Projects</span></span></a></li>
        <li><a href="/about" class="nav-link"><span class="nav-link-inner" data-text="About"><span class="nav-text">About</span></span></a></li>
        <li><a href="/contact" class="nav-link"><span class="nav-link-inner" data-text="Contact"><span class="nav-text">Contact</span></span></a></li>
      </ul>
    </nav>

    <div class="header-actions fade-in stagger-3">
      <a href="/contact" class="btn-primary"><span>START A PROJECT</span></a>
    </div>
  </div>
</header>

<style>
  .header {
    position: absolute; /* Blends with background as requested */
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: var(--space-md) 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-link {
    display: block;
    height: 48px;
  }

  .logo-img {
    width: auto;
    height: 100%;
    object-fit: contain;
    object-position: left;
    transition: filter 0.3s ease;
  }

  /* Removed logo inversion to keep full color */

  .header-transparent-dark .nav-link {
    color: var(--color-dark-foreground);
  }

  .nav-list {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-mono); /* Engineered personality */
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    text-decoration: none;
    display: inline-block;
    padding: 0.5rem 0;
  }

  .nav-link-inner {
    position: relative;
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .nav-text {
    display: inline-block;
    transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1);
  }

  /* Hover personality - metric.ca style rolling text */
  .nav-link-inner::after {
    content: attr(data-text);
    position: absolute;
    top: 100%;
    left: 0;
    color: var(--color-brand);
    transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .nav-link:hover .nav-text {
    transform: translateY(-100%);
  }

  .nav-link:hover .nav-link-inner::after {
    transform: translateY(-100%);
  }

  .header-transparent-dark .nav-link:hover .nav-link-inner::after {
    color: var(--color-brand);
  }

  .btn-primary {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand);
    color: #fff;
    padding: 0.75rem 1.5rem;
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    z-index: 1;
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--color-brand-dark);
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1);
    z-index: -1;
  }

  .btn-primary:hover::before {
    transform: translateY(0);
  }

  @media (max-width: 1024px) {
    .desktop-nav {
      display: none; /* We'll need a mobile menu later */
    }
  }
</style>
