---
import { Image } from "astro:assets";
import logoImg from "../../assets/images/icons/powernet-logo.png";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/" || pathname === "/index.html";
const navItems = [
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header id="main-header" class={`header ${isHome ? "header-transparent-dark" : ""}`}>
  <div class="header-wrapper">
    <div class="logo-container fade-in stagger-1">
      <a href="/" class="logo-link">
        <Image
          src={logoImg}
          alt="Powernet Logo"
          class="logo-img"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <div class="nav-container fade-in stagger-2">
      <nav class="desktop-nav">
        <ul class="nav-list">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="nav-link">
                  <span class="nav-word">
                    <span class="nav-layer nav-layer-top">
                      {Array.from(item.label).map((letter, index) => (
                        <span class="nav-char" style={`--i:${index}`}>
                          {letter}
                        </span>
                      ))}
                    </span>

                    <span class="nav-layer nav-layer-bottom" aria-hidden="true">
                      {Array.from(item.label).map((letter, index) => (
                        <span class="nav-char" style={`--i:${index}`}>
                          {letter}
                        </span>
                      ))}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      
      <button
        class="mobile-menu-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <div class="header-actions">
        <a href="/contact" class="btn-primary">
          <span class="cta-accent" aria-hidden="true"></span>
          <span class="cta-word">
            <span class="cta-layer cta-layer-top">
              {Array.from("LET'S TALK").map((letter, index) => (
                <span class="cta-char" style={`--i:${index}`}>
                  {letter === " " ? "\u00A0" : letter}
                </span>
              ))}
            </span>
            <span class="cta-layer cta-layer-bottom" aria-hidden="true">
              {Array.from("LET'S TALK").map((letter, index) => (
                <span class="cta-char" style={`--i:${index}`}>
                  {letter === " " ? "\u00A0" : letter}
                </span>
              ))}
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  :root {
    --hdr-anim: 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    
    --logo-w-init: 210px;
    --logo-h-init: 90px;
    --logo-w-scroll: 145px;
    
    --nav-h-init: 90px;
    --hdr-h-scroll: 60px;
    
    --hdr-gap: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      --hdr-anim: 0.01s linear;
    }
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 24px 0;
    pointer-events: none; /* Let clicks pass through transparent gaps */
    transition: padding var(--hdr-anim);
  }

  .header.scrolled {
    padding: 18px 0;
  }

  .header-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    gap: var(--hdr-gap);
    pointer-events: auto; /* Re-enable clicks on the header parts */
    transition: gap var(--hdr-anim);
  }

  .header.scrolled .header-wrapper {
    gap: 0;
  }

  .logo-container, .nav-container {
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.02);
    transition: 
      width var(--hdr-anim),
      height var(--hdr-anim),
      border-radius var(--hdr-anim),
      padding var(--hdr-anim),
      border-color var(--hdr-anim),
      margin var(--hdr-anim);
  }

  .logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--logo-w-init);
    height: var(--logo-h-init);
    border-radius: 26px;
    flex-shrink: 0;
    padding: 0 24px;
    /* Create stacking context to overlap cleanly */
    position: relative;
    z-index: 2;
  }

  .logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nav-container {
    display: flex;
    align-items: center;
    height: var(--nav-h-init);
    border-radius: 26px;
    flex-grow: 1;
    padding: 0 12px 0 32px;
    position: relative;
    z-index: 1;
  }

  .desktop-nav {
    margin: 0 auto; /* Center navigation in available space */
  }

  .header.scrolled .logo-container {
    width: var(--logo-w-scroll);
    height: var(--hdr-h-scroll);
    border-radius: 26px 0 0 26px;
    border-right-color: transparent;
    padding: 0 16px 0 24px;
    margin-right: -1px; /* Tiny overlap to prevent backdrop-filter seam */
  }

  .header.scrolled .nav-container {
    height: var(--hdr-h-scroll);
    border-radius: 0 26px 26px 0;
    border-left-color: transparent;
    padding: 0 12px 0 24px;
  }

  /* Typography and Link animations */
  .nav-list {
    display: flex;
    gap: 48px;
    list-style: none;
    transition: gap var(--hdr-anim);
  }

  .header.scrolled .nav-list {
    gap: 32px;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1a1a1a; /* Always dark because container is always white */
    text-decoration: none;
    display: inline-block;
    height: 1.2em;
    overflow: hidden;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .nav-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
  }

  .nav-layer {
    display: flex;
    white-space: nowrap;
  }

  .nav-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }

  .nav-char {
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 35ms);
  }

  .nav-link:hover .nav-layer-top .nav-char {
    transform: translateY(-100%);
  }
  .nav-link:hover .nav-layer-bottom .nav-char {
    transform: translateY(-100%);
  }
  .nav-link:hover {
    opacity: 1;
  }

  /* Button animations */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand);
    border: 1px solid var(--color-brand);
    color: #fff;
    padding: 12px 20px;
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    transition: transform 0.3s ease, border-radius var(--hdr-anim);
    transition-delay: 0s !important;
    gap: 12px;
  }

  .header.scrolled .btn-primary {
    border-radius: 12px;
  }

  .btn-primary:hover {
    background-color: var(--color-brand);
  }

  .cta-accent {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                border-radius 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-primary:hover .cta-accent {
    width: 28px;
    border-radius: 2px;
  }

  .cta-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
  }
  .cta-layer {
    display: flex;
    white-space: nowrap;
  }
  .cta-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }
  .cta-char {
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 25ms);
  }
  .btn-primary:hover .cta-layer-top .cta-char {
    transform: translateY(-100%);
  }
  .btn-primary:hover .cta-layer-bottom .cta-char {
    transform: translateY(-100%);
  }

  /* Mobile Menu Styles */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 101;
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background-color: #1a1a1a; /* Dark lines because container is white */
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  /* Mobile View - simpler permanent compact header */
  @media (max-width: 1024px) {
    .header-wrapper {
      gap: 0;
      padding: 0 16px;
    }
    
    .logo-container, .header.scrolled .logo-container {
      width: auto;
      height: 60px;
      padding: 0 16px;
      border-radius: 20px 0 0 20px;
      border-right-color: transparent;
      margin-right: -1px;
    }
    
    .logo-link {
      width: 120px; 
    }
    
    .nav-container, .header.scrolled .nav-container {
      height: 60px;
      border-radius: 0 20px 20px 0;
      padding: 0 16px;
      border-left-color: transparent;
    }
    
    .desktop-nav,
    .header-actions {
      display: none;
    }
    
    .mobile-menu-btn {
      display: flex;
      margin-left: auto;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.querySelector(".mobile-menu-btn");
    if (btn) {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true" || false;
        btn.setAttribute("aria-expanded", !expanded);
      });
    }

    const header = document.getElementById("main-header");
    if (header) {
      let ticking = false;
      
      const handleScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            if (window.scrollY > 80) {
              header.classList.add("scrolled");
            } else {
              header.classList.remove("scrolled");
            }
            ticking = false;
          });
          ticking = true;
        }
      };
      
      window.addEventListener("scroll", handleScroll, { passive: true });
      handleScroll(); // Check initial scroll position
    }
  });
</script>
