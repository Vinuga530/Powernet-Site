---
import { Image } from "astro:assets";
import logoImg from "../../assets/images/icons/powernet-logo.png";

const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === "/" || pathname === "/index.html";
const navItems = [
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header class={`header ${isHome ? "header-transparent-dark" : ""}`}>
  <div class="container header-container">
    <div class="logo fade-in stagger-1">
      <a href="/" class="logo-link">
        <Image
          src={logoImg}
          alt="Powernet Logo"
          class="logo-img"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <nav class="desktop-nav fade-in stagger-2">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                <span class="nav-word">
                  <span class="nav-layer nav-layer-top">
                    {Array.from(item.label).map((letter, index) => (
                      <span class="nav-char" style={`--i:${index}`}>
                        {letter}
                      </span>
                    ))}
                  </span>

                  <span class="nav-layer nav-layer-bottom" aria-hidden="true">
                    {Array.from(item.label).map((letter, index) => (
                      <span class="nav-char" style={`--i:${index}`}>
                        {letter}
                      </span>
                    ))}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      class="mobile-menu-btn fade-in stagger-2"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <div class="header-actions fade-in stagger-3">
      <a href="/contact" class="btn-primary"
        >START A PROJECT <span class="cta-arrow">&#8599;</span></a
      >
    </div>
  </div>
</header>

<style>
  .header {
    position: absolute; /* Blends with background as requested */
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: var(--space-md) 0;
  }

  .header-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .logo {
    justify-self: start;
  }

  .logo-link {
    display: block;
    width: clamp(120px, 8vw, 165px);
  }

  .logo-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .desktop-nav {
    justify-self: center;
  }

  .header-actions {
    justify-self: end;
  }

  /* Removed logo inversion to keep full color */

  .header-transparent-dark .nav-link {
    color: var(--color-dark-foreground);
  }

  .nav-list {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    text-decoration: none;

    display: inline-block;
    height: 1.2em;
    overflow: hidden;

    opacity: 0.9;
  }

  .nav-word {
    position: relative;
    display: block;
    height: 1.2em;
    line-height: 1.2em;
  }

  .nav-layer {
    display: flex;
    white-space: nowrap;
  }

  .nav-layer-bottom {
    position: absolute;
    left: 0;
    top: 100%;
  }

  .nav-char {
    display: inline-block;

    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);

    transition-delay: calc(var(--i) * 35ms);
  }

  /* Original letters leave upward */
  .nav-link:hover .nav-layer-top .nav-char {
    transform: translateY(-100%);
  }

  /* New letters enter from below */
  .nav-link:hover .nav-layer-bottom .nav-char {
    transform: translateY(-100%);
  }

  .nav-link:hover {
    opacity: 1;
  }
  .header-transparent-dark .nav-link {
    color: var(--color-dark-foreground);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border: 1px solid var(--color-brand);
    color: #fff;
    padding: 0.5rem 1.25rem;
    font-size: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    transition:
      background-color 0.3s ease,
      transform 0.3s ease;
    transition-delay: 0s !important;
  }

  .cta-arrow {
    margin-left: 0.5rem;
    font-size: 1.1em;
  }

  .btn-primary:hover {
    background-color: var(--color-brand);
    color: #fff;
  }

  /* Mobile Menu Styles */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 101;
    justify-self: end;
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background-color: var(--color-foreground);
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .header-transparent-dark .hamburger-line {
    background-color: var(--color-dark-foreground);
  }

  @media (max-width: 1024px) {
    .header-container {
      grid-template-columns: 1fr auto; /* Logo and Hamburger */
    }

    .desktop-nav,
    .header-actions {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.querySelector(".mobile-menu-btn");
    if (btn) {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true" || false;
        btn.setAttribute("aria-expanded", !expanded);
        // Minimal toggle logic for future mobile menu
        // Right now we just toggle the button state
      });
    }
  });
</script>
