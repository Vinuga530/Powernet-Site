---
/* footer */
const navLinks = [
  { href: "/#services", label: "Services" },
  { href: "/#projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Careers" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="footer">
  <div class="container footer-top">
    <!-- left: identity -->
    <div class="footer-col footer-identity">
      <div class="social-row">
        <a href="#" aria-label="Facebook" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="10.2" />
            <path d="M13.6 8.4h1.6V5.8h-1.9c-2 0-3 1.1-3 3v1.9H8.6v2.6h1.7V18h2.7v-4.7h1.9l.4-2.6h-2.3v-1.6c0-.5.2-.7.6-.7Z" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href="#" aria-label="LinkedIn" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="3.4" />
            <path d="M8.2 10v6.4M8.2 7.6v.02M11.6 16.4V12.7c0-1.2.7-2 1.9-2 1.1 0 1.7.8 1.7 2v3.7" fill="none" stroke="currentColor" />
          </svg>
        </a>
      </div>

      <a href="mailto:powernet@powernet.lk" class="footer-email">powernet@powernet.lk</a>

      <p class="footer-address text-small">
        No 9, Park Avenue,<br />
        Colombo 8, Sri Lanka
      </p>
    </div>

    <!-- center: cta -->
    <div class="footer-cta">
      <div class="cta-bracket cta-bracket-left" aria-hidden="true">
        <span class="dot-grid"></span>
        <svg class="bracket-curve" viewBox="0 0 40 120" preserveAspectRatio="none">
          <path d="M0,0 C 22,0 22,60 40,60 C 22,60 22,120 0,120" />
        </svg>
      </div>

      <a href="/contact" class="btn-pill btn-solid-red footer-cta-btn" aria-label="Get a Quote">
        <span class="nav-word" aria-hidden="true">
          <span class="nav-layer nav-layer-top">
            {Array.from("Get a Quote").map((letter, index) => (
              <span class="nav-char" style={`--char-index:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
          <span class="nav-layer nav-layer-bottom" aria-hidden="true">
            {Array.from("Get a Quote").map((letter, index) => (
              <span class="nav-char" style={`--char-index:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
        </span>
      </a>

      <div class="cta-bracket cta-bracket-right" aria-hidden="true">
        <svg class="bracket-curve" viewBox="0 0 40 120" preserveAspectRatio="none">
          <path d="M40,0 C 18,0 18,60 0,60 C 18,60 18,120 40,120" />
        </svg>
        <span class="dot-grid"></span>
      </div>
    </div>

    <!-- right: nav -->
    <nav class="footer-col footer-nav" aria-label="Footer">
      <ul>
        {navLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom-bar">
    <a href="#" class="footer-legal-link">Terms and conditions</a>
    <span class="footer-copyright text-small">&copy; {new Date().getFullYear()} Powernet (Pvt) Ltd. All Rights Reserved.</span>
    <a href="#" class="footer-legal-link">Privacy Policy</a>
  </div>

  <div class="footer-watermark" aria-hidden="true">POWERNET</div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface);
    padding-top: var(--space-2xl);
    margin-top: var(--space-3xl);
    overflow: hidden;
  }

  /* ===== top row ===== */
  .footer-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* -- identity column -- */
  .social-row {
    display: flex;
    gap: var(--space-sm);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .social-icon:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .footer-email {
    font-size: var(--text-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer-email:hover {
    color: var(--color-brand);
  }

  .footer-address {
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* -- nav column -- */
  .footer-nav {
    align-items: flex-end;
    text-align: right;
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-nav a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--color-brand);
  }

  /* ===== center cta ===== */
  .footer-cta {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .footer-cta-btn {
    flex-shrink: 0;
  }

  .cta-bracket {
    display: flex;
    align-items: center;
    height: 100px;
  }

  .cta-bracket-left {
    flex-direction: row;
  }

  .cta-bracket-right {
    flex-direction: row-reverse;
  }

  .dot-grid {
    width: 64px;
    height: 100px;
    background-image: radial-gradient(var(--color-border) 1.4px, transparent 1.4px);
    background-size: 11px 11px;
    opacity: 0.9;
  }

  .bracket-curve {
    width: 24px;
    height: 100px;
    overflow: visible;
  }

  .bracket-curve path {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.4;
  }

  /* ===== bottom bar ===== */
  .footer-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .footer-legal-link,
  .footer-copyright {
    color: var(--color-muted);
  }

  .footer-legal-link:hover {
    color: var(--color-brand);
  }

  /* ===== watermark band ===== */
  .footer-watermark {
    background-color: #0d0e12;
    color: rgba(255, 255, 255, 0.06);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(6rem, 16vw, 14rem);
    line-height: 0.78;
    letter-spacing: -0.03em;
    text-align: center;
    padding-top: 0.15em;
    user-select: none;
    white-space: nowrap;
  }

  /* ===== responsive ===== */
  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: var(--space-2xl);
    }

    .footer-identity,
    .footer-nav {
      align-items: center;
      text-align: center;
    }

    .footer-nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .cta-bracket {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .footer-bottom-bar {
      flex-direction: column;
      text-align: center;
    }

    .footer-watermark {
      font-size: clamp(3.5rem, 20vw, 6rem);
    }
  }
</style>
