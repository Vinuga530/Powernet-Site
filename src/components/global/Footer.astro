---
import { getEntry } from 'astro:content';

const companyEntry = await getEntry('settings', 'company');
const company = companyEntry.data;

/* footer */
const navLinks = [
  { href: "/#services", label: "Services" },
  { href: "/#projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Careers" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="footer">
  <div class="container footer-top">
    <!-- left: identity -->
    <div class="footer-col footer-identity">
      <div class="social-row">
        <a href="https://www.facebook.com/share/1BibcXp3BA/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="10.2" />
            <path d="M13.6 8.4h1.6V5.8h-1.9c-2 0-3 1.1-3 3v1.9H8.6v2.6h1.7V18h2.7v-4.7h1.9l.4-2.6h-2.3v-1.6c0-.5.2-.7.6-.7Z" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/company/powernet-pvt-ltd/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="3.4" />
            <path d="M8.2 10v6.4M8.2 7.6v.02M11.6 16.4V12.7c0-1.2.7-2 1.9-2 1.1 0 1.7.8 1.7 2v3.7" fill="none" stroke="currentColor" />
          </svg>
        </a>
        <a href="https://wa.me/message/LRL7253LRNXPG1" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 2.04c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.47 1.33 4.98L2 22l5.16-1.35A9.93 9.93 0 0 0 12 21.96c5.5 0 9.96-4.46 9.96-9.96S17.5 2.04 12 2.04Z" />
            <path d="M16.5 14.38c-.25-.12-1.47-.72-1.7-.8-.22-.09-.38-.13-.55.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.12-.12.25-.29.38-.44.12-.16.16-.25.25-.42.08-.16.04-.3-.02-.42-.06-.13-.55-1.32-.75-1.81-.2-.47-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.1.16 1.52.1.46-.07 1.43-.59 1.63-1.15.2-.57.2-1.05.14-1.15-.06-.1-.22-.16-.47-.28Z" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>

      <a href={`mailto:${company.primaryEmail}`} class="footer-email">{company.primaryEmail}</a>

      <p class="footer-address text-small">
        {company.addressLine1},<br />
        {company.addressLine2}, {company.country}
      </p>
    </div>

    <!-- center: cta -->
    <div class="footer-cta">
      <div class="cta-bracket cta-bracket-left" aria-hidden="true">
        <span class="dot-grid"></span>
        <svg class="bracket-curve" viewBox="0 0 40 120" preserveAspectRatio="none">
          <path d="M0,0 C 22,0 22,60 40,60 C 22,60 22,120 0,120" />
        </svg>
      </div>

      <a href="/contact" class="btn-pill btn-solid-red footer-cta-btn" aria-label="Get a Quote">
        <span class="nav-word" aria-hidden="true">
          <span class="nav-layer nav-layer-top">
            {Array.from("Get a Quote").map((letter, index) => (
              <span class="nav-char" style={`--char-index:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
          <span class="nav-layer nav-layer-bottom" aria-hidden="true">
            {Array.from("Get a Quote").map((letter, index) => (
              <span class="nav-char" style={`--char-index:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
        </span>
      </a>

      <div class="cta-bracket cta-bracket-right" aria-hidden="true">
        <svg class="bracket-curve" viewBox="0 0 40 120" preserveAspectRatio="none">
          <path d="M40,0 C 18,0 18,60 0,60 C 18,60 18,120 40,120" />
        </svg>
        <span class="dot-grid"></span>
      </div>
    </div>

    <!-- right: nav -->
    <nav class="footer-col footer-nav" aria-label="Footer">
      <ul>
        {navLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom-bar">
    <span class="footer-copyright text-small">&copy; {new Date().getFullYear()} Powernet (Pvt) Ltd. All Rights Reserved.</span>
  </div>

  <div class="footer-watermark" aria-hidden="true">
    <div class="footer-watermark-wrapper">
      <span class="footer-watermark-base">POWERNET</span>
      <span class="footer-watermark-glow" aria-hidden="true">POWERNET</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface);
    padding-top: var(--space-2xl);
    margin-top: var(--space-3xl);
    overflow: hidden;
  }

  /* ===== top row ===== */
  .footer-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* -- identity column -- */
  .social-row {
    display: flex;
    gap: var(--space-sm);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .social-icon:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .footer-email {
    font-size: var(--text-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer-email:hover {
    color: var(--color-brand);
  }

  .footer-address {
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* -- nav column -- */
  .footer-nav {
    align-items: flex-end;
    text-align: right;
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-nav a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--color-brand);
  }

  /* ===== center cta ===== */
  .footer-cta {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .footer-cta-btn {
    flex-shrink: 0;
  }

  .cta-bracket {
    display: flex;
    align-items: center;
    height: 100px;
  }

  .cta-bracket-left {
    flex-direction: row;
  }

  .cta-bracket-right {
    flex-direction: row-reverse;
  }

  .dot-grid {
    width: 64px;
    height: 100px;
    background-image: radial-gradient(var(--color-border) 1.4px, transparent 1.4px);
    background-size: 11px 11px;
    opacity: 0.9;
  }

  .bracket-curve {
    width: 24px;
    height: 100px;
    overflow: visible;
  }

  .bracket-curve path {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.4;
  }

  /* ===== bottom bar ===== */
  .footer-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .footer-copyright {
    color: var(--color-muted);
  }

  /* ===== watermark band ===== */
  .footer-watermark {
    position: relative;
    background-color: #0d0e12;
    padding-top: 0.15em;
    user-select: none;
    white-space: nowrap;
    overflow: hidden;
  }

  .footer-watermark-wrapper {
    position: relative;
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(6rem, 16vw, 14rem);
    line-height: 0.78;
    letter-spacing: -0.03em;
    white-space: nowrap;
    user-select: none;
  }

  .footer-watermark-base {
    display: block;
    color: rgba(255, 255, 255, 0.06);
    user-select: none;
  }

  .footer-watermark-glow {
    position: absolute;
    inset: 0;
    display: block;
    user-select: none;
    pointer-events: none;
    color: transparent;
    background: linear-gradient(
      180deg,
      #ff5e5e 0%,
      var(--color-brand) 38%,
      var(--color-brand-dark) 78%,
      #7d0d0d 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    will-change: mask-image, -webkit-mask-image, opacity;
  }

  /* ===== responsive ===== */
  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: var(--space-2xl);
    }

    .footer-identity,
    .footer-nav {
      align-items: center;
      text-align: center;
    }

    .footer-nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .cta-bracket {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .footer-bottom-bar {
      flex-direction: column;
      text-align: center;
    }

    .footer-watermark {
      font-size: clamp(3.5rem, 20vw, 6rem);
    }

    .footer-email {
      word-break: break-all;
      font-size: 1.1rem;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      gap: var(--space-xl);
    }

    .footer-nav ul {
      gap: var(--space-xs);
    }

    .footer-bottom-bar {
      gap: var(--space-sm);
      font-size: 0.8rem;
    }
  }
</style>

<script>
  /* =====================================================================
     FOOTER WATERMARK FLUID REVEAL ENGINE
     - Dual-DOM layer architecture: 100.0% pixel-perfect coincidence
     - Zero canvas misalignment or baseline drift across all screens
     - iOS-level fluid water spring lag with dynamic teardrop stretch
     - Multi-node organic liquid diffusion mask
     - Zero idle CPU usage (RAF loop halts when liquid settles)
     ===================================================================== */
  let watermarkRAF: number | null = null;
  let watermarkCleanup: (() => void) | null = null;

  const initWatermarkReveal = () => {
    if (watermarkCleanup) {
      watermarkCleanup();
      watermarkCleanup = null;
    }
    if (watermarkRAF) {
      cancelAnimationFrame(watermarkRAF);
      watermarkRAF = null;
    }

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (prefersReduced) return;

    const watermarkEl = document.querySelector<HTMLElement>(".footer-watermark");
    const wrapper = watermarkEl?.querySelector<HTMLElement>(".footer-watermark-wrapper");
    const glowEl = watermarkEl?.querySelector<HTMLElement>(".footer-watermark-glow");
    if (!watermarkEl || !wrapper || !glowEl) return;

    // Chain of liquid nodes: node 0 chases the pointer, each next node chases the one before it.
    const TAU = [0.07, 0.12, 0.18, 0.26]; // seconds: follow time constant per node
    const SCALE = [1, 0.78, 0.58, 0.4]; // node radius relative to the head
    const nodes = TAU.map(() => ({ x: 0, y: 0 }));

    let targetX = 0;
    let targetY = 0;
    let presence = 0; // 0 = no liquid, 1 = full size
    let last = 0;
    let isInside = false;
    let isAnimating = false;

    const circle = (x: number, y: number, r: number) =>
      `radial-gradient(circle ${r}px at ${x}px ${y}px, #000 ${r - 1.5}px, transparent ${r}px)`;

    const updateFluidMask = (now: number) => {
      const dt = Math.max(0, Math.min((now - last) / 1000, 0.05));
      last = now;
      const ease = (tau: number) => 1 - Math.exp(-dt / tau);

      nodes[0].x += (targetX - nodes[0].x) * ease(TAU[0]);
      nodes[0].y += (targetY - nodes[0].y) * ease(TAU[0]);
      for (let i = 1; i < nodes.length; i++) {
        nodes[i].x += (nodes[i - 1].x - nodes[i].x) * ease(TAU[i]);
        nodes[i].y += (nodes[i - 1].y - nodes[i].y) * ease(TAU[i]);
      }
      presence += ((isInside ? 1 : 0) - presence) * ease(0.12);

      const rect = wrapper.getBoundingClientRect();
      const headR = Math.max(48, Math.min(rect.width * 0.055, 90)) * presence;
      const radius = (i: number) =>
        headR * SCALE[i] * (1 + 0.035 * Math.sin(now / 160 + i * 1.7));

      const layers: string[] = [];
      const add = (x: number, y: number, r: number) => {
        if (r >= 2) layers.push(circle(x, y, r));
      };

      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        const rA = radius(i);
        add(a.x, a.y, rA);
        if (i === nodes.length - 1) break;

        // Fill the gap to the next droplet with circles that pinch in the middle (surface-tension neck).
        const b = nodes[i + 1];
        const rB = radius(i + 1);
        const gap = Math.hypot(b.x - a.x, b.y - a.y);
        const steps = Math.min(5, Math.ceil(gap / (rB * 0.6)));
        const neck = Math.max(0.5, 1 - gap / (rA * 6));
        for (let s = 1; s < steps; s++) {
          const t = s / steps;
          const r = (rA + (rB - rA) * t) * (1 - (1 - neck) * Math.sin(Math.PI * t));
          add(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, r);
        }
      }

      const mask = layers.join(",");
      glowEl.style.webkitMaskImage = mask;
      glowEl.style.maskImage = mask;

      if (!isInside && presence < 0.05) {
        glowEl.style.opacity = "0";
        isAnimating = false;
        watermarkRAF = null;
        return;
      }
      watermarkRAF = requestAnimationFrame(updateFluidMask);
    };

    const onPointerMove = (e: PointerEvent) => {
      const rect = wrapper.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;
      isInside = true;

      if (!isAnimating) {
        // A new droplet spawns at the cursor and grows from there.
        for (const n of nodes) {
          n.x = targetX;
          n.y = targetY;
        }
        presence = 0.1;
        last = performance.now();
        glowEl.style.opacity = "1";
        isAnimating = true;
        watermarkRAF = requestAnimationFrame(updateFluidMask);
      }
    };

    const onPointerLeave = () => {
      isInside = false;
    };

    watermarkEl.addEventListener("pointermove", onPointerMove, { passive: true });
    watermarkEl.addEventListener("pointerleave", onPointerLeave, { passive: true });

    watermarkCleanup = () => {
      if (watermarkRAF) {
        cancelAnimationFrame(watermarkRAF);
        watermarkRAF = null;
      }
      watermarkEl.removeEventListener("pointermove", onPointerMove);
      watermarkEl.removeEventListener("pointerleave", onPointerLeave);
      isAnimating = false;
    };
  };

  document.addEventListener("astro:page-load", initWatermarkReveal);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWatermarkReveal, { once: true });
  } else {
    initWatermarkReveal();
  }
</script>
