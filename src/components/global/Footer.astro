---
import { getEntry } from 'astro:content';

const companyEntry = await getEntry('settings', 'company');
const company = companyEntry.data;

/* footer */
const navLinks = [
  { href: "/#services", label: "Services" },
  { href: "/#projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Careers" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="footer">
  <div class="container footer-top">
    <!-- left: identity -->
    <div class="footer-col footer-identity">
      <div class="social-row">
        <a href="https://www.facebook.com/share/1BibcXp3BA/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="10.2" />
            <path d="M13.6 8.4h1.6V5.8h-1.9c-2 0-3 1.1-3 3v1.9H8.6v2.6h1.7V18h2.7v-4.7h1.9l.4-2.6h-2.3v-1.6c0-.5.2-.7.6-.7Z" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/company/powernet-pvt-ltd/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="3.4" />
            <path d="M8.2 10v6.4M8.2 7.6v.02M11.6 16.4V12.7c0-1.2.7-2 1.9-2 1.1 0 1.7.8 1.7 2v3.7" fill="none" stroke="currentColor" />
          </svg>
        </a>
        <a href="https://wa.me/message/LRL7253LRNXPG1" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 2.04c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.47 1.33 4.98L2 22l5.16-1.35A9.93 9.93 0 0 0 12 21.96c5.5 0 9.96-4.46 9.96-9.96S17.5 2.04 12 2.04Z" />
            <path d="M16.5 14.38c-.25-.12-1.47-.72-1.7-.8-.22-.09-.38-.13-.55.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.12-.12.25-.29.38-.44.12-.16.16-.25.25-.42.08-.16.04-.3-.02-.42-.06-.13-.55-1.32-.75-1.81-.2-.47-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.1.16 1.52.1.46-.07 1.43-.59 1.63-1.15.2-.57.2-1.05.14-1.15-.06-.1-.22-.16-.47-.28Z" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>

      <a href={`mailto:${company.primaryEmail}`} class="footer-email">{company.primaryEmail}</a>

      <p class="footer-address text-small">
        {company.addressLine1},<br />
        {company.addressLine2}, {company.country}
      </p>
    </div>

    <!-- center: cta -->
    <div class="footer-cta">
      <div class="cta-bracket cta-bracket-left" aria-hidden="true">
        <span class="dot-grid"></span>
        <svg class="bracket-curve" viewBox="0 0 40 120" preserveAspectRatio="none">
          <path d="M0,0 C 22,0 22,60 40,60 C 22,60 22,120 0,120" />
        </svg>
      </div>

      <a href="/contact" class="btn-pill btn-solid-red footer-cta-btn" aria-label="Get a Quote">
        <span class="nav-word" aria-hidden="true">
          <span class="nav-layer nav-layer-top">
            {Array.from("Get a Quote").map((letter, index) => (
              <span class="nav-char" style={`--char-index:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
          <span class="nav-layer nav-layer-bottom" aria-hidden="true">
            {Array.from("Get a Quote").map((letter, index) => (
              <span class="nav-char" style={`--char-index:${index}`}>
                {letter === " " ? "\u00A0" : letter}
              </span>
            ))}
          </span>
        </span>
      </a>

      <div class="cta-bracket cta-bracket-right" aria-hidden="true">
        <svg class="bracket-curve" viewBox="0 0 40 120" preserveAspectRatio="none">
          <path d="M40,0 C 18,0 18,60 0,60 C 18,60 18,120 40,120" />
        </svg>
        <span class="dot-grid"></span>
      </div>
    </div>

    <!-- right: nav -->
    <nav class="footer-col footer-nav" aria-label="Footer">
      <ul>
        {navLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom-bar">
    <span class="footer-copyright text-small">&copy; {new Date().getFullYear()} Powernet (Pvt) Ltd. All Rights Reserved.</span>
  </div>

  <div class="footer-watermark" aria-hidden="true">
    <span class="footer-watermark-text">POWERNET<span class="footer-watermark-baseline"></span></span>
    <canvas class="footer-watermark-canvas" aria-hidden="true"></canvas>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface);
    padding-top: var(--space-2xl);
    margin-top: var(--space-3xl);
    overflow: hidden;
  }

  /* ===== top row ===== */
  .footer-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* -- identity column -- */
  .social-row {
    display: flex;
    gap: var(--space-sm);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .social-icon:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .footer-email {
    font-size: var(--text-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer-email:hover {
    color: var(--color-brand);
  }

  .footer-address {
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* -- nav column -- */
  .footer-nav {
    align-items: flex-end;
    text-align: right;
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-nav a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--color-brand);
  }

  /* ===== center cta ===== */
  .footer-cta {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .footer-cta-btn {
    flex-shrink: 0;
  }

  .cta-bracket {
    display: flex;
    align-items: center;
    height: 100px;
  }

  .cta-bracket-left {
    flex-direction: row;
  }

  .cta-bracket-right {
    flex-direction: row-reverse;
  }

  .dot-grid {
    width: 64px;
    height: 100px;
    background-image: radial-gradient(var(--color-border) 1.4px, transparent 1.4px);
    background-size: 11px 11px;
    opacity: 0.9;
  }

  .bracket-curve {
    width: 24px;
    height: 100px;
    overflow: visible;
  }

  .bracket-curve path {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.4;
  }

  /* ===== bottom bar ===== */
  .footer-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .footer-copyright {
    color: var(--color-muted);
  }

  /* ===== watermark band ===== */
  .footer-watermark {
    position: relative;
    background-color: #0d0e12;
    color: rgba(255, 255, 255, 0.06);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(6rem, 16vw, 14rem);
    line-height: 0.78;
    letter-spacing: -0.03em;
    text-align: center;
    padding-top: 0.15em;
    user-select: none;
    white-space: nowrap;
  }

  .footer-watermark-text {
    display: inline-block;
    position: relative;
  }

  .footer-watermark-baseline {
    display: inline-block;
    vertical-align: baseline;
    width: 0;
    height: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .footer-watermark-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ===== responsive ===== */
  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: var(--space-2xl);
    }

    .footer-identity,
    .footer-nav {
      align-items: center;
      text-align: center;
    }

    .footer-nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .cta-bracket {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .footer-bottom-bar {
      flex-direction: column;
      text-align: center;
    }

    .footer-watermark {
      font-size: clamp(3.5rem, 20vw, 6rem);
    }

    .footer-email {
      word-break: break-all;
      font-size: 1.1rem;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      gap: var(--space-xl);
    }

    .footer-nav ul {
      gap: var(--space-xs);
    }

    .footer-bottom-bar {
      gap: var(--space-sm);
      font-size: 0.8rem;
    }
  }
</style>

<script>
  /* =====================================================================
     FOOTER WATERMARK REVEAL ENGINE
     - Fluid liquid water physics with viscous inertia and organic diffusion
     - Exact sub-pixel baseline alignment anchoring directly to DOM text
     - Lifecycle-safe: cleans up and re-inits on astro:page-load
     - Disabled when: prefers-reduced-motion: reduce
     - RAF loop strictly halts when fluid settles (zero idle CPU usage)
     ===================================================================== */
  interface WaterDroplet {
    x: number;
    y: number;
    vx: number;
    vy: number;
    baseR: number;
    maxR: number;
    born: number;
    life: number;
  }

  let watermarkRAF: number | null = null;
  let watermarkCleanup: (() => void) | null = null;

  const initWatermarkReveal = () => {
    if (watermarkCleanup) {
      watermarkCleanup();
      watermarkCleanup = null;
    }
    if (watermarkRAF) {
      cancelAnimationFrame(watermarkRAF);
      watermarkRAF = null;
    }

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (prefersReduced) return;

    const watermarkEl = document.querySelector<HTMLElement>(".footer-watermark");
    const canvas = watermarkEl?.querySelector<HTMLCanvasElement>(".footer-watermark-canvas");
    if (!watermarkEl || !canvas) return;

    const visibleCtx = canvas.getContext("2d");
    if (!visibleCtx) return;

    /* Offscreen canvas layers for compositing */
    const textureCanvas = document.createElement("canvas");
    const maskCanvas = document.createElement("canvas");
    const scratchCanvas = document.createElement("canvas");

    const maskCtx = maskCanvas.getContext("2d");
    const scratchCtx = scratchCanvas.getContext("2d");
    if (!maskCtx || !scratchCtx) return;

    let droplets: WaterDroplet[] = [];
    let isAnimating = false;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let clientW = 0;
    let clientH = 0;
    let brandColor = "#d32f2f";
    let brandDarkColor = "#b71c1c";

    let pointerX = -1000;
    let pointerY = -1000;
    let fluidX = -1000;
    let fluidY = -1000;
    let prevFluidX = -1000;
    let prevFluidY = -1000;
    let isInside = false;

    /* Exact sub-pixel baseline alignment anchored to DOM text */
    const drawWatermarkText = (
      targetCtx: CanvasRenderingContext2D,
      width: number,
      height: number,
      style: CSSStyleDeclaration,
    ) => {
      const fontSize = style.fontSize;
      const fontWeight = style.fontWeight || "800";
      const fontFamily = style.fontFamily;
      const letterSpacing = style.letterSpacing;

      targetCtx.font = `${fontWeight} ${fontSize} ${fontFamily}`;
      targetCtx.textAlign = "center";
      targetCtx.textBaseline = "alphabetic";

      if ("letterSpacing" in targetCtx) {
        if (letterSpacing && letterSpacing !== "normal") {
          (targetCtx as any).letterSpacing = letterSpacing;
        } else {
          (targetCtx as any).letterSpacing = "0px";
        }
      }

      let textX = width / 2;
      let baselineY = height / 2;

      const textEl = watermarkEl.querySelector<HTMLElement>(".footer-watermark-text");
      const baselineEl = watermarkEl.querySelector<HTMLElement>(".footer-watermark-baseline");
      if (textEl && baselineEl) {
        try {
          const tRect = textEl.getBoundingClientRect();
          const bRect = baselineEl.getBoundingClientRect();
          const pRect = watermarkEl.getBoundingClientRect();
          if (tRect.width > 0) {
            textX = tRect.left - pRect.left + tRect.width / 2;
            baselineY = bRect.bottom - pRect.top;
          }
        } catch {}
      } else {
        const metrics = targetCtx.measureText("POWERNET");
        const ascent = metrics.actualBoundingBoxAscent || parseFloat(fontSize) * 0.72;
        baselineY = height / 2 + ascent / 2;
      }

      targetCtx.fillText("POWERNET", textX, baselineY);
    };

    /* Procedural offscreen texture layer */
    const updateTextureCanvas = (
      w: number,
      h: number,
      width: number,
      height: number,
      style: CSSStyleDeclaration,
    ) => {
      textureCanvas.width = w;
      textureCanvas.height = h;
      const tCtx = textureCanvas.getContext("2d");
      if (!tCtx) return;

      tCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      tCtx.clearRect(0, 0, width, height);

      brandColor = style.getPropertyValue("--color-brand").trim() || "#d32f2f";
      brandDarkColor =
        style.getPropertyValue("--color-brand-dark").trim() || "#b71c1c";

      /* Deep rich liquid gradient */
      const baseGrad = tCtx.createLinearGradient(0, 0, 0, height);
      baseGrad.addColorStop(0, "#ff4d4d");
      baseGrad.addColorStop(0.35, brandColor);
      baseGrad.addColorStop(0.75, brandDarkColor);
      baseGrad.addColorStop(1, "#7d0d0d");
      tCtx.fillStyle = baseGrad;
      tCtx.fillRect(0, 0, width, height);

      /* Silky diagonal refraction sheen */
      const sheen = tCtx.createLinearGradient(0, 0, width * 0.75, height);
      sheen.addColorStop(0, "rgba(255, 255, 255, 0)");
      sheen.addColorStop(0.38, "rgba(255, 255, 255, 0.08)");
      sheen.addColorStop(0.5, "rgba(255, 255, 255, 0.42)");
      sheen.addColorStop(0.56, "rgba(255, 255, 255, 0.18)");
      sheen.addColorStop(0.7, "rgba(255, 255, 255, 0)");
      tCtx.fillStyle = sheen;
      tCtx.fillRect(0, 0, width, height);

      /* Surface specular highlight band */
      const topHighlight = tCtx.createLinearGradient(0, 0, 0, height * 0.4);
      topHighlight.addColorStop(0, "rgba(255, 255, 255, 0.32)");
      topHighlight.addColorStop(1, "rgba(255, 255, 255, 0)");
      tCtx.fillStyle = topHighlight;
      tCtx.fillRect(0, 0, width, height * 0.4);
    };

    /* Animation frame render pass with liquid fluid dynamics */
    const renderFrame = () => {
      const now = performance.now();

      /* 1. Viscous liquid follower (iOS spring lag) */
      if (isInside && pointerX >= 0) {
        const easing = 0.22;
        fluidX += (pointerX - fluidX) * easing;
        fluidY += (pointerY - fluidY) * easing;

        const dx = fluidX - prevFluidX;
        const dy = fluidY - prevFluidY;
        const speed = Math.hypot(dx, dy);

        const baseRadius = Math.min(clientW, clientH) * 0.20;
        // Water dynamically stretches with speed, narrowing slightly during fast sweep
        const dropletR = Math.max(baseRadius * 0.65, baseRadius * (1 - Math.min(speed / 60, 0.32)));
        const maxR = dropletR * 1.38;

        const step = Math.max(10, dropletR * 0.3);
        const count = Math.max(1, Math.min(8, Math.floor(speed / step)));

        for (let i = 1; i <= count; i++) {
          const t = i / count;
          const px = prevFluidX + dx * t;
          const py = prevFluidY + dy * t;

          droplets.push({
            x: px,
            y: py,
            vx: dx * 0.035,
            vy: dy * 0.035,
            baseR: dropletR,
            maxR: maxR,
            born: now,
            life: 1100 + Math.random() * 200,
          });
        }

        prevFluidX = fluidX;
        prevFluidY = fluidY;
      }

      /* 2. Update and prune droplets */
      for (let i = droplets.length - 1; i >= 0; i--) {
        const d = droplets[i];
        const age = now - d.born;
        if (age >= d.life) {
          droplets.splice(i, 1);
          continue;
        }

        d.x += d.vx;
        d.y += d.vy;
        d.vx *= 0.94;
        d.vy *= 0.94;
      }

      if (droplets.length === 0 && !isInside) {
        visibleCtx.clearRect(0, 0, canvas.width, canvas.height);
        isAnimating = false;
        watermarkRAF = null;
        fluidX = -1000;
        fluidY = -1000;
        return;
      }

      /* 3. Build soft liquid mask */
      const w = canvas.width;
      const h = canvas.height;
      const width = clientW;
      const height = clientH;
      const style = window.getComputedStyle(watermarkEl);

      maskCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      maskCtx.clearRect(0, 0, width, height);
      maskCtx.globalCompositeOperation = "source-over";

      for (let i = 0; i < droplets.length; i++) {
        const d = droplets[i];
        const age = now - d.born;
        const progress = age / d.life;

        // Smooth liquid diffusion curve
        const expandEase = 1 - Math.pow(1 - progress, 2.5);
        const currentR = d.baseR + (d.maxR - d.baseR) * expandEase;

        // Viscous dissolve curve (lingers with fluid presence, then softly dissipates)
        const alpha = Math.pow(1 - progress, 2.2);
        if (alpha <= 0.005) continue;

        // 6-stop Gaussian liquid light gradient (ultra-soft, zero hard banding)
        const grad = maskCtx.createRadialGradient(d.x, d.y, 0, d.x, d.y, currentR);
        grad.addColorStop(0, `rgba(255, 255, 255, ${alpha * 0.95})`);
        grad.addColorStop(0.2, `rgba(255, 255, 255, ${alpha * 0.84})`);
        grad.addColorStop(0.42, `rgba(255, 255, 255, ${alpha * 0.52})`);
        grad.addColorStop(0.68, `rgba(255, 255, 255, ${alpha * 0.22})`);
        grad.addColorStop(0.88, `rgba(255, 255, 255, ${alpha * 0.05})`);
        grad.addColorStop(1, "rgba(255, 255, 255, 0)");

        maskCtx.fillStyle = grad;
        maskCtx.beginPath();
        maskCtx.arc(d.x, d.y, currentR, 0, Math.PI * 2);
        maskCtx.fill();
      }

      /* 4. Clip mask to exact glyph shapes of "POWERNET" */
      maskCtx.globalCompositeOperation = "source-in";
      maskCtx.fillStyle = "#ffffff";
      drawWatermarkText(maskCtx, width, height, style);

      /* 5. Composite against energized texture */
      scratchCtx.setTransform(1, 0, 0, 1, 0, 0);
      scratchCtx.clearRect(0, 0, w, h);
      scratchCtx.globalCompositeOperation = "source-over";
      scratchCtx.drawImage(textureCanvas, 0, 0);
      scratchCtx.globalCompositeOperation = "destination-in";
      scratchCtx.drawImage(maskCanvas, 0, 0);

      /* 6. Draw with dual-stage soft bloom */
      visibleCtx.setTransform(1, 0, 0, 1, 0, 0);
      visibleCtx.clearRect(0, 0, w, h);

      // Deep ambient glow
      visibleCtx.save();
      visibleCtx.shadowColor = brandColor;
      visibleCtx.shadowBlur = Math.round(32 * dpr);
      visibleCtx.drawImage(scratchCanvas, 0, 0);
      visibleCtx.restore();

      // Soft specular core
      visibleCtx.save();
      visibleCtx.shadowColor = "#ff4d4d";
      visibleCtx.shadowBlur = Math.round(14 * dpr);
      visibleCtx.drawImage(scratchCanvas, 0, 0);
      visibleCtx.restore();

      // Crisp top layer
      visibleCtx.drawImage(scratchCanvas, 0, 0);

      watermarkRAF = requestAnimationFrame(renderFrame);
    };

    /* Pointermove / pointerleave scoped to .footer-watermark only */
    const onPointerMove = (e: PointerEvent) => {
      const rect = watermarkEl.getBoundingClientRect();
      pointerX = e.clientX - rect.left;
      pointerY = e.clientY - rect.top;
      isInside = true;

      if (fluidX < -500) {
        fluidX = pointerX;
        fluidY = pointerY;
        prevFluidX = pointerX;
        prevFluidY = pointerY;
      }

      if (!isAnimating) {
        isAnimating = true;
        watermarkRAF = requestAnimationFrame(renderFrame);
      }
    };

    const onPointerLeave = () => {
      isInside = false;
    };

    watermarkEl.addEventListener("pointermove", onPointerMove, { passive: true });
    watermarkEl.addEventListener("pointerleave", onPointerLeave, { passive: true });

    /* ResizeObserver to keep canvas resolution in sync with element size and DPR */
    const onResize = () => {
      clientW = watermarkEl.clientWidth;
      clientH = watermarkEl.clientHeight;
      if (clientW === 0 || clientH === 0) return;

      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.round(clientW * dpr);
      const h = Math.round(clientH * dpr);

      canvas.width = w;
      canvas.height = h;
      maskCanvas.width = w;
      maskCanvas.height = h;
      scratchCanvas.width = w;
      scratchCanvas.height = h;

      const style = window.getComputedStyle(watermarkEl);
      updateTextureCanvas(w, h, clientW, clientH, style);

      if (droplets.length > 0) {
        renderFrame();
      }
    };

    const resizeObserver = new ResizeObserver(onResize);
    resizeObserver.observe(watermarkEl);

    /* Store cleanup for lifecycle management */
    watermarkCleanup = () => {
      if (watermarkRAF) {
        cancelAnimationFrame(watermarkRAF);
        watermarkRAF = null;
      }
      resizeObserver.disconnect();
      watermarkEl.removeEventListener("pointermove", onPointerMove);
      watermarkEl.removeEventListener("pointerleave", onPointerLeave);
      droplets = [];
      isAnimating = false;
      visibleCtx.clearRect(0, 0, canvas.width, canvas.height);
    };
  };

  document.addEventListener("astro:page-load", initWatermarkReveal);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWatermarkReveal, { once: true });
  } else {
    initWatermarkReveal();
  }
</script>
