---
import projects from '../data/projects.json';
---

<section id="projects" class="projects-pin-wrap">
  <div class="projects-sticky-frame">
    <div class="projects-header-compact">
      <span class="projects-tag">Completed Work</span>
      <h2 class="projects-title">Recent Installations.</h2>
    </div>
    <div class="projects-track-window">
      <div class="projects-track" id="projectsTrack">
        {projects.map((project) => (
          <article class="project-slide">
            <div class="project-img-box" role="button" tabindex="0" aria-label={`View image for ${project.title}`} data-img={project.image} data-meta={`${project.client} — ${project.title}`}>
              <img src={project.image} alt={project.title} loading="lazy" />
              <span class="inspect-hint">View Image</span>
            </div>
            <div class="project-details">
              <div class="project-meta-row">
                <span class="project-index">{project.id}</span>
                <span class="meta-dot">·</span>
                <span class="project-cat">{project.category}</span>
                <span class="meta-dot">·</span>
                <span class="project-year">{project.year}</span>
              </div>
              <h3 class="project-client">{project.client}</h3>
              <p class="project-desc">{project.summary}</p>
              <div class="project-specs">
                {project.specs.map(spec => (
                  <span class="spec-chip">{spec}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- in-place image inspection popout -->
  <aside id="projectImagePopout" class="image-popout-overlay" aria-hidden="true">
    <div class="popout-container">
      <div class="popout-header">
        <span class="popout-meta" id="popoutMeta"></span>
        <button type="button" class="popout-close" id="popoutClose" aria-label="Close image">×</button>
      </div>
      <div class="popout-frame">
        <img src="" alt="" id="popoutTargetImg" />
      </div>
    </div>
  </aside>
</section>

<style>
  /* sticky pin */
  #projects,
  .projects-pin-wrap {
    position: relative;
    height: 300vh;
    background: #0b0c10;
    scroll-margin-top: 100px;
  }

  .projects-sticky-frame {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 5%;
    max-width: 1500px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .projects-header-compact {
    margin-bottom: 32px;
  }

  .projects-tag {
    color: #d62828;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 8px;
  }

  .projects-title {
    color: #ffffff;
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* horizontal track */
  .projects-track-window {
    width: 100%;
    overflow: hidden;
  }

  .projects-track {
    display: flex;
    gap: 32px;
    will-change: transform;
  }

  .project-slide {
    flex: 0 0 clamp(340px, 60vw, 760px);
    background: #111216;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .project-img-box {
    position: relative;
    min-height: 380px;
    cursor: pointer;
    overflow: hidden;
  }

  .project-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-img-box:hover img {
    transform: scale(1.03);
  }

  .inspect-hint {
    position: absolute;
    bottom: 14px;
    right: 14px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #ffffff;
    background: rgba(13, 14, 18, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 5px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .project-img-box:hover .inspect-hint {
    opacity: 1;
    transform: translateY(0);
  }

  /* slide details */
  .project-details {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .project-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 12px;
  }

  .project-index {
    font-weight: 600;
    color: #d62828;
  }

  .meta-dot {
    color: rgba(255, 255, 255, 0.3);
    font-weight: bold;
  }

  .project-cat,
  .project-year {
    color: rgba(255, 255, 255, 0.7);
  }

  .project-client {
    font-size: 1.35rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }

  .project-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 20px 0;
  }

  .project-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .spec-chip {
    font-size: 0.75rem;
    padding: 5px 11px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.75);
  }

  /* modal lightbox */
  .image-popout-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(9, 10, 13, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .image-popout-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .popout-container {
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .popout-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .popout-meta {
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .popout-close {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 1.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .popout-close:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .popout-frame {
    width: 100%;
    max-height: 78vh;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #000;
  }

  .popout-frame img {
    width: 100%;
    height: 100%;
    max-height: 78vh;
    object-fit: contain;
    display: block;
  }

  /* responsive */
  @media (max-width: 900px) {
    .projects-pin-wrap {
      height: auto;
    }

    .projects-sticky-frame {
      position: relative;
      height: auto;
      padding: 80px 5%;
    }

    .projects-track-window {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .projects-track-window::-webkit-scrollbar {
      display: none;
    }

    .projects-track {
      transform: none !important;
      padding-bottom: 8px;
    }

    .project-slide {
      flex: 0 0 88vw;
      grid-template-columns: 1fr;
      scroll-snap-align: center;
    }

    .project-img-box {
      min-height: 220px;
      height: 220px;
    }
  }

  /* Universal rolling button system */
  .btn-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 30px;
    border-radius: 9999px;
    overflow: hidden;
    position: relative;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    white-space: nowrap;
    user-select: none;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.15s ease;
  }

  .btn-pill:active {
    transform: scale(0.97);
  }

  .btn-solid-red,
  .btn-nav-cta {
    background-color: #d62828;
    color: #ffffff !important;
    border: 1px solid transparent;
  }
  .btn-solid-red:hover,
  .btn-nav-cta:hover {
    background-color: #b91d1d;
  }

  .btn-frosted {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff !important;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.3), 0 8px 24px rgba(0, 0, 0, 0.2);
  }
  .btn-frosted:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.45);
  }

  .btn-roller {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    height: 1.3em;
    line-height: 1.3em;
    overflow: hidden;
    pointer-events: none;
  }

  .btn-label {
    display: block;
    height: 1.3em;
    line-height: 1.3em;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #ffffff !important;
    will-change: transform;
    transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-label--base {
    transform: translateY(0);
  }

  .btn-label--clone {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    transform: translateY(100%);
  }

  .btn-pill:hover .btn-label--base,
  .btn-pill:focus-visible .btn-label--base {
    transform: translateY(-100%);
  }

  .btn-pill:hover .btn-label--clone,
  .btn-pill:focus-visible .btn-label--clone {
    transform: translateY(0);
  }
</style>

<script>
  /* scroll track and popout lifecycle */
  let projectsScrollHandler: (() => void) | null = null;
  let projectsResizeHandler: (() => void) | null = null;
  let projectsKeydownHandler: ((e: KeyboardEvent) => void) | null = null;

  const initProjectsShowcase = () => {
    const pinWrap = document.querySelector('.projects-pin-wrap') as HTMLElement | null;
    const track = document.getElementById('projectsTrack') as HTMLElement | null;
    const overlay = document.getElementById('projectImagePopout') as HTMLElement | null;
    const targetImg = document.getElementById('popoutTargetImg') as HTMLImageElement | null;
    const metaLabel = document.getElementById('popoutMeta');
    const closeBtn = document.getElementById('popoutClose');
    const triggers = document.querySelectorAll('.project-img-box');

    /* cleanup previous listeners */
    if (projectsScrollHandler) {
      window.removeEventListener('scroll', projectsScrollHandler);
      projectsScrollHandler = null;
    }
    if (projectsResizeHandler) {
      window.removeEventListener('resize', projectsResizeHandler);
      projectsResizeHandler = null;
    }
    if (projectsKeydownHandler) {
      window.removeEventListener('keydown', projectsKeydownHandler);
      projectsKeydownHandler = null;
    }

    /* horizontal track progression */
    if (pinWrap && track) {
      let ticking = false;
      let travelDistance = 0;
      let maxTranslate = 0;

      const computeBounds = () => {
        travelDistance = pinWrap.offsetHeight - window.innerHeight;
        maxTranslate = track.scrollWidth - (track.parentElement ? track.parentElement.clientWidth : 0);
      };

      const updatePosition = () => {
        if (window.innerWidth <= 900) {
          track.style.transform = '';
          ticking = false;
          return;
        }

        const rect = pinWrap.getBoundingClientRect();

        if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
          const progress = Math.min(Math.max(-rect.top / Math.max(travelDistance, 1), 0), 1);
          track.style.transform = `translate3d(-${(progress * maxTranslate).toFixed(2)}px, 0, 0)`;
        } else if (rect.top > 0) {
          track.style.transform = 'translate3d(0, 0, 0)';
        } else if (rect.bottom < window.innerHeight) {
          track.style.transform = `translate3d(-${maxTranslate.toFixed(2)}px, 0, 0)`;
        }
        ticking = false;
      };

      computeBounds();
      updatePosition();

      projectsResizeHandler = () => {
        computeBounds();
        if (!ticking) {
          window.requestAnimationFrame(updatePosition);
          ticking = true;
        }
      };

      projectsScrollHandler = () => {
        if (!ticking) {
          window.requestAnimationFrame(updatePosition);
          ticking = true;
        }
      };

      window.addEventListener('resize', projectsResizeHandler, { passive: true });
      window.addEventListener('scroll', projectsScrollHandler, { passive: true });
    }

    /* in-place image inspection */
    if (overlay && targetImg) {
      const openModal = (src: string, meta: string) => {
        targetImg.src = src;
        targetImg.alt = meta || 'Project Image';
        if (metaLabel) metaLabel.textContent = meta || '';
        overlay.classList.add('is-active');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
      };

      const closeModal = () => {
        overlay.classList.remove('is-active');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        setTimeout(() => {
          if (targetImg && !overlay.classList.contains('is-active')) {
            targetImg.src = '';
          }
        }, 250);
      };

      triggers.forEach((box) => {
        const el = box as HTMLElement;
        const imgSrc = el.getAttribute('data-img') || '';
        const meta = el.getAttribute('data-meta') || '';

        el.onclick = () => openModal(imgSrc, meta);
        el.onkeydown = (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openModal(imgSrc, meta);
          }
        };
      });

      if (closeBtn) closeBtn.onclick = closeModal;
      overlay.onclick = (e: MouseEvent) => {
        if (e.target === overlay) closeModal();
      };

      projectsKeydownHandler = (e: KeyboardEvent) => {
        if (e.key === 'Escape' && overlay.classList.contains('is-active')) {
          closeModal();
        }
      };
      window.addEventListener('keydown', projectsKeydownHandler);
    }
  };

  document.addEventListener('DOMContentLoaded', initProjectsShowcase);
  document.addEventListener('astro:page-load', initProjectsShowcase);

  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initProjectsShowcase();
  }
</script>
